local saved = {}

local function fmt(n)
    return string.format("%.3f", n)
end

local function cframeToLua(cf)
    local comps = {cf:GetComponents()}
    local out = {}
    for i, v in ipairs(comps) do
        out[i] = fmt(v)
    end
    return "CFrame.new(" .. table.concat(out, ", ") .. ")"
end

local function refreshList()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local names = {}
    for name in pairs(saved) do
        table.insert(names, name)
    end
    table.sort(names)

    for _, name in ipairs(names) do
        local row = Instance.new("TextLabel")
        row.Size = UDim2.new(1,-10,0,44)
        row.BackgroundColor3 = Color3.fromRGB(40,40,40)
        row.BorderSizePixel = 0
        row.TextColor3 = Color3.fromRGB(255,255,255)
        row.Font = Enum.Font.Code
        row.TextSize = 12
        row.TextWrapped = true
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.Text = name .. "\n" .. tostring(saved[name].Position)
        row.Parent = list

        local rc = Instance.new("UICorner")
        rc.CornerRadius = UDim.new(0,5)
        rc.Parent = row
    end

    task.wait()
    list.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 10)
end

local function buildTableText()
    local names = {}
    for name in pairs(saved) do
        table.insert(names, name)
    end
    table.sort(names)

    local lines = {"local Locais = {"}
    for _, name in ipairs(names) do
        table.insert(lines, '    ["' .. name:gsub('"','\\"') .. '"] = ' .. cframeToLua(saved[name]) .. ",")
    end
    table.insert(lines, "}")

    return table.concat(lines, "\n")
end

saveButton.MouseButton1Click:Connect(function()
    local name = nameBox.Text
    if not name or name == "" then
        info.Text = "Digite um nome antes de salvar."
        return
    end

    if not hrp then
        info.Text = "HumanoidRootPart não encontrado."
        return
    end

    saved[name] = hrp.CFrame
    info.Text = "Salvo: " .. name
    nameBox.Text = ""
    refreshList()
end)

copyButton.MouseButton1Click:Connect(function()
    local text = buildTableText()

    if setclipboard then
        local ok = pcall(function()
            setclipboard(text)
        end)
        if ok then
            info.Text = "Tabela copiada. Cole aqui no chat."
            return
        end
    elseif toclipboard then
        local ok = pcall(function()
            toclipboard(text)
        end)
        if ok then
            info.Text = "Tabela copiada. Cole aqui no chat."
            return
        end
    end

    print(text)
    info.Text = "Clipboard indisponível. Tabela enviada ao console."
end)

clearButton.MouseButton1Click:Connect(function()
