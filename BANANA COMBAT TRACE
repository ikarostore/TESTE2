local MAX_RECORDS = 40

local function describe(value, depth)
    depth = depth or 0
    local kind = typeof(value)
    if kind == "Instance" then
        return value:GetFullName() .. "<" .. value.ClassName .. ">"
    elseif kind == "CFrame" then
        return "CFrame(" .. tostring(value.Position) .. ")"
    elseif kind == "Vector3" then
        return "Vector3(" .. tostring(value) .. ")"
    elseif kind ~= "table" then
        local text = tostring(value)
        return #text > 100 and string.sub(text, 1, 100) .. "..." or text
    end
    if depth >= 2 then return "{...}" end
    local parts, count = {}, 0
    for key, item in pairs(value) do
        count = count + 1
        if count > 8 then
            table.insert(parts, "...")
            break
        end
        table.insert(parts, "[" .. describe(key, depth + 1) .. "]=" .. describe(item, depth + 1))
    end
    return "{" .. table.concat(parts, ", ") .. "}"
end

