local function refresh()
    output.Text = #records > 0 and table.concat(records, "\n\n")
        or "Aguardando RegisterAttack/RegisterHit..."
end

local function addRecord(remote, args)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local lines = {
        os.date("!%H:%M:%S") .. " | " .. remote:GetFullName(),
        "PlayerPos=" .. (root and tostring(root.Position) or "sem HRP"),
        "ArgCount=" .. tostring(args.n)
    }
    for index = 1, args.n do
        table.insert(lines, "arg" .. index .. "=" .. describe(args[index]))
    end
    table.insert(records, table.concat(lines, "\n"))
    while #records > MAX_RECORDS do table.remove(records, 1) end
    refresh()
end

copy.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(table.concat(records, "\n\n"))
        copy.Text = "Copiado!"
        task.delay(1, function() copy.Text = "Copiar rastreamento" end)
    end
end)

toggle.MouseButton1Click:Connect(function()
    enabled = not enabled
    toggle.Text = enabled and "Rastreamento: ON" or "Rastreamento: OFF"
end)

clear.MouseButton1Click:Connect(function()
    table.clear(records)
    refresh()
end)

if not hookmetamethod or not getnamecallmethod or not newcclosure then
    output.Text = "Executor sem hookmetamethod/getnamecallmethod/newcclosure."
    return
end

local originalNamecall
originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if enabled and method == "FireServer" and typeof(self) == "Instance" then
        local name = self.Name
        if name == "RE/RegisterAttack" or name == "RE/RegisterHit" then
            local args = table.pack(...)
            task.defer(addRecord, self, args)
        end
    end
    return originalNamecall(self, ...)
end))


