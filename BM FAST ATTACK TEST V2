local function CharacterParts()
    local character = LocalPlayer.Character
    return character,
        character and character:FindFirstChildOfClass("Humanoid"),
        character and character:FindFirstChild("HumanoidRootPart")
end

local function FindNearestEnemy(root)
    local enemies = workspace:FindFirstChild("Enemies")
    local best, bestRoot, bestDistance
    bestDistance = math.huge
    if not enemies then return nil end

    for _, model in ipairs(enemies:GetChildren()) do
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local enemyRoot = model:FindFirstChild("HumanoidRootPart")
        if humanoid and humanoid.Health > 0 and enemyRoot
        and not string.find(string.lower(model.Name), "boss", 1, true) then
            local distance = (enemyRoot.Position - root.Position).Magnitude
            if distance < bestDistance then
                best, bestRoot, bestDistance = model, enemyRoot, distance
            end
        end
    end
    return best, bestRoot, bestDistance
end

local function EquipMelee(character, humanoid)
    for _, container in ipairs({LocalPlayer.Backpack, character}) do
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and tostring(tool.ToolTip) == "Melee" then
                humanoid:EquipTool(tool)
                return tool
            end
        end
    end
end

local cachedController
local cachedMethod
local cachedControllerInfo = ""
local nextControllerScan = 0
local function ControllerInfo(controller)
    if type(controller) ~= "table" then return "controller invalido" end
    local keys = {}
    for key, value in pairs(controller) do
        if #keys >= 12 then break end
        table.insert(keys, tostring(key) .. ":" .. type(value))
    end
    return table.concat(keys, ", ")
end

local function CombatRemoteInfo()
    local found = {}
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = string.lower(obj.Name)
            if string.find(name, "attack", 1, true)
            or string.find(name, "hit", 1, true)
            or string.find(name, "rig", 1, true)
            or string.find(name, "combat", 1, true) then
                table.insert(found, obj:GetFullName())
                if #found >= 6 then break end
            end
        end
    end
    return #found > 0 and table.concat(found, " | ") or "nenhum remote encontrado"
end

local function ControllerState()
    if cachedController then
        return cachedController, cachedMethod == "direto", cachedMethod == "upvalue[2]", cachedMethod
    end
    if os.clock() < nextControllerScan then return nil, false, false, cachedMethod or "aguardando scan" end
    nextControllerScan = os.clock() + 3

    local module = LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework", true)
    if not module then
        for _, obj in ipairs(LocalPlayer.PlayerScripts:GetDescendants()) do
            if obj:IsA("ModuleScript")
            and string.find(string.lower(obj.Name), "combat", 1, true) then
                module = obj
                break
            end
        end
    end
    if not module then
        if getgc then
            local best, bestScore
            bestScore = -1
            for _, value in pairs(getgc(true)) do
                if type(value) == "table" and rawget(value, "activeController") then
                    local candidate = value.activeController
                    local score = 0
                    if type(candidate) == "table" then
                        if type(candidate.attack) == "function" then score = score + 4 end
                        if type(candidate.blades) == "table" then score = score + 3 end
                        if candidate.humanoid then score = score + 2 end
                        if candidate.equipped ~= nil then score = score + 1 end
                    end
                    if score > bestScore then best, bestScore = candidate, score end
                end
            end
            if best and bestScore >= 3 then
                cachedController = best
                cachedControllerInfo = ControllerInfo(best)
                cachedMethod = "getgc activeController score=" .. tostring(bestScore)
                return cachedController, false, false, cachedMethod
            end
            cachedControllerInfo = best and ControllerInfo(best) or "nenhum candidato"
            cachedMethod = "controller legado rejeitado score=" .. tostring(bestScore)
            return nil, false, false, cachedMethod
        end
        cachedMethod = "CombatFramework ausente; getgc sem controller"
        return nil, false, false, cachedMethod
    end
    local ok, framework = pcall(require, module)
    if not ok then return nil, false, false, "require falhou: " .. module:GetFullName() end

    local direct = type(framework) == "table" and framework.activeController ~= nil
    if direct then
        cachedController, cachedMethod = framework.activeController, "direto"
        return cachedController, true, false, cachedMethod .. " | " .. module:GetFullName()
    end

    local getUps = getupvalues or (debug and debug.getupvalues)
    if not getUps then return nil, false, false, "getupvalues ausente" end
    local okUps, ups = pcall(getUps, framework)
    local internal = okUps and type(ups) == "table" and ups[2]
    local upvalue = type(internal) == "table" and internal.activeController ~= nil
    if upvalue then
        cachedController, cachedMethod = internal.activeController, "upvalue[2]"
        return cachedController, false, true, cachedMethod .. " | " .. module:GetFullName()
    end
    cachedMethod = "controller nao encontrado | " .. module:GetFullName()
    return nil, false, false, cachedMethod
end

local modernRegisterAttack
local modernRegisterHit
local modernRemoteChecked = false
local function GetModernRemotes()
    if modernRemoteChecked then return modernRegisterAttack, modernRegisterHit end
    modernRemoteChecked = true
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    modernRegisterAttack = net and net:FindFirstChild("RE/RegisterAttack")
    modernRegisterHit = net and net:FindFirstChild("RE/RegisterHit")
    return modernRegisterAttack, modernRegisterHit
end

local function PerformAttack(targetModel, targetRoot, character, humanoid, root)
    local tool = EquipMelee(character, humanoid)
    local rawCount, filteredCount = 0, 0
    local sent = false

    if not tool then return false, false, false, "sem arma", 0, 0, "Melee ausente" end

    -- Pacote moderno que comprovadamente reduziu o HP no teste V2.
    -- O trace do Banana mostrou apenas RegisterHit porque o buffer foi tomado
    -- pelos hits; a preparacao RegisterAttack continua necessaria fora da VM.
    local registerAttack, registerHit = GetModernRemotes()
    if registerAttack and registerHit then
        local hitPart = targetModel:FindFirstChild("Head") or targetRoot
        local targets = {{targetModel, hitPart}}
        local attackOk = pcall(function() registerAttack:FireServer(0) end)
        local hitOk = pcall(function() registerHit:FireServer(hitPart, targets) end)
        return attackOk and hitOk, false, false, "Modules.Net moderno comprovado", 1, 1,
            tool.Name .. " | RegisterAttack + RegisterHit"
    end

    local controller, direct, upvalue, method = ControllerState()

    if controller then
        controller.attacking = false
        controller.blocking = false
        controller.timeToNextAttack = math.huge ^ math.huge ^ math.huge
        controller.timeToNextAttack = 0
        controller.timeToNextBlock = 0
        controller.increment = 1
        controller.hitboxMagnitude = 120
        controller.active = false
        controller.focusStart = 1655503339.0980349
        if controller.humanoid then controller.humanoid.AutoRotate = true end
    end

    local stun = character:FindFirstChild("Stun")
    if stun then pcall(function() stun.Value = 0 end) end
    local busy = character:FindFirstChild("Busy")
    if busy then pcall(function() busy.Value = false end) end
    humanoid.Sit = false

    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(1280, 672))
    if CameraShaker and type(CameraShaker.Stop) == "function" then CameraShaker:Stop() end

    -- RigLib e apenas um reforco/diagnostico. O BM original funciona pelo
    -- activeController + Button1Down e nao pode ser cancelado se o Rig sumir.
    local rigFramework = ReplicatedStorage:FindFirstChild("CombatFramework")
    local rigModule = rigFramework and rigFramework:FindFirstChild("RigLib")
    local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent")
    local okRig, rigLib = pcall(require, rigModule)
    if controller and okRig and rigEvent and type(rigLib) == "table" then
        local weapon = controller.blades and controller.blades[1]
        while weapon and weapon.Parent and weapon.Parent ~= character do weapon = weapon.Parent end
        local rawHits = rigLib.getBladeHits(character, {root}, 120) or {}
        local hits, seen = {}, {}
        for _, hit in pairs(rawHits) do
            rawCount = rawCount + 1
            local model = hit and hit:FindFirstAncestorOfClass("Model")
            local hitRoot = model and model:FindFirstChild("HumanoidRootPart")
            if model == targetModel and hitRoot and not seen[model] then
                seen[model] = true
                table.insert(hits, hitRoot)
            end
        end
        filteredCount = #hits
        if weapon and #hits > 0 then
            rigEvent:FireServer("weaponChange", tostring(weapon))
            rigEvent:FireServer("hit", hits, 1, "")
        end
    end
    sent = true
    local detail = controller and (tool.Name .. " | BM completo da referencia")
        or (tool.Name .. " | Button1Down sem controller")
    if not okRig or not rigEvent then detail = detail .. " | Rig opcional ausente" end
    return sent, direct, upvalue, method, rawCount, filteredCount, detail
end

