-- Sustentacao visual separada do ataque: roda em todos os frames para impedir
-- que a gravidade derrube o personagem entre um RegisterHit e outro.
RunService.Heartbeat:Connect(function()
    if not running or bringTest or not hoverTarget or not hoverY then return end
    local _, humanoid, root = CharacterParts()
    local targetRoot = hoverTarget.Parent and hoverTarget:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = hoverTarget.Parent and hoverTarget:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 or not root
    or not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
        hoverTarget = nil
        hoverY = nil
        return
    end

    local hoverPosition = Vector3.new(targetRoot.Position.X, hoverY, targetRoot.Position.Z)
    root.CFrame = CFrame.lookAt(hoverPosition, targetRoot.Position)
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end)

local cachedRemoteText = "varredura adiada"
local remoteInfoReady = false
local nextAttack = 0
local nextReport = 0
local previousReportHP = {}
local ATTACK_INTERVAL = 0.05
local REPORT_INTERVAL = 0.5

while RunService.Heartbeat:Wait() do
    local character, humanoid, root = CharacterParts()
    if running and character and humanoid and humanoid.Health > 0 and root then
        local now = os.clock()
        if now < nextAttack then continue end
        nextAttack = now + ATTACK_INTERVAL

        if not remoteInfoReady then
            remoteInfoReady = true
            task.spawn(function()
                cachedRemoteText = CombatRemoteInfo()
            end)
        end

        local target = hoverTarget
        local targetRoot = target and target.Parent and target:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = target and target.Parent and target:FindFirstChildOfClass("Humanoid")
        if not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
            target, targetRoot = FindNearestEnemy(root)
            targetHumanoid = target and target:FindFirstChildOfClass("Humanoid")
        end
        if target and targetRoot then
            local initialDistance = (targetRoot.Position - root.Position).Magnitude
            if hoverTarget ~= target then
                hoverTarget = target
                hoverY = targetRoot.Position.Y + 30
            end
            if bringTest then
                targetRoot.CFrame = root.CFrame * CFrame.new(0, -30, 0)
                targetRoot.CanCollide = false
            else
                local hoverPosition = Vector3.new(targetRoot.Position.X, hoverY, targetRoot.Position.Z)
                root.CFrame = CFrame.lookAt(hoverPosition, targetRoot.Position)
            end
            local sent, direct, upvalue, method, rawHits, filteredHits, detail =
                PerformAttack(target, targetRoot, character, humanoid, root)
            if now >= nextReport then
                nextReport = now + REPORT_INTERVAL
                local hpAfter = targetHumanoid and targetHumanoid.Health or -1
                local hpBefore = previousReportHP[target] or hpAfter
                previousReportHP[target] = hpAfter
                lastReport = table.concat({
                    "VERSAO: V2.4 STABLE DAMAGE",
                    "Alvo: " .. target.Name,
                    "Distancia atual: " .. tostring(math.floor(initialDistance * 10) / 10),
                    "HP leitura anterior/atual: " .. tostring(math.floor(hpBefore)) .. " / " .. tostring(math.floor(hpAfter)),
                    "Controller direto: " .. tostring(direct),
                    "Controller upvalue[2]: " .. tostring(upvalue),
                    "Metodo: " .. tostring(method),
                    "Rig hits bruto/filtrado: " .. tostring(rawHits) .. " / " .. tostring(filteredHits),
                    "Hit enviado: " .. tostring(sent),
                    "Detalhe/arma: " .. tostring(detail),
                    "Controller campos: " .. tostring(cachedControllerInfo),
                    "Remotes: " .. cachedRemoteText,
                    "Intervalo de ataque: " .. tostring(ATTACK_INTERVAL),
                    "Distancia de teste: 30 " .. (bringTest and "(mob abaixo)" or "(jogador acima)"),
                    "Bring Mob TESTE: " .. tostring(bringTest)
                }, "\n")
                output.Text = lastReport
            end
        else
            hoverTarget = nil
            hoverY = nil
            output.Text = "Nenhum NPC normal vivo em Workspace.Enemies.\nChegue perto de uma ilha com inimigos."
        end
    end
end

