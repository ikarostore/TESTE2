        if string.find(l, "danger level 6", 1, true)
        or string.find(l, "sea danger level 6", 1, true)
        or (
            string.find(l, "level 6", 1, true)
            and (
                string.find(l, "sea", 1, true)
                or string.find(l, "danger", 1, true)
            )
        ) then
            SeaHuntState.AtSea6 = true
            return true
        end
    end

    return SeaHuntState.AtSea6
end

local function StopBoatDrive(restoreCollision)
    SeaHuntState.Driving = false

    local stoppingPart = BoatDrivePart or GetBoatDrivePart()
    local stoppingSeat = GetBeastHunterMainSeat()

    if BoatNoclipConnection then
        BoatNoclipConnection:Disconnect()
        BoatNoclipConnection = nil
    end

    DestroyBoatFlightPhysics()

    if stoppingSeat then
        pcall(function()
            stoppingSeat.Throttle = 0
            stoppingSeat.ThrottleFloat = 0
            stoppingSeat.Steer = 0
            stoppingSeat.SteerFloat = 0
        end)
    end

    if stoppingPart then
        pcall(function()
            stoppingPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            stoppingPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
    end

    if SeaVIM then
        pcall(function()
            SeaVIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
        end)
    end

    -- Sempre restaura a geometria externa. As colisões originais do barco
    -- só voltam quando solicitado, pois ele pode retomar a caça logo depois.
    for obj, oldValue in pairs(BoatObstacleCollisionCache) do
        if obj and obj.Parent then
            pcall(function() obj.CanCollide = oldValue end)
        end
    end
    BoatObstacleCollisionCache = {}

    if restoreCollision then RestoreBoatCollision() end
end

local function TrySeatMainAccount()
