    return
end
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Character
local Humanoid
local HRP
local function SetupCharacter(char)
    Character = char
    Humanoid = char:WaitForChild("Humanoid", 15)
    HRP = char:WaitForChild("HumanoidRootPart", 15)
end
-- O HUD precisa existir ainda na tela Pick a Side. Se não houver Character,
-- continua carregando a interface e CharacterAdded configura tudo após a
-- escolha manual de Pirates/Marines.
if LocalPlayer.Character then
    task.spawn(function()
        SetupCharacter(LocalPlayer.Character)
    end)
end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.spawn(function()
        SetupCharacter(char)
    end)
end)
