local function SkillHoldRow(category, key)
    local row = Row(SkillsPage, 40)
    RowLabel(row, "Skill " .. key .. " " .. category)

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 120, 0, 30)
    box.Position = UDim2.new(1, -130, 0.5, -15)
    box.BackgroundColor3 = Color3.fromRGB(57,57,60)
    box.BorderSizePixel = 0
    box.TextColor3 = Color3.fromRGB(225,225,225)
    box.Font = Enum.Font.SourceSans
    box.TextSize = 13
    box.Text = tostring(CombatConfig[category].Hold[key])
    box.Parent = row

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,5)
    c.Parent = box

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            CombatConfig[category].Hold[key] = n
        else
            box.Text = tostring(CombatConfig[category].Hold[key])
        end
    end)
end

for _, key in ipairs({"Z","X","C"}) do
    SkillHoldRow("Melee", key)
end

for _, key in ipairs({"Z","X"}) do
    SkillHoldRow("Sword", key)
end

for _, key in ipairs({"Z","X"}) do
    SkillHoldRow("Gun", key)
end

for _, key in ipairs({"Z","X","C","V","F"}) do
    SkillHoldRow("Fruit", key)
end

