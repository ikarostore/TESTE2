local function StartSeaEventFocus(eventKey, eventModel, useBasicClick)
    if not HRP or not Humanoid then return nil end

    local oldPlatformStand = Humanoid.PlatformStand
    local oldAutoRotate = Humanoid.AutoRotate
    local collisionCache = {}
    local stableHoverY = nil

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "IKARO_SeaEventFocusVelocity"
    bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVelocity.P = 18000
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = HRP

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "IKARO_SeaEventFocusGyro"
    bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bodyGyro.P = 18000
    bodyGyro.D = 700
    bodyGyro.CFrame = HRP.CFrame
    bodyGyro.Parent = HRP

    -- PlatformStand bloqueia o controlador normal de M1 em vários executores.
    -- Skills continuam usando-o; mobs de clique permanecem em estado atacável.
    Humanoid.PlatformStand = not useBasicClick
    Humanoid.AutoRotate = false

    local nextNoclip = 0
    local connection = RunService.Heartbeat:Connect(function()
        if EscapeActive or not Running or SeaHuntState.CurrentEvent ~= eventModel then
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            return
        end

        local target = GetModelTargetPart(eventModel)
        if not target or not HRP or not HRP.Parent then return end

        local now = os.clock()
        if now >= nextNoclip and Character then
            nextNoclip = now + 0.10
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if collisionCache[part] == nil then
                        collisionCache[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end

        -- Sea Beast é muito alto e recebe dano por skills; manter grande
        -- altitude evita contato com a água sem sair do alcance das skills.
        local isShipEvent = eventKey == "PirateBrigade"
            or eventKey == "PirateGrandBrigade"
            or eventKey == "FishBoat"
        local height = eventKey == "SeaBeast" and 260
            or isShipEvent and 130
            or useBasicClick and 30
            or eventKey == "Terrorshark" and 36
            or 60
        -- Todos os Sea Events sao atacados diretamente por cima. Somente o
        -- personagem se move; nenhuma propriedade do mob/barco e alterada.
        if (useBasicClick or isShipEvent) and not stableHoverY then
            stableHoverY = target.Position.Y + height
        end
        -- Sharks mergulham depois que o hover é criado. A altura totalmente
        -- congelada deixava o personagem visualmente alinhado, porém a
        -- distância 3D ultrapassava o limite e o loop parava de atacar. Só
        -- corrigimos desvios grandes e de forma suave para não voltar a quicar.
        if useBasicClick and stableHoverY then
            local targetHoverY = target.Position.Y + height
            if math.abs(targetHoverY - stableHoverY) > 12 then
                stableHoverY = stableHoverY + (targetHoverY - stableHoverY) * 0.12
            end
        end
        local desired = (useBasicClick or isShipEvent)
            and Vector3.new(target.Position.X, stableHoverY, target.Position.Z)
            or target.Position + Vector3.new(0, height, 0)
        local delta = desired - HRP.Position
        local distance = delta.Magnitude

        if useBasicClick or isShipEvent then
            HRP.CFrame = CFrame.lookAt(desired, target.Position)
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        elseif distance > 7 then
            local speed = distance > 800 and 340
                or distance > 250 and 280
                or distance > 70 and 210
                or eventKey == "Piranha" and 90
                or 145
            bodyVelocity.Velocity = delta.Unit * speed
        else
            bodyVelocity.Velocity = target.AssemblyLinearVelocity + delta * 5
        end

        local lookPosition = Vector3.new(target.Position.X, HRP.Position.Y, target.Position.Z)
        if (lookPosition - HRP.Position).Magnitude > 0.01 then
            bodyGyro.CFrame = CFrame.lookAt(HRP.Position, lookPosition)
        end

    end)

    return function()
        if connection then connection:Disconnect() end
        pcall(function() bodyVelocity:Destroy() end)
        pcall(function() bodyGyro:Destroy() end)

        if useBasicClick and BMVirtualUser then
            pcall(function()
                BMVirtualUser:Button1Up(Vector2.new(1280, 672))
            end)
        end

        if Humanoid then
            Humanoid.PlatformStand = oldPlatformStand
            Humanoid.AutoRotate = oldAutoRotate
        end

        for part, oldValue in pairs(collisionCache) do
            if part and part.Parent then
                pcall(function() part.CanCollide = oldValue end)
            end
        end

        if HRP then
            pcall(function()
                HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end
end

local function CombatSelectedSeaEvent(eventKey, eventModel)
    if not eventModel then return end

    SeaHuntState.CurrentEvent = eventModel
    StopFollow()

    local target = GetModelTargetPart(eventModel)
    if not target then
        SeaHuntState.CurrentEvent = nil
        return
    end

    local useBasicClick = ClickSeaEvents[eventKey] == true

    local combatState = useBasicClick and "SEA_EVENT_BM_FAST_ATTACK" or "SEA_EVENT_SKILLS"

    SetState(combatState, SeaEventDisplayName(eventKey))

    -- Sea Event selecionado tem prioridade total sobre barco/follow.
    StopFollow()
    ForceExitBoatForCombat()
    EnsureSeaCombatHaki()

    local stopFocus = StartSeaEventFocus(eventKey, eventModel, useBasicClick)
    if not stopFocus then
        SeaHuntState.CurrentEvent = nil
        error("Não foi possível iniciar o foco físico no Sea Event")
    end

    local started = os.clock()
    local okCombat, combatError = pcall(function()
        while Running
        and SeaHuntState.CurrentEvent == eventModel
        and IsEventAlive(eventModel)
        and os.clock() - started < 180 do
            if EscapeActive then
                task.wait(0.25)
                continue
            end

            target = GetModelTargetPart(eventModel)
            if not target then break end

            local distance = HRP and (target.Position - HRP.Position).Magnitude or math.huge
            local isShipEvent = eventKey == "PirateBrigade"
                or eventKey == "PirateGrandBrigade"
                or eventKey == "FishBoat"
            local attackRange = eventKey == "SeaBeast" and 340
                or useBasicClick and 120
                or isShipEvent and 155
                or 140

            if distance <= attackRange then
                AimAtSeaTarget(target)

                if useBasicClick then
                    BMFastAttack(target, eventModel, eventKey)
                else
                    -- Pirate Brigade, Pirate Grand Brigade e Fish Boat usam
                    -- o perfil de skills configurado, com mira mantida no alvo.
                    UseConfiguredSeaSkills()
                end
            end

            task.wait(useBasicClick and 0.05 or 0.12)
        end
    end)

    stopFocus()

    if not okCombat then
        SeaHuntState.CurrentEvent = nil
        error(combatError)
    end

    if not IsEventAlive(eventModel) then
        SeaHuntState.EventKills = SeaHuntState.EventKills + 1
        SetState("SEA_EVENT_DEFEATED", SeaEventDisplayName(eventKey) .. " | Total: " .. tostring(SeaHuntState.EventKills))
    end

    SeaHuntState.CurrentEvent = nil
end

