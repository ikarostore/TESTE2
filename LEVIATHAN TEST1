local function PositionDropdown()
    local pos = DropButton.AbsolutePosition
    local size = DropButton.AbsoluteSize

    Dropdown.Position = UDim2.fromOffset(
        pos.X,
        pos.Y + size.Y + 4
    )
end

local function CloseDropdown()
    dropdownOpen = false
    Dropdown.Visible = false
    DropArrow.Text = "⌄"
end

local function RefreshDropdown()
    for _, child in ipairs(Dropdown:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local list = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end

    table.sort(list, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    for _, p in ipairs(list) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -6, 0, 34)
        b.BackgroundColor3 = Color3.fromRGB(42, 42, 45)
        b.BorderSizePixel = 0
        b.TextColor3 = Color3.fromRGB(230, 230, 230)
        b.Font = Enum.Font.SourceSans
        b.TextSize = 13
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.TextTruncate = Enum.TextTruncate.AtEnd
        b.Text = "  " .. p.Name
        b.ZIndex = 105
        b.Parent = Dropdown

        local hover = Instance.new("UICorner")
        hover.CornerRadius = UDim.new(0, 4)
        hover.Parent = b

        b.MouseEnter:Connect(function()
            b.BackgroundColor3 = Color3.fromRGB(53, 53, 57)
        end)

        b.MouseLeave:Connect(function()
            b.BackgroundColor3 = Color3.fromRGB(42, 42, 45)
        end)

        b.MouseButton1Click:Connect(function()
            OwnerPlayer = p
            DropButton.Text = "  " .. p.Name
            CloseDropdown()
            SetState("OWNER_SELECTED", p.Name)
        end)
    end

    local height = math.min(#list * 36 + 8, 180)
    Dropdown.Size = UDim2.new(0, 190, 0, height)
    Dropdown.CanvasSize = UDim2.new(0, 0, 0, #list * 36 + 8)
    PositionDropdown()
end

