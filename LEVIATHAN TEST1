local function NameMatchesAny(name, variants)
    local lower = string.lower(name)

    for _, variant in ipairs(variants) do
        if string.find(lower, string.lower(variant), 1, true) then
            return true
        end
    end

    return false
end

local function FindSelectedSeaEvent()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            for _, key in ipairs(SeaEventOrder) do
                if SeaEventsSelected[key] then
                    local variants = SeaEventNames[key]

                    if variants and NameMatchesAny(obj.Name, variants) then
                        return key, obj
                    end
                end
            end
        end
    end

    return nil, nil
end

