local function GetModelTargetPart(model)
    if not model then return nil end

    if model:IsA("BasePart") then
        return model
    end

    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function IsEventAlive(model)
    if not model or not model.Parent then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        return hum.Health > 0
    end

    return model.Parent ~= nil
end

local function CombatSelectedSeaEvent(eventKey, eventModel)
    if not eventModel then return end

    SeaHuntState.CurrentEvent = eventModel
    StopFollow()

    local target = GetModelTargetPart(eventModel)
    if not target then
        SeaHuntState.CurrentEvent = nil
        return
    end

    SetState("SEA_EVENT_COMBAT", SeaEventDisplayName(eventKey))

    -- sai do assento se necessário
    if Humanoid and Humanoid.Sit then
        Humanoid.Sit = false
        task.wait(0.2)
    end

    local combatMarker = Instance.new("Part")
    combatMarker.Name = "IKARO_SeaEventCombatTarget"
    combatMarker.Anchored = true
    combatMarker.CanCollide = false
    combatMarker.Transparency = 1
    combatMarker.Parent = workspace

    local started = os.clock()

    while Running and IsEventAlive(eventModel) and os.clock() - started < 90 do
        target = GetModelTargetPart(eventModel)
        if not target then break end

        -- posição segura acima do evento
        combatMarker.CFrame = target.CFrame * CFrame.new(0, 55, 0)

        FlyToPart(combatMarker, 18)
        EquipSeaCombatType(CombatConfig.Type)

        -- usa a rotação configurada
        local cfg = CombatConfig[CombatConfig.Type]
        local order = CombatConfig.Type == "Fruit"
            and {"Z","X","C","V","F"}
            or CombatConfig.Type == "Melee"
            and {"Z","X","C"}
            or {"Z","X"}

        if SeaVIM and cfg then
            for _, keyName in ipairs(order) do
                if cfg.Selected[keyName] then
                    local key = Enum.KeyCode[keyName]
                    if key then
                        pcall(function()
                            SeaVIM:SendKeyEvent(true, key, false, game)
                            task.wait(cfg.Hold[keyName] or 0.5)
                            SeaVIM:SendKeyEvent(false, key, false, game)
                        end)
                    end
                end
            end
        end

        task.wait(0.15)
    end

    pcall(function() combatMarker:Destroy() end)

    if not IsEventAlive(eventModel) then
        SeaHuntState.EventKills = SeaHuntState.EventKills + 1
        SetState("SEA_EVENT_DEFEATED", SeaEventDisplayName(eventKey) .. " | Total: " .. tostring(SeaHuntState.EventKills))
    end

    SeaHuntState.CurrentEvent = nil
end

