-- =========================================================
-- WATER WALK v3
-- Método simples e robusto baseado no source analisado:
-- uma plataforma invisível grande acompanha X/Z do jogador em Y=0.
-- =========================================================

local WATER_Y = 0
local WATER_PLATFORM_SIZE = 500

local function DestroyWaterPlatform()
    if WaterPlatform then
        pcall(function()
            WaterPlatform:Destroy()
        end)
        WaterPlatform = nil
    end
end

local function EnsureWaterPlatform()
    if not WaterWalkEnabled or not HRP or not HRP.Parent then
        DestroyWaterPlatform()
        return
    end

    if not WaterPlatform or not WaterPlatform.Parent then
        WaterPlatform = Instance.new("Part")
        WaterPlatform.Name = "IKARO_WaterWalk"
        WaterPlatform.Size = Vector3.new(
            WATER_PLATFORM_SIZE,
            1,
            WATER_PLATFORM_SIZE
        )
        WaterPlatform.Anchored = true
        WaterPlatform.Transparency = 1
        WaterPlatform.CanCollide = true
        WaterPlatform.CanTouch = false
        WaterPlatform.CanQuery = false
        WaterPlatform.Parent = workspace
    end

    WaterPlatform.CFrame = CFrame.new(
        HRP.Position.X,
        WATER_Y,
        HRP.Position.Z
    )
end

task.spawn(function()
    while Gui and Gui.Parent do
        if WaterWalkEnabled then
            pcall(EnsureWaterPlatform)
        else
            DestroyWaterPlatform()
        end
        task.wait(0.1)
    end
end)

