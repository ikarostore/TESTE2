                    or string.find(lower, "lantern", 1, true) then
                        if tool.Parent ~= Character then
                            pcall(function() Humanoid:EquipTool(tool) end)
                            task.wait(0.15)
                        end
                        return tool
                    end
                end
            end
        end
    end
    return nil
end

-- O kaitun protegido chama isto de AutoTorch. Como o código dele não está no
-- dump, usamos os objetos reais do LeviathanGate e limitamos a três pontos.
SeaHuntState.TryAutoDracoTorches = function()
    if not SeaConfig.AutoDracoTorch or SeaHuntState.TorchRunning then return end
    local map = workspace:FindFirstChild("Map")
    local gate = map and map:FindFirstChild("LeviathanGate", true)
    if not gate then
        SetState("DRACO_TORCH_WAIT", "LeviathanGate ainda não apareceu em Hydra.")
        return
    end

    SeaHuntState.TorchRunning = true
    task.spawn(function()
        StopBoatDrive(false)
        ForceExitBoatForCombat()
        SeaHuntState.EquipTorchTool()

        local interactions = {}
        local seen = {}
        for _, obj in ipairs(gate:GetDescendants()) do
            local lower = string.lower(obj.Name)
            local isInteraction = obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector")
            local namedTorch = string.find(lower, "torch", 1, true)
                or string.find(lower, "lantern", 1, true)
                or string.find(string.lower(obj.Parent and obj.Parent.Name or ""), "torch", 1, true)
                or string.find(string.lower(obj.Parent and obj.Parent.Name or ""), "lantern", 1, true)
            if isInteraction and namedTorch and not seen[obj] then
                seen[obj] = true
                table.insert(interactions, obj)
            end
        end

        -- Alguns servidores deixam os prompts com nomes genéricos.
        if #interactions < 3 then
            for _, obj in ipairs(gate:GetDescendants()) do
                if (obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector"))
                and not seen[obj] then
                    seen[obj] = true
                    table.insert(interactions, obj)
                end
            end
        end

        SeaHuntState.TorchesActivated = 0
        for index = 1, math.min(3, #interactions) do
            if not Running or not SeaConfig.AutoDracoTorch then break end
            local interaction = interactions[index]
            local part = interaction.Parent
            if part and not part:IsA("BasePart") then
                part = part:FindFirstChildWhichIsA("BasePart", true)
            end
            if part and part:IsA("BasePart") then
                SeaHuntState.EquipTorchTool()
                FlyToPart(part, 7, true)
                task.wait(0.2)
                local ok = false
                if interaction:IsA("ProximityPrompt") and type(fireproximityprompt) == "function" then
                    ok = pcall(function() fireproximityprompt(interaction) end)
                elseif interaction:IsA("ClickDetector") and type(fireclickdetector) == "function" then
                    ok = pcall(function() fireclickdetector(interaction) end)
                end
                if ok then
                    SeaHuntState.TorchesActivated = SeaHuntState.TorchesActivated + 1
                end
                task.wait(1)
            end
        end

        local opened = pcall(function()
            local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
            local comm = remotes and remotes:WaitForChild("CommF_", 5)
            if comm then comm:InvokeServer("OpenLeviathanGate") end
        end)
        SeaHuntState.TorchRunning = false
        SetState(
            opened and "DRACO_TORCH_COMPLETE" or "DRACO_TORCH_ERROR",
            "Tochas acionadas: " .. tostring(SeaHuntState.TorchesActivated) .. "/3"
        )
    end)
end

local function DestroyBoatFlightPhysics()
    if BoatLinearVelocity then
        pcall(function() BoatLinearVelocity:Destroy() end)
        BoatLinearVelocity = nil
    end

    if BoatAlignOrientation then
        pcall(function() BoatAlignOrientation:Destroy() end)
        BoatAlignOrientation = nil
    end

    if BoatAttachment then
        pcall(function() BoatAttachment:Destroy() end)
        BoatAttachment = nil
    end

    BoatDrivePart = nil
end

local function EnsureBoatFlightPhysics()
    local drivePart = GetBoatDrivePart()
    if not drivePart then
        DestroyBoatFlightPhysics()
        return nil
    end

    if BoatDrivePart ~= drivePart then
        DestroyBoatFlightPhysics()
        BoatDrivePart = drivePart
    end

    ApplyBoatNoclip()

    if not BoatAttachment or not BoatAttachment.Parent then
        BoatAttachment = Instance.new("Attachment")
        BoatAttachment.Name = "IKARO_BoatFlightAttachment"
        BoatAttachment.Parent = drivePart
    end

    if not BoatLinearVelocity or not BoatLinearVelocity.Parent then
        BoatLinearVelocity = Instance.new("LinearVelocity")
        BoatLinearVelocity.Name = "IKARO_BoatLinearVelocity"
        BoatLinearVelocity.Attachment0 = BoatAttachment
        BoatLinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        BoatLinearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        BoatLinearVelocity.MaxForce = math.huge
        BoatLinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
        BoatLinearVelocity.Parent = drivePart
    end

    if not BoatAlignOrientation or not BoatAlignOrientation.Parent then
        BoatAlignOrientation = Instance.new("AlignOrientation")
        BoatAlignOrientation.Name = "IKARO_BoatAlignOrientation"
        BoatAlignOrientation.Attachment0 = BoatAttachment
        BoatAlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        BoatAlignOrientation.RigidityEnabled = false
        BoatAlignOrientation.Responsiveness = 35
        BoatAlignOrientation.MaxTorque = math.huge
        BoatAlignOrientation.Parent = drivePart
    end

    return drivePart
end

