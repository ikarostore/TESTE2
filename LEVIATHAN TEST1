local function RefreshPlayerList()
    ClearPlayerButtons()

    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end

    table.sort(list, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    for _, p in ipairs(list) do
        local b = Button(HuntPage, "Select: " .. p.Name, function()
            OwnerPlayer = p
            OwnerLabel.Text = "  Owner Boat: " .. p.Name
            SetState("OWNER_SELECTED", p.Name)
        end)
        table.insert(PlayerDropdownButtons, b)
    end

    SetState("PLAYER_LIST_REFRESHED", tostring(#list) .. " outros jogadores")
end

