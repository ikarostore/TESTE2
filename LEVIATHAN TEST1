-- =========================================================
-- FOLLOW OWNER - SMOOTH v3
--
-- Correção da "lagadinha":
-- A versão anterior revarria todas as partes do personagem a cada Heartbeat.
-- Agora as partes são cacheadas e o controle de voo só atualiza a velocidade.
-- =========================================================

local FollowBodyVelocity = nil
local FollowBodyGyro = nil
local FollowParts = {}

local function CacheFollowParts()
    FollowParts = {}

    if not Character then
        return
    end

    for _, obj in ipairs(Character:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(FollowParts, obj)

            if savedCollisions[obj] == nil then
                savedCollisions[obj] = obj.CanCollide
            end
        end
    end
end

local function SetFollowNoclip()
    for _, part in ipairs(FollowParts) do
        if part and part.Parent then
            part.CanCollide = false
        end
    end
end

local function RestoreFollowPhysics()
    for part, oldValue in pairs(savedCollisions) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = oldValue
            end)
        end
    end

    savedCollisions = {}
    FollowParts = {}

    if FollowBodyVelocity then
        pcall(function()
            FollowBodyVelocity:Destroy()
        end)
        FollowBodyVelocity = nil
    end

    if FollowBodyGyro then
        pcall(function()
            FollowBodyGyro:Destroy()
        end)
        FollowBodyGyro = nil
    end

    if Humanoid then
        pcall(function()
            Humanoid.PlatformStand = false
            Humanoid.AutoRotate = true
        end)
    end

    if HRP then
        pcall(function()
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
    end
end

local function ApplyFollowPhysics()
    if not Character or not HRP then
        return
    end

    CacheFollowParts()
    SetFollowNoclip()

    if Humanoid then
        pcall(function()
            Humanoid.PlatformStand = true
            Humanoid.AutoRotate = false
        end)
    end

    FollowBodyVelocity = Instance.new("BodyVelocity")
    FollowBodyVelocity.Name = "IKAROFollowVelocity"
    FollowBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FollowBodyVelocity.P = 11000
    FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    FollowBodyVelocity.Parent = HRP

    FollowBodyGyro = Instance.new("BodyGyro")
    FollowBodyGyro.Name = "IKAROFollowGyro"
    FollowBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FollowBodyGyro.P = 13000
    FollowBodyGyro.D = 900
    FollowBodyGyro.CFrame = HRP.CFrame
    FollowBodyGyro.Parent = HRP
end

local function StopFollow()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end

    RestoreFollowPhysics()
end

local function StartFollowOwner()
    StopFollow()

    if not OwnerPlayer or OwnerPlayer == LocalPlayer then
        return
    end

    ApplyFollowPhysics()

    local nextNoclipRefresh = 0

    FollowConnection = RunService.Heartbeat:Connect(function()
        if not Running or EscapeActive then
            return
        end

        if not HRP or not HRP.Parent then
            return
        end

        local ownerChar = OwnerPlayer.Character
        local ownerHRP = ownerChar and ownerChar:FindFirstChild("HumanoidRootPart")

        if not ownerHRP then
            if FollowBodyVelocity then
                FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
            return
        end

        -- Reaplica noclip só 5x/s, não em todo frame.
        local now = os.clock()
        if now >= nextNoclipRefresh then
            SetFollowNoclip()
            nextNoclipRefresh = now + 0.20
        end

        local target =
            ownerHRP.Position
            - ownerHRP.CFrame.LookVector * FollowBack
            + Vector3.new(0, FollowHeight, 0)

        local delta = target - HRP.Position
        local distance = delta.Magnitude

        if distance > 9 then
            local direction = delta.Unit
            local dynamicSpeed = FollowSpeedNear

            if distance > 1000 then
                dynamicSpeed = FollowSpeedFar
            elseif distance > 300 then
                dynamicSpeed = FollowSpeedMid
            else
                dynamicSpeed = FollowSpeedNear
            end

            FollowBodyVelocity.Velocity =
                direction * dynamicSpeed

            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + direction
            )
        else
            -- Perto do owner, acompanha a velocidade dele e faz
            -- uma correção suave, evitando microtravadas.
            local correction = delta * 1.6

            FollowBodyVelocity.Velocity =
                ownerHRP.AssemblyLinearVelocity + correction

            local look = ownerHRP.CFrame.LookVector

            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + look
            )
        end
    end)
end

-- =========================================================
-- AUTO ESCAPE - 40% HP -> FOGE / 90% HP -> VOLTA
-- =========================================================

local function FindLeviathanThreat()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local lower = string.lower(obj.Name)

            if string.find(lower, "leviathan", 1, true) then
                local part =
                    obj:FindFirstChild("HumanoidRootPart")
                    or obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart", true)

                if part then
                    return obj, part
                end
            end
        end
    end

    return nil, nil
end

local function StopEscape()
    EscapeActive = false

    if EscapeConnection then
        EscapeConnection:Disconnect()
        EscapeConnection = nil
    end

    if EscapeBodyVelocity then
        pcall(function()
            EscapeBodyVelocity:Destroy()
        end)
        EscapeBodyVelocity = nil
    end

    if EscapeBodyGyro then
        pcall(function()
            EscapeBodyGyro:Destroy()
        end)
        EscapeBodyGyro = nil
    end

    -- Se a automação continua ligada e esta conta é seguidora,
    -- volta a seguir o owner automaticamente.
    if Running and not AccountBuyBoat and OwnerPlayer then
        task.defer(function()
            if not EscapeActive and Running then
                StartFollowOwner()
            end
        end)
    end
end

local function StartEscape()
    if EscapeActive then
        return
    end

    if not HRP or not Humanoid then
        return
    end

    EscapeActive = true

    -- A fuga sempre tem prioridade sobre follow/hunt.
    StopFollow()

    ApplyFollowPhysics()

    EscapeBodyVelocity = Instance.new("BodyVelocity")
    EscapeBodyVelocity.Name = "IKAROEscapeVelocity"
    EscapeBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    EscapeBodyVelocity.P = 12000
    EscapeBodyVelocity.Velocity = Vector3.new(0, EscapeSpeed, 0)
    EscapeBodyVelocity.Parent = HRP

    EscapeBodyGyro = Instance.new("BodyGyro")
    EscapeBodyGyro.Name = "IKAROEscapeGyro"
    EscapeBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    EscapeBodyGyro.P = 15000
    EscapeBodyGyro.D = 900
    EscapeBodyGyro.CFrame = HRP.CFrame
    EscapeBodyGyro.Parent = HRP

    SetState(
        "LOW_HP_ESCAPE",
        "Vida <= 40%. Fugindo até recuperar 90%."
    )

    EscapeConnection = RunService.Heartbeat:Connect(function()
        if not EscapeActive then
            return
        end

        if not HRP or not HRP.Parent or not Humanoid or Humanoid.Health <= 0 then
            StopEscape()
            return
        end

        ApplyFollowPhysics()

        local maxHealth = math.max(Humanoid.MaxHealth, 1)
        local hpPercent = Humanoid.Health / maxHealth

        -- Só encerra quando recuperar 90% ou mais.
        if hpPercent >= EscapeReturnHealthPercent then
            SetState(
                "ESCAPE_COMPLETE",
                "Vida recuperada para " ..
                math.floor(hpPercent * 100) ..
                "%. Voltando ao modo normal."
            )

            StopEscape()
            return
        end

        local _, threatPart = FindLeviathanThreat()

        local fleeDirection

        if threatPart then
            -- Foge diretamente para o lado oposto do Leviathan.
            local away = HRP.Position - threatPart.Position

            if away.Magnitude > 0.01 then
                away = away.Unit
            else
                away = Vector3.new(0, 0, -1)
            end

            -- Mistura afastamento horizontal com subida forte.
            fleeDirection = (
                away
                + Vector3.new(0, EscapeVerticalBias, 0)
            ).Unit
        else
            -- Se não conseguir localizar o Leviathan,
            -- sobe rapidamente para sair da região de perigo.
            fleeDirection = Vector3.new(0, 1, 0)
        end

        EscapeBodyVelocity.Velocity =
            fleeDirection * EscapeSpeed

        EscapeBodyGyro.CFrame = CFrame.new(
            HRP.Position,
            HRP.Position + fleeDirection
        )
    end)
end

local function CheckLowHealth()
    if not AutoEscapeEnabled then
        return
    end

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    local maxHealth = math.max(Humanoid.MaxHealth, 1)
    local hpPercent = Humanoid.Health / maxHealth

    if not EscapeActive and hpPercent <= EscapeStartHealthPercent then
        StartEscape()
    end
end

local HealthConnection = nil

local function BindHealthMonitor()
    if HealthConnection then
        HealthConnection:Disconnect()
        HealthConnection = nil
    end

    if Humanoid then
        HealthConnection = Humanoid.HealthChanged:Connect(function()
            CheckLowHealth()
        end)

        CheckLowHealth()
    end
end

BindHealthMonitor()

LocalPlayer.CharacterAdded:Connect(function()
    task.delay(1, function()
        BindHealthMonitor()
    end)
end)

