local CONFIG_FILE = "IKARO_Leviathan_Config_" .. tostring(LocalPlayer.UserId) .. ".json"
local ConfigPersistenceAvailable =
    type(writefile) == "function"
    and type(readfile) == "function"
    and type(isfile) == "function"

local function CopyKnownValues(target, source)
    if type(target) ~= "table" or type(source) ~= "table" then return end

    for key, value in pairs(source) do
        if target[key] ~= nil then
            if type(target[key]) == "table" and type(value) == "table" then
                CopyKnownValues(target[key], value)
            elseif type(value) ~= "table" then
                target[key] = value
            end
        end
    end
end

local function BuildSavedConfig()
    return {
        Version = 1,
        AccountBuyBoat = AccountBuyBoat,
        OwnerName = OwnerPlayer and OwnerPlayer.Name or SavedOwnerName,
        WaterWalkEnabled = WaterWalkEnabled,
        AutoEscapeEnabled = AutoEscapeEnabled,
        AutoPaySpy = SpyState.AutoPay,
        SeaEventsSelected = SeaEventsSelected,
        SeaConfig = SeaConfig,
        BoatHeightY = BoatFlightConfig.HeightY,
        CombatConfig = CombatConfig
    }
end

local function SaveConfig()
    if not ConfigPersistenceAvailable then return false end

    local ok = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(BuildSavedConfig()))
    end)

    return ok
end

local function LoadConfig()
    if not ConfigPersistenceAvailable or not isfile(CONFIG_FILE) then
        return false
    end

    local ok, saved = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)

    if not ok or type(saved) ~= "table" then
        return false
    end

    if type(saved.AccountBuyBoat) == "boolean" then
        AccountBuyBoat = saved.AccountBuyBoat
    end
    if type(saved.OwnerName) == "string" and saved.OwnerName ~= "" then
        SavedOwnerName = saved.OwnerName
    end
    if type(saved.WaterWalkEnabled) == "boolean" then
        WaterWalkEnabled = saved.WaterWalkEnabled
    end
    if type(saved.AutoEscapeEnabled) == "boolean" then
        AutoEscapeEnabled = saved.AutoEscapeEnabled
    end
    if type(saved.AutoPaySpy) == "boolean" then
        SpyState.AutoPay = saved.AutoPaySpy
    end
    if type(saved.BoatHeightY) == "number" then
        BoatFlightConfig.HeightY = math.clamp(saved.BoatHeightY, 20, 120)
    end

    CopyKnownValues(SeaEventsSelected, saved.SeaEventsSelected)
    CopyKnownValues(SeaConfig, saved.SeaConfig)
    CopyKnownValues(CombatConfig, saved.CombatConfig)

    EscapeStartHealthPercent = SeaConfig.PanicHealthPercent / 100
    EscapeReturnHealthPercent = SeaConfig.ReturnHealthPercent / 100

    if AccountBuyBoat then
        OwnerPlayer = LocalPlayer
        SavedOwnerName = LocalPlayer.Name
    elseif SavedOwnerName then
        OwnerPlayer = Players:FindFirstChild(SavedOwnerName)
    end

    return true
end

