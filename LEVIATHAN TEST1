-- =========================================================
-- FOLLOW OWNER - VOO REAL ATÉ O OWNER
--
-- IMPORTANTE:
-- Esta versão NÃO usa CFrame para "puxar" o seguidor até o owner.
-- Ela usa BodyVelocity para o personagem voar fisicamente em linha reta.
-- Isso reduz o efeito de rollback causado por teleporte/CFrame contínuo.
-- =========================================================

local FollowBodyVelocity = nil
local FollowBodyGyro = nil

local function RestoreFollowPhysics()
    if Character then
        for part, oldValue in pairs(savedCollisions) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = oldValue
                end)
            end
        end
    end

    savedCollisions = {}

    if FollowBodyVelocity then
        pcall(function()
            FollowBodyVelocity:Destroy()
        end)
        FollowBodyVelocity = nil
    end

    if FollowBodyGyro then
        pcall(function()
            FollowBodyGyro:Destroy()
        end)
        FollowBodyGyro = nil
    end

    if Humanoid then
        pcall(function()
            Humanoid.PlatformStand = false
            Humanoid.AutoRotate = true
        end)
    end

    if HRP then
        pcall(function()
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
    end
end

local function ApplyFollowPhysics()
    if not Character or not HRP then
        return
    end

    -- Noclip durante o voo.
    for _, obj in ipairs(Character:GetDescendants()) do
        if obj:IsA("BasePart") then
            if savedCollisions[obj] == nil then
                savedCollisions[obj] = obj.CanCollide
            end
            obj.CanCollide = false
        end
    end

    if Humanoid then
        pcall(function()
            Humanoid.PlatformStand = true
            Humanoid.AutoRotate = false
        end)
    end

    if not FollowBodyVelocity or not FollowBodyVelocity.Parent then
        FollowBodyVelocity = Instance.new("BodyVelocity")
        FollowBodyVelocity.Name = "IKAROFollowVelocity"
        FollowBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        FollowBodyVelocity.P = 9000
        FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        FollowBodyVelocity.Parent = HRP
    end

    if not FollowBodyGyro or not FollowBodyGyro.Parent then
        FollowBodyGyro = Instance.new("BodyGyro")
        FollowBodyGyro.Name = "IKAROFollowGyro"
        FollowBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        FollowBodyGyro.P = 12000
        FollowBodyGyro.D = 700
        FollowBodyGyro.CFrame = HRP.CFrame
        FollowBodyGyro.Parent = HRP
    end
end

local function StopFollow()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end

    RestoreFollowPhysics()
end

local function StartFollowOwner()
    StopFollow()

    if not OwnerPlayer or OwnerPlayer == LocalPlayer then
        return
    end

    ApplyFollowPhysics()

    local lastDistance = nil
    local rollbackCount = 0

    FollowConnection = RunService.Heartbeat:Connect(function()
        if not Running or EscapeActive then
            return
        end

        if not HRP or not HRP.Parent then
            return
        end

        local ownerChar = OwnerPlayer.Character
        local ownerHRP = ownerChar and ownerChar:FindFirstChild("HumanoidRootPart")

        if not ownerHRP then
            FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            return
        end

        ApplyFollowPhysics()

        -- Ponto-alvo: um pouco atrás e acima do jogador principal.
        local target =
            ownerHRP.Position
            - ownerHRP.CFrame.LookVector * FollowBack
            + Vector3.new(0, FollowHeight, 0)

        local delta = target - HRP.Position
        local distance = delta.Magnitude

        if distance > 10 then
            local direction = delta.Unit

            -- Voo real com velocidade constante.
            -- Sem teleporte, sem CFrame de posição.
            FollowBodyVelocity.Velocity = direction * FollowSpeed

            -- Faz o corpo olhar para a direção do voo.
            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + direction
            )
        else
            -- Quando chega perto, acompanha a velocidade do owner
            -- sem ficar tentando corrigir a posição agressivamente.
            local ownerVelocity = ownerHRP.AssemblyLinearVelocity
            local correction = delta * 2.2

            FollowBodyVelocity.Velocity =
                ownerVelocity + correction

            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + ownerHRP.CFrame.LookVector
            )
        end

        -- Detector simples de rollback.
        -- Se o servidor estiver devolvendo a conta repetidamente,
        -- apenas reduz a velocidade; nunca teleporta.
        if lastDistance then
            if distance > lastDistance + 25 then
                rollbackCount = rollbackCount + 1
            else
                rollbackCount = math.max(rollbackCount - 1, 0)
            end

            if rollbackCount >= 3 then
                FollowSpeed = math.max(FollowSpeed * 0.75, 70)
                rollbackCount = 0

                SetState(
                    "FOLLOW_OWNER",
                    "Servidor corrigiu posição; reduzindo velocidade para " ..
                    math.floor(FollowSpeed)
                )
            end
        end

        lastDistance = distance
    end)
end

-- =========================================================
-- AUTO ESCAPE - 40% HP -> FOGE / 90% HP -> VOLTA
-- =========================================================

local function FindLeviathanThreat()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local lower = string.lower(obj.Name)

            if string.find(lower, "leviathan", 1, true) then
                local part =
                    obj:FindFirstChild("HumanoidRootPart")
                    or obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart", true)

                if part then
                    return obj, part
                end
            end
        end
    end

    return nil, nil
end

local function StopEscape()
    EscapeActive = false

    if EscapeConnection then
        EscapeConnection:Disconnect()
        EscapeConnection = nil
    end

    if EscapeBodyVelocity then
        pcall(function()
            EscapeBodyVelocity:Destroy()
        end)
        EscapeBodyVelocity = nil
    end

    if EscapeBodyGyro then
        pcall(function()
            EscapeBodyGyro:Destroy()
        end)
        EscapeBodyGyro = nil
    end

    -- Se a automação continua ligada e esta conta é seguidora,
    -- volta a seguir o owner automaticamente.
    if Running and not AccountBuyBoat and OwnerPlayer then
        task.defer(function()
            if not EscapeActive and Running then
                StartFollowOwner()
            end
        end)
    end
end

local function StartEscape()
    if EscapeActive then
        return
    end

    if not HRP or not Humanoid then
        return
    end

    EscapeActive = true

    -- A fuga sempre tem prioridade sobre follow/hunt.
    StopFollow()

    ApplyFollowPhysics()

    EscapeBodyVelocity = Instance.new("BodyVelocity")
    EscapeBodyVelocity.Name = "IKAROEscapeVelocity"
    EscapeBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    EscapeBodyVelocity.P = 12000
    EscapeBodyVelocity.Velocity = Vector3.new(0, EscapeSpeed, 0)
    EscapeBodyVelocity.Parent = HRP

    EscapeBodyGyro = Instance.new("BodyGyro")
    EscapeBodyGyro.Name = "IKAROEscapeGyro"
    EscapeBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    EscapeBodyGyro.P = 15000
    EscapeBodyGyro.D = 900
    EscapeBodyGyro.CFrame = HRP.CFrame
    EscapeBodyGyro.Parent = HRP

    SetState(
        "LOW_HP_ESCAPE",
        "Vida <= 40%. Fugindo até recuperar 90%."
    )

    EscapeConnection = RunService.Heartbeat:Connect(function()
        if not EscapeActive then
            return
        end

        if not HRP or not HRP.Parent or not Humanoid or Humanoid.Health <= 0 then
            StopEscape()
            return
        end

        ApplyFollowPhysics()

        local maxHealth = math.max(Humanoid.MaxHealth, 1)
        local hpPercent = Humanoid.Health / maxHealth

        -- Só encerra quando recuperar 90% ou mais.
        if hpPercent >= EscapeReturnHealthPercent then
            SetState(
                "ESCAPE_COMPLETE",
                "Vida recuperada para " ..
                math.floor(hpPercent * 100) ..
                "%. Voltando ao modo normal."
            )

            StopEscape()
            return
        end

        local _, threatPart = FindLeviathanThreat()

        local fleeDirection

        if threatPart then
            -- Foge diretamente para o lado oposto do Leviathan.
            local away = HRP.Position - threatPart.Position

            if away.Magnitude > 0.01 then
                away = away.Unit
            else
                away = Vector3.new(0, 0, -1)
            end

            -- Mistura afastamento horizontal com subida forte.
            fleeDirection = (
                away
                + Vector3.new(0, EscapeVerticalBias, 0)
            ).Unit
        else
            -- Se não conseguir localizar o Leviathan,
            -- sobe rapidamente para sair da região de perigo.
            fleeDirection = Vector3.new(0, 1, 0)
        end

        EscapeBodyVelocity.Velocity =
            fleeDirection * EscapeSpeed

        EscapeBodyGyro.CFrame = CFrame.new(
            HRP.Position,
            HRP.Position + fleeDirection
        )
    end)
end

local function CheckLowHealth()
    if not AutoEscapeEnabled then
        return
    end

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    local maxHealth = math.max(Humanoid.MaxHealth, 1)
    local hpPercent = Humanoid.Health / maxHealth

    if not EscapeActive and hpPercent <= EscapeStartHealthPercent then
        StartEscape()
    end
end

local HealthConnection = nil

local function BindHealthMonitor()
    if HealthConnection then
        HealthConnection:Disconnect()
        HealthConnection = nil
    end

    if Humanoid then
        HealthConnection = Humanoid.HealthChanged:Connect(function()
            CheckLowHealth()
        end)

        CheckLowHealth()
    end
end

BindHealthMonitor()

LocalPlayer.CharacterAdded:Connect(function()
    task.delay(1, function()
        BindHealthMonitor()
    end)
end)

-- =========================================================
-- SEA EVENT DETECTOR
-- Procura apenas eventos marcados no multi-select.
-- =========================================================

local function NameMatchesAny(name, variants)
    local lower = string.lower(name)

    for _, variant in ipairs(variants) do
        if string.find(lower, string.lower(variant), 1, true) then
            return true
        end
    end

    return false
end

local function FindSelectedSeaEvent()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            for _, key in ipairs(SeaEventOrder) do
                if SeaEventsSelected[key] then
                    local variants = SeaEventNames[key]

                    if variants and NameMatchesAny(obj.Name, variants) then
                        return key, obj
                    end
                end
            end
        end
    end

    return nil, nil
end

-- =========================================================
-- LEVIATHAN DETECTOR
-- =========================================================

local function FindLeviathan()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local n = string.lower(obj.Name)
            if string.find(n, "leviathan", 1, true) then
                return obj
            end
        end
    end
    return nil
end

-- =========================================================
-- START HUNT
-- =========================================================

local HuntThread = nil

local function StopHunt()
    Running = false
    StopFollow()
    SetState("STOPPED", "Automação parada.")
end

local function StartHunt()
    if Running then
        return
    end

    if not AccountBuyBoat and not OwnerPlayer then
        SetState("ERROR", "Escolha o Owner Boat.")
        return
    end

    Running = true

    if AccountBuyBoat then
        SetState("MAIN_ACCOUNT", "Conta principal ativa. Compra automática do barco ainda não implementada.")
    else
        SetState("FOLLOW_OWNER", "Seguindo " .. OwnerPlayer.Name)
        StartFollowOwner()
    end

    HuntThread = task.spawn(function()
        while Running do
            local levi = FindLeviathan()

            if levi then
                CurrentSeaEventTarget = nil
                StopFollow()
                SetState("LEVIATHAN_FOUND", levi:GetFullName())
            else
                local eventKey, eventModel = FindSelectedSeaEvent()

                if eventModel then
                    CurrentSeaEventTarget = eventModel
                    SetState(
                        "SEA_EVENT_FOUND",
                        SeaEventDisplayName(eventKey) .. " • " .. eventModel:GetFullName()
                    )

                    -- Nesta build o evento é detectado e priorizado.
                    -- A rotina real de combate vai reutilizar a aba Skills
                    -- quando terminarmos de mapear o ataque.
                else
                    CurrentSeaEventTarget = nil

                    if not AccountBuyBoat and OwnerPlayer then
                        SetState("FOLLOW_OWNER", "Acompanhando " .. OwnerPlayer.Name)
                    elseif AccountBuyBoat then
                        SetState(
                            "SEARCHING_LEVIATHAN",
                            "Principal procurando Leviathan / Sea Events selecionados."
                        )
                    end
                end
            end

            task.wait(0.75)
        end
    end)
end

ToggleRow(HuntPage, "Start Hunt Leviathan", false, function(v)
    if v then
        StartHunt()
    else
        StopHunt()
    end
end)

SimpleButton(HuntPage, "Scan Leviathan Now", function()
