-- =========================================================
-- FOLLOW OWNER - VOO REAL ATÉ O OWNER
--
-- IMPORTANTE:
-- Esta versão NÃO usa CFrame para "puxar" o seguidor até o owner.
-- Ela usa BodyVelocity para o personagem voar fisicamente em linha reta.
-- Isso reduz o efeito de rollback causado por teleporte/CFrame contínuo.
-- =========================================================

local FollowBodyVelocity = nil
local FollowBodyGyro = nil

local function RestoreFollowPhysics()
    if Character then
        for part, oldValue in pairs(savedCollisions) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = oldValue
                end)
            end
        end
    end

    savedCollisions = {}

    if FollowBodyVelocity then
        pcall(function()
            FollowBodyVelocity:Destroy()
        end)
        FollowBodyVelocity = nil
    end

    if FollowBodyGyro then
        pcall(function()
            FollowBodyGyro:Destroy()
        end)
        FollowBodyGyro = nil
    end

    if Humanoid then
        pcall(function()
            Humanoid.PlatformStand = false
            Humanoid.AutoRotate = true
        end)
    end

    if HRP then
        pcall(function()
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
    end
end

local function ApplyFollowPhysics()
    if not Character or not HRP then
        return
    end

    -- Noclip durante o voo.
    for _, obj in ipairs(Character:GetDescendants()) do
        if obj:IsA("BasePart") then
            if savedCollisions[obj] == nil then
                savedCollisions[obj] = obj.CanCollide
            end
            obj.CanCollide = false
        end
    end

    if Humanoid then
        pcall(function()
            Humanoid.PlatformStand = true
            Humanoid.AutoRotate = false
        end)
    end

    if not FollowBodyVelocity or not FollowBodyVelocity.Parent then
        FollowBodyVelocity = Instance.new("BodyVelocity")
        FollowBodyVelocity.Name = "IKAROFollowVelocity"
        FollowBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        FollowBodyVelocity.P = 9000
        FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        FollowBodyVelocity.Parent = HRP
    end

    if not FollowBodyGyro or not FollowBodyGyro.Parent then
        FollowBodyGyro = Instance.new("BodyGyro")
        FollowBodyGyro.Name = "IKAROFollowGyro"
        FollowBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        FollowBodyGyro.P = 12000
        FollowBodyGyro.D = 700
        FollowBodyGyro.CFrame = HRP.CFrame
        FollowBodyGyro.Parent = HRP
    end
end

local function StopFollow()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end

    RestoreFollowPhysics()
end

local function StartFollowOwner()
    StopFollow()

    if not OwnerPlayer or OwnerPlayer == LocalPlayer then
        return
    end

    ApplyFollowPhysics()

    local lastDistance = nil
    local rollbackCount = 0

    FollowConnection = RunService.Heartbeat:Connect(function()
        if not Running then
            return
        end

        if not HRP or not HRP.Parent then
            return
        end

        local ownerChar = OwnerPlayer.Character
        local ownerHRP = ownerChar and ownerChar:FindFirstChild("HumanoidRootPart")

        if not ownerHRP then
            FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            return
        end

        ApplyFollowPhysics()

        -- Ponto-alvo: um pouco atrás e acima do jogador principal.
        local target =
            ownerHRP.Position
            - ownerHRP.CFrame.LookVector * FollowBack
            + Vector3.new(0, FollowHeight, 0)

        local delta = target - HRP.Position
        local distance = delta.Magnitude

        if distance > 10 then
            local direction = delta.Unit

            -- Voo real com velocidade constante.
            -- Sem teleporte, sem CFrame de posição.
            FollowBodyVelocity.Velocity = direction * FollowSpeed

            -- Faz o corpo olhar para a direção do voo.
            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + direction
            )
        else
            -- Quando chega perto, acompanha a velocidade do owner
            -- sem ficar tentando corrigir a posição agressivamente.
            local ownerVelocity = ownerHRP.AssemblyLinearVelocity
            local correction = delta * 2.2

            FollowBodyVelocity.Velocity =
                ownerVelocity + correction

            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + ownerHRP.CFrame.LookVector
            )
        end

        -- Detector simples de rollback.
        -- Se o servidor estiver devolvendo a conta repetidamente,
        -- apenas reduz a velocidade; nunca teleporta.
        if lastDistance then
            if distance > lastDistance + 25 then
                rollbackCount = rollbackCount + 1
            else
                rollbackCount = math.max(rollbackCount - 1, 0)
            end

            if rollbackCount >= 3 then
                FollowSpeed = math.max(FollowSpeed * 0.75, 70)
                rollbackCount = 0

                SetState(
                    "FOLLOW_OWNER",
                    "Servidor corrigiu posição; reduzindo velocidade para " ..
                    math.floor(FollowSpeed)
                )
            end
        end

        lastDistance = distance
    end)
end

