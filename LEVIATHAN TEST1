task.spawn(function()
    local teamVirtualUser = game:GetService("VirtualUser")

    while true do
        local spawnedCharacter = LocalPlayer.Character
        local spawnedHumanoid = spawnedCharacter
            and spawnedCharacter:FindFirstChildOfClass("Humanoid")
        local spawnedRoot = spawnedCharacter
            and spawnedCharacter:FindFirstChild("HumanoidRootPart")

        if spawnedHumanoid and spawnedHumanoid.Health > 0 and spawnedRoot then
            return
        end

        local mainGui = PlayerGui:FindFirstChild("Main")
        local chooseTeam = mainGui and mainGui:FindFirstChild("ChooseTeam")
        local container = chooseTeam and chooseTeam:FindFirstChild("Container")
        local marineOption = container and container:FindFirstChild("Marines")

        if marineOption and (not chooseTeam:IsA("GuiObject") or chooseTeam.Visible) then
            local marineButton = marineOption:FindFirstChild("TextButton", true)

            -- Metodo do script de referencia: torna o botao Marines clicavel
            -- em toda a tela e usa input real ate o personagem spawnar.
            if marineButton then
                pcall(function()
                    marineButton.Size = UDim2.new(0, 10000, 0, 10000)
                    marineButton.Position = UDim2.new(-4, 0, -5, 0)
                    marineButton.BackgroundTransparency = 1
