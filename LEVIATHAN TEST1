-- =========================================================
-- BEAST HUNTER AUTO DRIVE v4
--
-- Controle reforçado:
-- * LinearVelocity no AssemblyRootPart do barco
-- * AlignOrientation para apontar para a traseira da Tiki
-- * Throttle/W continuam ativos como fallback aceito pelo servidor
-- * noclip em todo o Beast Hunter
-- * Y alvo = 70
-- =========================================================

local BoatLinearVelocity = nil
local BoatAlignOrientation = nil
local BoatAttachment = nil
local BoatDrivePart = nil
local BoatCollisionCache = {}
local BoatObstacleCollisionCache = {}
local BoatNoclipConnection = nil
local FixedSeaDirection = nil

local function GetBoatDrivePart()
    local boat = GetBeastHunter()
    if not boat then return nil end

    local seat = boat:FindFirstChild("VehicleSeat")
    if seat then
        local root = nil
        pcall(function()
            root = seat.AssemblyRootPart
        end)
        return root or seat
    end

    return boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart", true)
end

local function ApplyBoatNoclip()
    local boat = GetBeastHunter()
    if not boat then return end

    for _, obj in ipairs(boat:GetDescendants()) do
        if obj:IsA("BasePart") then
            if BoatCollisionCache[obj] == nil then
                BoatCollisionCache[obj] = obj.CanCollide
            end
            obj.CanCollide = false
        end
    end
end

local function ApplyBoatObstacleNoclip(drivePart, direction)
    local boat = GetBeastHunter()
    if not boat or not drivePart then return end

    local flatDirection = Vector3.new(direction.X, 0, direction.Z)
    if flatDirection.Magnitude < 0.01 then
        flatDirection = Vector3.new(-1, 0, 0)
    else
        flatDirection = flatDirection.Unit
    end

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = Character and {boat, Character} or {boat}
    params.MaxParts = 0

    -- A caixa acompanha a frente do barco e remove localmente somente a
    -- colisão de geometria estática. Isso cobre muralhas/rochas grandes que
    -- continuam bloqueando a assembly mesmo com as peças do barco em noclip.
    local center = drivePart.Position + flatDirection * 55
    local scanCFrame = CFrame.lookAt(center, center + flatDirection)
    local seenNow = {}

    for _, part in ipairs(workspace:GetPartBoundsInBox(
        scanCFrame,
        Vector3.new(150, 150, 190),
        params
    )) do
        if part:IsA("BasePart")
        and part.Anchored
        and (part.CanCollide or BoatObstacleCollisionCache[part] ~= nil)
        and not part:IsDescendantOf(boat) then
            if BoatObstacleCollisionCache[part] == nil then
                BoatObstacleCollisionCache[part] = part.CanCollide
            end
            seenNow[part] = true
            part.CanCollide = false
        end
    end

    -- Restaura obstáculos que já ficaram para trás para não deixar o mapa
    -- inteiro sem colisão durante uma viagem longa.
    for part, oldValue in pairs(BoatObstacleCollisionCache) do
        if not part or not part.Parent then
            BoatObstacleCollisionCache[part] = nil
        elseif not seenNow[part] then
            pcall(function()
                part.CanCollide = oldValue
            end)
            BoatObstacleCollisionCache[part] = nil
        end
    end
end

local function RestoreBoatCollision()
    for obj, oldValue in pairs(BoatCollisionCache) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = oldValue
            end)
        end
    end
    BoatCollisionCache = {}

    for obj, oldValue in pairs(BoatObstacleCollisionCache) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = oldValue
            end)
        end
    end
    BoatObstacleCollisionCache = {}
end

