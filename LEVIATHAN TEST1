local function EquipByTooltip(category)
    if not Character or not Humanoid then
        return nil
    end

    local wanted = category
    if category == "Fruit" then
        wanted = "Blox Fruit"
    end

    local containers = {LocalPlayer.Backpack, Character}

    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tostring(tool.ToolTip) == wanted then
                    pcall(function()
                        Humanoid:EquipTool(tool)
                    end)
                    return tool
                end
            end
        end
    end

    return nil
end

local VIM = nil
pcall(function()
    VIM = game:GetService("VirtualInputManager")
end)

local function UseConfiguredSkill(keyName, holdTime)
    if not VIM then
        return false
    end

    local key = Enum.KeyCode[keyName]
    if not key then
        return false
    end

    local ok = pcall(function()
        VIM:SendKeyEvent(true, key, false, game)
        task.wait(holdTime or 0.1)
        VIM:SendKeyEvent(false, key, false, game)
    end)

    return ok
end

local function RunConfiguredCombatRotation()
    local category = CombatConfig.Type
    local cfg = CombatConfig[category]
    if not cfg then
        return
    end

    EquipByTooltip(category)

    local order =
        category == "Fruit" and {"Z","X","C","V","F"}
        or category == "Melee" and {"Z","X","C"}
        or {"Z","X"}

    for _, key in ipairs(order) do
        if cfg.Selected[key] then
            UseConfiguredSkill(key, cfg.Hold[key] or 0.5)
            task.wait(0.1)
        end
    end
end

