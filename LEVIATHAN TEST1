local function AddSkillToggle(category, key)
    Toggle(
        SkillsPage,
        category .. " " .. key,
        CombatConfig[category].Selected[key],
        function(v)
            CombatConfig[category].Selected[key] = v
        end
    )

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -6, 0, 30)
    box.BackgroundColor3 = Color3.fromRGB(38,38,38)
    box.BorderSizePixel = 0
    box.TextColor3 = Color3.fromRGB(255,255,255)
    box.Font = Enum.Font.SourceSans
    box.TextSize = 13
    box.Text = tostring(CombatConfig[category].Hold[key])
    box.PlaceholderText = "Hold seconds"
    box.Parent = SkillsPage

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,6)
    c.Parent = box

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)

        if n and n >= 0 and n <= 10 then
            CombatConfig[category].Hold[key] = n
        else
            box.Text = tostring(CombatConfig[category].Hold[key])
        end
    end)
end

