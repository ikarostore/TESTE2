-- =========================================================
-- WATER WALK
-- Cria uma plataforma local sobre a superfície da água.
-- Serve para evitar o personagem afundar enquanto estiver sobre o mar.
-- =========================================================

local function DestroyWaterPlatform()
    if WaterPlatform then
        pcall(function()
            WaterPlatform:Destroy()
        end)
        WaterPlatform = nil
    end
end

local function EnsureWaterPlatform()
    if not WaterWalkEnabled or not HRP or not Character then
        DestroyWaterPlatform()
        return
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Character}
    params.IgnoreWater = false

    local result = workspace:Raycast(
        HRP.Position + Vector3.new(0, 3, 0),
        Vector3.new(0, -80, 0),
        params
    )

    if result and result.Material == Enum.Material.Water then
        if not WaterPlatform or not WaterPlatform.Parent then
            WaterPlatform = Instance.new("Part")
            WaterPlatform.Name = "IKAROWaterWalk"
            WaterPlatform.Size = Vector3.new(10, 1, 10)
            WaterPlatform.Anchored = true
            WaterPlatform.CanCollide = true
            WaterPlatform.Transparency = 1
            WaterPlatform.Parent = workspace
        end

        WaterPlatform.CFrame = CFrame.new(
            HRP.Position.X,
            result.Position.Y + 1.8,
            HRP.Position.Z
        )
    else
        DestroyWaterPlatform()
    end
end

WaterWalkConnection = RunService.Heartbeat:Connect(function()
    if WaterWalkEnabled then
        pcall(EnsureWaterPlatform)
    else
        DestroyWaterPlatform()
    end
end)

