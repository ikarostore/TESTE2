local function NameMatchesAny(name, variants, key)
    local lowerName = string.lower(name)

    if key == "Shark" and string.find(lowerName, "terrorshark", 1, true) then
        return false
    end

    for _, variant in ipairs(variants) do
        local lowerVariant = string.lower(variant)

        if lowerName == lowerVariant then
            return true
        end

        if string.find(lowerName, lowerVariant, 1, true) then
            return true
        end
    end

    return false
end

local function IsExcludedSeaEventModel(obj)
    if not obj or not obj.Parent then
        return true
    end

    local full = string.lower(obj:GetFullName())
    local name = string.lower(obj.Name)

    -- Nunca tratar NPCs utilitários / mapa / nosso próprio barco como inimigos.
    if string.find(name, "hunter", 1, true)
    or string.find(name, "dealer", 1, true)
    or string.find(name, "spy", 1, true)
    or string.find(full, "workspace.map", 1, true)
    or string.find(full, "workspace.npcs", 1, true)
    or string.find(full, "workspace.boats.beast hunter", 1, true)
    or string.find(full, "players.", 1, true) then
        return true
    end

    return false
end

local function IsLikelyCombatModel(obj)
    if not obj or not obj:IsA("Model") or IsExcludedSeaEventModel(obj) then
        return false
    end

    -- Sea Events normalmente possuem Humanoid, Health/HP ou ficam
    -- em containers específicos de entidades.
    if obj:FindFirstChildOfClass("Humanoid") then
        return true
    end

    if obj:FindFirstChild("Health")
    or obj:FindFirstChild("HP")
    or obj:FindFirstChild("HumanoidRootPart") then
        return true
    end

    local full = string.lower(obj:GetFullName())

    if string.find(full, "workspace.enemies", 1, true)
    or string.find(full, "workspace.seabeasts", 1, true)
    or string.find(full, "workspace.sea", 1, true) then
        return true
    end

    return false
end

local function FindSelectedSeaEvent()
    -- Sea Beast tem container próprio conhecido.
    local seaBeasts = workspace:FindFirstChild("SeaBeasts")

    if seaBeasts and SeaEventsSelected.SeaBeast then
        for _, obj in ipairs(seaBeasts:GetChildren()) do
            if obj:IsA("Model")
            and not IsExcludedSeaEventModel(obj)
            and NameMatchesAny(obj.Name, SeaEventNames.SeaBeast, "SeaBeast") then
                return "SeaBeast", obj
            end
        end
    end

    -- Primeiro procura Workspace.Enemies, reduzindo falsos positivos.
    local enemies = workspace:FindFirstChild("Enemies")

    if enemies then
        for _, obj in ipairs(enemies:GetChildren()) do
            if obj:IsA("Model") and IsLikelyCombatModel(obj) then
                for _, key in ipairs(SeaEventOrder) do
                    if key ~= "SeaBeast" and SeaEventsSelected[key] then
                        local variants = SeaEventNames[key]

                        if variants and NameMatchesAny(obj.Name, variants, key) then
                            return key, obj
                        end
                    end
                end
            end
        end
    end

    -- O fallback global é caro em servidores com streaming. Containers
    -- conhecidos continuam sendo verificados sempre; a árvore inteira só é
    -- consultada em intervalo controlado.
    if os.clock() < SeaHuntState.NextGlobalEventScan then
        return nil, nil
    end
    SeaHuntState.NextGlobalEventScan = os.clock() + 3

    -- Fallback global, mas só para modelos com sinais de combate.
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsLikelyCombatModel(obj) then
            for _, key in ipairs(SeaEventOrder) do
                if key ~= "SeaBeast" and SeaEventsSelected[key] then
                    local variants = SeaEventNames[key]

                    if variants and NameMatchesAny(obj.Name, variants, key) then
                        return key, obj
                    end
                end
            end
        end
    end

    return nil, nil
end

