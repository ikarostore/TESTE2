local function StartEscape()
    if EscapeActive then
        return
    end

    if not HRP or not Humanoid then
        return
    end

    EscapeActive = true

    -- Teleport Y: salva o ponto do combate e sai instantaneamente da zona de
    -- dano. Isso substitui a subida contínua que podia deixar a conta presa.
    SeaHuntState.EscapeReturnCFrame = HRP.CFrame
    SeaHuntState.EscapeSafePosition = Vector3.new(
        HRP.Position.X,
        HRP.Position.Y + 350,
        HRP.Position.Z
    )
    pcall(function()
        HRP.CFrame = CFrame.new(SeaHuntState.EscapeSafePosition)
            * (SeaHuntState.EscapeReturnCFrame - SeaHuntState.EscapeReturnCFrame.Position)
        HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)

    -- A fuga sempre tem prioridade sobre follow/hunt.
    StopFollow()

    CacheFollowParts()
    SetFollowNoclip()
    Humanoid.PlatformStand = true
    Humanoid.AutoRotate = false

    EscapeBodyVelocity = Instance.new("BodyVelocity")
    EscapeBodyVelocity.Name = "IKAROEscapeVelocity"
    EscapeBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    EscapeBodyVelocity.P = 12000
    EscapeBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    EscapeBodyVelocity.Parent = HRP

    EscapeBodyGyro = Instance.new("BodyGyro")
    EscapeBodyGyro.Name = "IKAROEscapeGyro"
    EscapeBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    EscapeBodyGyro.P = 15000
    EscapeBodyGyro.D = 900
    EscapeBodyGyro.CFrame = HRP.CFrame
    EscapeBodyGyro.Parent = HRP

    SetState(
        "LOW_HP_ESCAPE",
        "Vida <= 40%. Fugindo até recuperar 90%."
    )

    EscapeConnection = RunService.Heartbeat:Connect(function()
        if not EscapeActive then
            return
        end

        if not HRP or not HRP.Parent or not Humanoid or Humanoid.Health <= 0 then
            StopEscape()
            SeaHuntState.EscapeReturnCFrame = nil
            SeaHuntState.EscapeSafePosition = nil
            return
        end

        SetFollowNoclip()

        local maxHealth = math.max(Humanoid.MaxHealth, 1)
        local hpPercent = Humanoid.Health / maxHealth

        -- Só encerra quando recuperar 90% ou mais.
        if hpPercent >= EscapeReturnHealthPercent then
            SetState(
                "ESCAPE_COMPLETE",
                "Vida recuperada para " ..
                math.floor(hpPercent * 100) ..
                "%. Voltando ao modo normal."
            )

            local returnCFrame = SeaHuntState.EscapeReturnCFrame
            StopEscape()
            if returnCFrame and HRP and HRP.Parent then
                pcall(function()
                    HRP.CFrame = returnCFrame
                    HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end)
            end
            SeaHuntState.EscapeReturnCFrame = nil
            SeaHuntState.EscapeSafePosition = nil
            SeaHuntState.ResumeAfterEscape = true
            return
        end

        local safePosition = SeaHuntState.EscapeSafePosition
        if safePosition then
            HRP.CFrame = CFrame.new(safePosition)
                * (HRP.CFrame - HRP.Position)
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            EscapeBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            EscapeBodyGyro.CFrame = HRP.CFrame
        end
    end)
end

local function CheckLowHealth()
    if not AutoEscapeEnabled then
        return
    end

    if not Humanoid or Humanoid.Health <= 0 then
