local function EquipSeaCombatType(category)
    if not Humanoid then return nil end

    local wanted = category == "Fruit" and "Blox Fruit" or category

    for _, container in ipairs({LocalPlayer.Backpack, Character}) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tostring(tool.ToolTip) == wanted then
                    pcall(function() Humanoid:EquipTool(tool) end)
                    return tool
                end
            end
        end
    end

    return nil
end

