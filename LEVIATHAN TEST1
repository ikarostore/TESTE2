-- =========================================================
-- FOLLOW BEAST HUNTER
--
-- Contas seguidoras NÃO seguem mais o personagem principal.
-- Elas aguardam o Beast Hunter do Owner aparecer e então seguem o barco.
--
-- Identificação:
-- 1) preferência para Beast Hunter cujo VehicleSeat esteja ocupado pelo Owner;
-- 2) fallback: Beast Hunter mais próximo do Owner.
-- =========================================================

local FollowBodyVelocity = nil
local FollowBodyGyro = nil
local FollowParts = {}

local function CacheFollowParts()
    FollowParts = {}

    if not Character then
        return
    end

    for _, obj in ipairs(Character:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(FollowParts, obj)

            if savedCollisions[obj] == nil then
                savedCollisions[obj] = obj.CanCollide
            end
        end
    end
end

local function SetFollowNoclip()
    for _, part in ipairs(FollowParts) do
        if part and part.Parent then
            part.CanCollide = false
        end
    end
end

local function RestoreFollowPhysics()
    for part, oldValue in pairs(savedCollisions) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = oldValue
            end)
        end
    end

    savedCollisions = {}
    FollowParts = {}

    if FollowBodyVelocity then
        pcall(function()
            FollowBodyVelocity:Destroy()
        end)
        FollowBodyVelocity = nil
    end

    if FollowBodyGyro then
        pcall(function()
            FollowBodyGyro:Destroy()
        end)
        FollowBodyGyro = nil
    end

    if Humanoid then
        pcall(function()
            Humanoid.PlatformStand = false
            Humanoid.AutoRotate = true
        end)
    end

    if HRP then
        pcall(function()
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
    end
end

local function ApplyFollowPhysics()
    if not Character or not HRP then
        return
    end

    CacheFollowParts()
    SetFollowNoclip()

    if Humanoid then
        Humanoid.PlatformStand = true
        Humanoid.AutoRotate = false
    end

    FollowBodyVelocity = Instance.new("BodyVelocity")
    FollowBodyVelocity.Name = "IKAROFollowBoatVelocity"
    FollowBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FollowBodyVelocity.P = 11000
    FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    FollowBodyVelocity.Parent = HRP

    FollowBodyGyro = Instance.new("BodyGyro")
    FollowBodyGyro.Name = "IKAROFollowBoatGyro"
    FollowBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FollowBodyGyro.P = 13000
    FollowBodyGyro.D = 900
    FollowBodyGyro.CFrame = HRP.CFrame
    FollowBodyGyro.Parent = HRP
end

local function StopFollow()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end

    RestoreFollowPhysics()

    if Running and AccountBuyBoat and not SeaHuntState.CombatBatchActive then
        SeaHuntState.ResumeAfterEscape = true
    end
end

local function GetBoatReferencePart(boat)
    if not boat then
        return nil
    end

    return boat:FindFirstChild("VehicleSeat")
        or boat.PrimaryPart
        or boat:FindFirstChildWhichIsA("BasePart", true)
end

local function GetOwnerBeastHunter()
    if not OwnerPlayer then
        return nil
    end

    local boats = workspace:FindFirstChild("Boats")
    if not boats then
        return nil
    end

    local ownerCharacter = OwnerPlayer.Character
    local ownerHRP = ownerCharacter and ownerCharacter:FindFirstChild("HumanoidRootPart")

    local nearestBoat = nil
    local nearestDistance = math.huge

    for _, boat in ipairs(boats:GetChildren()) do
        if boat.Name == "Beast Hunter" then
            local seat = boat:FindFirstChild("VehicleSeat")

            -- Melhor caso: Owner está realmente dirigindo este Beast Hunter.
            if seat and seat.Occupant and ownerCharacter and seat.Occupant.Parent == ownerCharacter then
                return boat
            end

            -- Fallback: Beast Hunter mais próximo do Owner.
            local ref = GetBoatReferencePart(boat)

            if ref and ownerHRP then
                local dist = (ref.Position - ownerHRP.Position).Magnitude

                if dist < nearestDistance then
                    nearestDistance = dist
                    nearestBoat = boat
                end
            end
        end
    end

    return nearestBoat
end

local function StartFollowBeastHunter()
    StopFollow()

    if not OwnerPlayer or OwnerPlayer == LocalPlayer then
        return
    end

    ApplyFollowPhysics()

    local nextNoclipRefresh = 0
    local lastWaitingMessage = 0

    FollowConnection = RunService.Heartbeat:Connect(function()
        if not Running or EscapeActive then
            return
        end

        if not HRP or not HRP.Parent then
            return
        end

        local boat = GetOwnerBeastHunter()

        -- IMPORTANTE:
        -- enquanto o Owner ainda não comprou/spawnou o Beast Hunter,
        -- a conta seguidora fica parada.
        if not boat then
            if FollowBodyVelocity then
                FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end

            if os.clock() - lastWaitingMessage > 2 then
                lastWaitingMessage = os.clock()
                SetState(
                    "WAITING_BEAST_HUNTER",
                    "Aguardando o Beast Hunter de " .. OwnerPlayer.Name
                )
            end

            return
        end

        local boatPart = GetBoatReferencePart(boat)

        if not boatPart then
            if FollowBodyVelocity then
                FollowBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
            return
        end

        local now = os.clock()

        if now >= nextNoclipRefresh then
            SetFollowNoclip()
            nextNoclipRefresh = now + 0.20
        end

        -- Fica atrás e acima do Beast Hunter.
        -- Referência é o próprio barco, não o jogador principal.
        local target =
            boatPart.Position
            - boatPart.CFrame.LookVector * 18
            + Vector3.new(0, FollowHeight, 0)

        local delta = target - HRP.Position
        local distance = delta.Magnitude

        if distance > 9 then
            local direction = delta.Unit
            local dynamicSpeed = FollowSpeedNear

            if distance > 1000 then
                dynamicSpeed = FollowSpeedFar
            elseif distance > 300 then
                dynamicSpeed = FollowSpeedMid
            end

            FollowBodyVelocity.Velocity = direction * dynamicSpeed

            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + direction
            )
        else
            -- Ao chegar perto, acompanha a velocidade do próprio barco.
            local boatVelocity = boatPart.AssemblyLinearVelocity
            local correction = delta * 1.6

            FollowBodyVelocity.Velocity =
                boatVelocity + correction

            FollowBodyGyro.CFrame = CFrame.new(
                HRP.Position,
                HRP.Position + boatPart.CFrame.LookVector
            )
        end

        if State ~= "FOLLOW_BEAST_HUNTER" then
            SetState(
                "FOLLOW_BEAST_HUNTER",
                "Seguindo o Beast Hunter de " .. OwnerPlayer.Name
            )
        end
    end)
end

-- Compatibilidade com chamadas antigas do script.
local function StartFollowOwner()
    StartFollowBeastHunter()
end

