local function GetWorldPosition(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Attachment") then return obj.WorldPosition end
    if obj:IsA("Model") then
        local center = obj:FindFirstChild("Center", true)
        if center and center:IsA("BasePart") then return center.Position end
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok then return pivot.Position end
    end
    return nil
end

-- NoxHub usa Map.FrozenDimension para navegar e _WorldOrigin.Locations para
-- confirmar o spawn. Mantemos ambos, sem varrer Workspace a cada frame.
local function FindFrozenDimension()
    if SeaHuntState.FrozenObject and SeaHuntState.FrozenObject.Parent then
        local position = GetWorldPosition(SeaHuntState.FrozenObject)
        if position then
            SeaHuntState.FrozenPosition = position
            return SeaHuntState.FrozenObject, position
        end
    end
    if os.clock() < (SeaHuntState.NextFrozenScan or 0) then
        return nil, SeaHuntState.FrozenPosition
    end
    SeaHuntState.NextFrozenScan = os.clock() + 1

    local map = workspace:FindFirstChild("Map")
    local frozen = map and (
        map:FindFirstChild("FrozenDimension")
        or map:FindFirstChild("Frozen Dimension")
    )
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local locations = origin and origin:FindFirstChild("Locations")
    local marker = locations and locations:FindFirstChild("Frozen Dimension")
    local chosen = frozen or marker
    local position = GetWorldPosition(chosen)

    if chosen and position then
        SeaHuntState.FrozenObject = chosen
        SeaHuntState.FrozenPosition = position
        return chosen, position
    end
    SeaHuntState.FrozenObject = nil
    SeaHuntState.FrozenPosition = nil
    SeaHuntState.FrozenReached = false
    return nil, nil
end

local function TryActivateFrozenDimension(frozen)
    if SeaHuntState.FrozenActivating or not frozen or not frozen.Parent then return end
    SeaHuntState.FrozenActivating = true
    SetState("FROZEN_ACTIVATING", "Frozen Dimension encontrada; procurando o NPC de ativação.")

    task.spawn(function()
        local deadline = os.clock() + 45
        while Running and frozen.Parent and os.clock() < deadline do
            local _, leviathan = FindLeviathanCombatTarget()
            if leviathan then
                SeaHuntState.FrozenActivated = true
                SetState("FROZEN_ACTIVATED", "Leviathan liberado; iniciando combate por segmentos.")
                break
            end

            if os.clock() >= (SeaHuntState.NextFrozenInteraction or 0) then
                SeaHuntState.NextFrozenInteraction = os.clock() + 1.5
                local prompt, click = nil, nil
                for _, obj in ipairs(frozen:GetDescendants()) do
                    if not prompt and obj:IsA("ProximityPrompt") and obj.Enabled then
                        prompt = obj
                    elseif not click and obj:IsA("ClickDetector") then
                        click = obj
                    end
                end

                local interaction = prompt or click
                local parentPart = interaction and interaction.Parent
                if parentPart and parentPart:IsA("BasePart") and HRP and Humanoid then
                    ForceExitBoatForCombat()
                    FlyToPart(parentPart, 10, true)
                    task.wait(0.2)
                    if prompt and type(fireproximityprompt) == "function" then
                        pcall(function() fireproximityprompt(prompt) end)
                    elseif click and type(fireclickdetector) == "function" then
                        pcall(function() fireclickdetector(click) end)
                    end
                end
            end
            task.wait(0.25)
        end

        SeaHuntState.FrozenActivating = false
        if Running and not SeaHuntState.FrozenActivated and not SeaHuntState.CurrentEvent then
            SetState("FROZEN_WAITING", "Ilha encontrada; aguardando NPC/ativação do Leviathan.")
        end
    end)
end

SeaHuntState.EquipTorchTool = function()
    if not Character or not Humanoid then return nil end
    for _, container in ipairs({Character, LocalPlayer:FindFirstChild("Backpack")}) do
