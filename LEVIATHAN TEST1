local function GetBeastHunter()
    local boats = workspace:FindFirstChild("Boats")
    if not boats then return nil end

    local fallback = nil
    local ownerlessCount = 0

    for _, boat in ipairs(boats:GetChildren()) do
        if boat.Name == "Beast Hunter" then
            local owner = boat:FindFirstChild("BoatOwner")
            local ownerValue = owner and owner.Value
            if ownerValue == LocalPlayer
            or tostring(ownerValue) == LocalPlayer.Name then
                return boat
            end

            local seat = boat:FindFirstChild("VehicleSeat")
            if seat and seat.Occupant and seat.Occupant.Parent == Character then
                return boat
            end

            if not owner then
                ownerlessCount = ownerlessCount + 1
                fallback = boat
            end
        end
    end

    -- Compatibilidade com servidores antigos que não replicam BoatOwner:
    -- só aceita o fallback quando existe um único Beast Hunter no mapa.
    return ownerlessCount == 1 and fallback or nil
end

local function GetBeastHunterMainSeat()
    local boat = GetBeastHunter()
    return boat and boat:FindFirstChild("VehicleSeat")
end

local function GetBeastHunterHarpoonSeat()
    local boat = GetBeastHunter()
    if not boat then return nil end
    local harpoon = boat:FindFirstChild("Harpoon")
    local exact = harpoon and harpoon:FindFirstChild("Seat", true)
    if exact and exact:IsA("Seat") then return exact end

    for _, obj in ipairs(boat:GetDescendants()) do
        if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
            local full = string.lower(obj:GetFullName())
            if string.find(full, "harpoon", 1, true)
            or string.find(full, "gunseat", 1, true) then
                return obj
            end
        end
    end
    return nil
end

-- FrozenHeart pode existir mesmo quando o arpao falhou. Presenca ou
-- desaparecimento nao contam como captura: ele precisa estar ligado ao barco
-- ou acompanhar seu deslocamento por amostras consecutivas.
SeaHuntState.FindHeart = function()
    if SeaHuntState.HeartModel and SeaHuntState.HeartModel.Parent then
        return SeaHuntState.HeartModel
    end
    local boat = GetBeastHunter()
    for _, root in ipairs({boat, workspace:FindFirstChild("Map"), workspace}) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                local lower = string.lower(obj.Name)
                if (lower == "frozenheart" or lower == "leviathanheart" or lower == "leviathan heart")
                and (obj:IsA("Model") or obj:IsA("BasePart")) then
                    SeaHuntState.HeartModel = obj
                    return obj
                end
            end
        end
    end
    return nil
end

SeaHuntState.HeartPosition = function(heart)
    if not heart or not heart.Parent then return nil end
    if heart:IsA("BasePart") then return heart.Position end
    local ok, pivot = pcall(function() return heart:GetPivot() end)
    return ok and pivot.Position or nil
end

SeaHuntState.SampleHeartCapture = function(heart)
    local boat = GetBeastHunter()
    local mainSeat = boat and boat:FindFirstChild("VehicleSeat")
    local drivePart = mainSeat and (mainSeat.AssemblyRootPart or mainSeat)
    local heartPos = SeaHuntState.HeartPosition(heart)
    if not boat or not drivePart or not heartPos then return false end
    if heart:IsDescendantOf(boat) then
        SeaHuntState.HeartCaptured = true
        return true
    end
    local now = os.clock()
    local relative = heartPos - drivePart.Position
    local previous = SeaHuntState.HeartSample
    SeaHuntState.HeartSample = {Time=now, Boat=drivePart.Position, Heart=heartPos, Relative=relative, Matches=previous and previous.Matches or 0}
    if previous and now - previous.Time <= 1.5 then
        local boatMove = (drivePart.Position - previous.Boat).Magnitude
        local heartMove = (heartPos - previous.Heart).Magnitude
        local relativeDrift = (relative - previous.Relative).Magnitude
        if boatMove >= 12 and heartMove >= 12 and relativeDrift <= 18 then
            SeaHuntState.HeartSample.Matches = (previous.Matches or 0) + 1
        else
            SeaHuntState.HeartSample.Matches = 0
        end
    end
    if SeaHuntState.HeartSample.Matches >= 3 then SeaHuntState.HeartCaptured = true end
    return SeaHuntState.HeartCaptured
end

