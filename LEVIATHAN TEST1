local function Label(parent, text, height)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -6, 0, height or 28)
    l.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    l.BorderSizePixel = 0
    l.TextColor3 = Color3.fromRGB(235, 235, 235)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font = Enum.Font.SourceSans
    l.TextSize = 13
    l.Text = "  " .. text
    l.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = l

    return l
end

local function Button(parent, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 34)
    b.BackgroundColor3 = Color3.fromRGB(46, 46, 46)
    b.BorderSizePixel = 0
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 13
    b.Text = text
    b.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        callback(b)
    end)

    return b
end

local function Toggle(parent, text, initial, callback)
    local value = initial
    local b = Button(parent, "", function(button)
        value = not value
        button.Text = text .. ": " .. (value and "ON" or "OFF")
        button.BackgroundColor3 = value and Color3.fromRGB(40, 130, 85) or Color3.fromRGB(80, 45, 45)
        callback(value)
    end)

    b.Text = text .. ": " .. (value and "ON" or "OFF")
    b.BackgroundColor3 = value and Color3.fromRGB(40, 130, 85) or Color3.fromRGB(80, 45, 45)

    return b
end

