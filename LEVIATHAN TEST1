local SeaEventOrder = {"SeaBeast", "Ship", "Shark", "Terrorshark", "Piranha"}

local function SeaEventDisplayName(key)
    if key == "SeaBeast" then return "SeaBeast" end
    return key
end

local function UpdateSeaEventButtonText()
    local selected = {}

    for _, key in ipairs(SeaEventOrder) do
        if SeaEventsSelected[key] then
            table.insert(selected, SeaEventDisplayName(key))
        end
    end

    if #selected == 0 then
        SeaEventButton.Text = "  --"
    else
        SeaEventButton.Text = "  " .. table.concat(selected, ", ")
    end
end

local function PositionSeaEventDropdown()
    local pos = SeaEventButton.AbsolutePosition
    local size = SeaEventButton.AbsoluteSize

    SeaEventDropdown.Position = UDim2.fromOffset(
        pos.X,
        pos.Y + size.Y + 4
    )
end

local function RebuildSeaEventDropdown()
    for _, child in ipairs(SeaEventDropdown:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, key in ipairs(SeaEventOrder) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -8, 0, 34)
        b.BackgroundColor3 = Color3.fromRGB(42, 42, 45)
        b.BorderSizePixel = 0
        b.TextColor3 = Color3.fromRGB(230, 230, 230)
        b.Font = Enum.Font.SourceSans
        b.TextSize = 13
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.ZIndex = 125
        b.Parent = SeaEventDropdown

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 4)
        c.Parent = b

        local function refresh()
            local mark = SeaEventsSelected[key] and "✓" or " "
            b.Text = "  [" .. mark .. "] " .. SeaEventDisplayName(key)
            b.BackgroundColor3 = SeaEventsSelected[key]
                and Color3.fromRGB(50, 63, 60)
                or Color3.fromRGB(42, 42, 45)
        end

        refresh()

        b.MouseButton1Click:Connect(function()
            SeaEventsSelected[key] = not SeaEventsSelected[key]
            refresh()
            UpdateSeaEventButtonText()
        end)
    end

    SeaEventDropdown.Size = UDim2.new(0, 190, 0, #SeaEventOrder * 36 + 8)
    PositionSeaEventDropdown()
end

