-- =========================================================
-- BEAST HUNTER AUTO DRIVE v4
--
-- Controle reforçado:
-- * LinearVelocity no AssemblyRootPart do barco
-- * AlignOrientation para apontar para a traseira da Tiki
-- * Throttle/W continuam ativos como fallback aceito pelo servidor
-- * noclip em todo o Beast Hunter
-- * Y alvo = 70
-- =========================================================

local BoatLinearVelocity = nil
local BoatAlignOrientation = nil
local BoatAttachment = nil
local BoatDrivePart = nil
local BoatCollisionCache = {}
local BoatObstacleCollisionCache = {}
local BoatNoclipConnection = nil
local FixedSeaDirection = nil

local function GetBoatDrivePart()
    local boat = GetBeastHunter()
    if not boat then return nil end

    local seat = boat:FindFirstChild("VehicleSeat")
    if seat then
        local root = nil
        pcall(function()
            root = seat.AssemblyRootPart
        end)
        return root or seat
    end

    return boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart", true)
end

local function ApplyBoatNoclip()
    local boat = GetBeastHunter()
    if not boat then return end

    for _, obj in ipairs(boat:GetDescendants()) do
        if obj:IsA("BasePart") then
            if BoatCollisionCache[obj] == nil then
                BoatCollisionCache[obj] = obj.CanCollide
            end
            obj.CanCollide = false
        end
    end
end

local function ApplyBoatObstacleNoclip(drivePart, direction)
    local boat = GetBeastHunter()
    if not boat or not drivePart then return end

    local flatDirection = Vector3.new(direction.X, 0, direction.Z)
    if flatDirection.Magnitude < 0.01 then
        flatDirection = Vector3.new(-1, 0, 0)
    else
        flatDirection = flatDirection.Unit
    end

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = Character and {boat, Character} or {boat}
    params.MaxParts = 0

    -- A caixa acompanha a frente do barco e remove localmente somente a
    -- colisão de geometria estática. Isso cobre muralhas/rochas grandes que
    -- continuam bloqueando a assembly mesmo com as peças do barco em noclip.
    local center = drivePart.Position + flatDirection * 55
    local scanCFrame = CFrame.lookAt(center, center + flatDirection)
    local seenNow = {}

    for _, part in ipairs(workspace:GetPartBoundsInBox(
        scanCFrame,
        Vector3.new(150, 150, 190),
        params
    )) do
        if part:IsA("BasePart")
        and part.Anchored
        and (part.CanCollide or BoatObstacleCollisionCache[part] ~= nil)
        and not part:IsDescendantOf(boat) then
            if BoatObstacleCollisionCache[part] == nil then
                BoatObstacleCollisionCache[part] = part.CanCollide
            end
            seenNow[part] = true
            part.CanCollide = false
        end
    end

    -- Restaura obstáculos que já ficaram para trás para não deixar o mapa
    -- inteiro sem colisão durante uma viagem longa.
    for part, oldValue in pairs(BoatObstacleCollisionCache) do
        if not part or not part.Parent then
            BoatObstacleCollisionCache[part] = nil
        elseif not seenNow[part] then
            pcall(function()
                part.CanCollide = oldValue
            end)
            BoatObstacleCollisionCache[part] = nil
        end
    end
end

local function RestoreBoatCollision()
    for obj, oldValue in pairs(BoatCollisionCache) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = oldValue
            end)
        end
    end
    BoatCollisionCache = {}

    for obj, oldValue in pairs(BoatObstacleCollisionCache) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = oldValue
            end)
        end
    end
    BoatObstacleCollisionCache = {}
end

local function CalculateFixedSeaDirection(boatPart)
    -- Direção real medida com o mapper:
    -- praticamente -X, com pequena componente -Z.
    FixedSeaDirection = SEA6_MAPPED_DIRECTION
    return FixedSeaDirection
end

local function GetSea6VirtualTarget()
    return Vector3.new(
        SEA6_MAPPED_POSITION.X,
        BoatFlightConfig.HeightY,
        SEA6_MAPPED_POSITION.Z
    )
end

local function DestroyBoatFlightPhysics()
    if BoatLinearVelocity then
        pcall(function() BoatLinearVelocity:Destroy() end)
        BoatLinearVelocity = nil
    end

    if BoatAlignOrientation then
        pcall(function() BoatAlignOrientation:Destroy() end)
        BoatAlignOrientation = nil
    end

    if BoatAttachment then
        pcall(function() BoatAttachment:Destroy() end)
        BoatAttachment = nil
    end

    BoatDrivePart = nil
end

local function EnsureBoatFlightPhysics()
    local drivePart = GetBoatDrivePart()
    if not drivePart then
        DestroyBoatFlightPhysics()
        return nil
    end

    if BoatDrivePart ~= drivePart then
        DestroyBoatFlightPhysics()
        BoatDrivePart = drivePart
    end

    ApplyBoatNoclip()

    if not BoatAttachment or not BoatAttachment.Parent then
        BoatAttachment = Instance.new("Attachment")
        BoatAttachment.Name = "IKARO_BoatFlightAttachment"
        BoatAttachment.Parent = drivePart
    end

    if not BoatLinearVelocity or not BoatLinearVelocity.Parent then
        BoatLinearVelocity = Instance.new("LinearVelocity")
        BoatLinearVelocity.Name = "IKARO_BoatLinearVelocity"
        BoatLinearVelocity.Attachment0 = BoatAttachment
        BoatLinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        BoatLinearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        BoatLinearVelocity.MaxForce = math.huge
        BoatLinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
        BoatLinearVelocity.Parent = drivePart
    end

    if not BoatAlignOrientation or not BoatAlignOrientation.Parent then
        BoatAlignOrientation = Instance.new("AlignOrientation")
        BoatAlignOrientation.Name = "IKARO_BoatAlignOrientation"
        BoatAlignOrientation.Attachment0 = BoatAttachment
        BoatAlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        BoatAlignOrientation.RigidityEnabled = false
        BoatAlignOrientation.Responsiveness = 35
        BoatAlignOrientation.MaxTorque = math.huge
        BoatAlignOrientation.Parent = drivePart
    end

    return drivePart
end

local function DetectSeaLevel6FromGui()
    for _, item in ipairs(GetVisibleGuiTexts()) do
        local l = string.lower(item.Text)

        if string.find(l, "danger level 6", 1, true)
        or string.find(l, "sea danger level 6", 1, true)
        or (
            string.find(l, "level 6", 1, true)
            and (
                string.find(l, "sea", 1, true)
                or string.find(l, "danger", 1, true)
            )
        ) then
            SeaHuntState.AtSea6 = true
            return true
        end
    end

    return SeaHuntState.AtSea6
end

local function StopBoatDrive(restoreCollision)
    SeaHuntState.Driving = false

    if BoatNoclipConnection then
        BoatNoclipConnection:Disconnect()
        BoatNoclipConnection = nil
    end

    DestroyBoatFlightPhysics()

    if SeaVIM then
        pcall(function()
            SeaVIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
        end)
    end

    -- Sempre restaura a geometria externa. As colisões originais do barco
    -- só voltam quando solicitado, pois ele pode retomar a caça logo depois.
    for obj, oldValue in pairs(BoatObstacleCollisionCache) do
        if obj and obj.Parent then
            pcall(function() obj.CanCollide = oldValue end)
        end
    end
    BoatObstacleCollisionCache = {}

    if restoreCollision then RestoreBoatCollision() end
end

local function TrySeatMainAccount()
    local seat = GetBeastHunterMainSeat()
    if not seat or not Humanoid then return false end

    if Humanoid.SeatPart == seat then
        return true
    end

    pcall(function()
        seat:Sit(Humanoid)
    end)

    task.wait(0.15)
    return Humanoid.SeatPart == seat
end

local function StartBoatDrive(forceStart)
    if not SeaHuntState.AutoDrive or SeaHuntState.Driving then
        return
    end

    local boat = GetBeastHunter()
    if not boat then
        SetState("BOAT_DRIVE_WAIT", "Beast Hunter ainda não apareceu.")
        return
    end

    TrySeatMainAccount()

    FixedSeaDirection = nil
    SeaHuntState.Driving = true


    if BoatNoclipConnection then
        BoatNoclipConnection:Disconnect()
    end

    -- Stepped roda imediatamente antes da resolução física. Reaplicar aqui
    -- impede scripts do barco/servidor de religarem CanCollide entre ciclos.
    BoatNoclipConnection = RunService.Stepped:Connect(function()
        if SeaHuntState.Driving then
            ApplyBoatNoclip()
        end
    end)

    SetState(
        "BOAT_FLYING_TO_SEA6",
        "Rota EXATA Sea 6 | Speed=" .. tostring(SeaConfig.BoatSpeed)
        .. " | Y=" .. tostring(BoatFlightConfig.HeightY)
    )

    task.spawn(function()
        local nextNoclipRefresh = 0

        while (forceStart or Running) and SeaHuntState.Driving do
            local boatNow = GetBeastHunter()
            if not boatNow then break end

            local drivePart = EnsureBoatFlightPhysics()
            if not drivePart then
                SetState("BOAT_DRIVE_ERROR", "AssemblyRootPart não encontrado.")
                break
            end

            local now = os.clock()
            if now >= nextNoclipRefresh then
                ApplyBoatNoclip()
                ApplyBoatObstacleNoclip(
                    drivePart,
                    FixedSeaDirection or SEA6_MAPPED_DIRECTION
                )
                nextNoclipRefresh = now + 0.10
            end

            local targetPos = GetSea6VirtualTarget()

            local flatDelta = Vector3.new(
                targetPos.X - drivePart.Position.X,
                0,
                targetPos.Z - drivePart.Position.Z
            )

            local seaDirection

            if flatDelta.Magnitude > 250 then
                seaDirection = flatDelta.Unit
                FixedSeaDirection = seaDirection
            else
                seaDirection = CalculateFixedSeaDirection(drivePart)
                SeaHuntState.AtSea6 = true
            end

            local heightError = BoatFlightConfig.HeightY - drivePart.Position.Y
            local verticalVelocity = math.clamp(heightError * 7, -140, 140)

            local horizontalSpeed = SeaConfig.BoatSpeed

            -- desacelera um pouco quando chega perto do ponto mapeado
            if flatDelta.Magnitude < 1500 then
                horizontalSpeed = math.max(180, SeaConfig.BoatSpeed * 0.65)
            end

            local wantedVelocity =
                seaDirection * horizontalSpeed
                + Vector3.new(0, verticalVelocity, 0)

            BoatLinearVelocity.VectorVelocity = wantedVelocity

            BoatAlignOrientation.CFrame = CFrame.lookAt(
                Vector3.new(0, 0, 0),
                seaDirection,
                Vector3.new(0, 1, 0)
            )

            -- Fallback do controle nativo do barco.
            local mainSeat = GetBeastHunterMainSeat()
            if mainSeat then
                pcall(function()
                    mainSeat.Throttle = 1
                end)
            end

            if SeaVIM then
                pcall(function()
                    SeaVIM:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                end)
            end

            -- reforço adicional da assembly sem CFrame/teleporte.
            pcall(function()
                drivePart.AssemblyLinearVelocity = wantedVelocity
                drivePart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)

            if DetectSeaLevel6FromGui() and State ~= "SEA6_REACHED" then
                SetState(
                    "SEA6_REACHED",
                    "Sea 6 detectado. Mantendo navegação."
                )
            end

            task.wait()
        end

        StopBoatDrive(false)
    end)
end

