local function PressSkill(keyName, hold)
    local key = Enum.KeyCode[keyName]
    if not key then
        return
    end

    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(hold or 0.1)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function EquipCategory(category)
    -- Placeholder.
    -- Primeiro vamos validar o detector/seguir dono.
    -- Depois mapearemos como selecionar Melee/Sword/Gun/Fruit corretamente.
    print("IKARO: categoria de combate:", category)
end

local function RunCombatRotationOnce()
    local category = CombatConfig.Type
    local cfg = CombatConfig[category]

    if not cfg then
        return
    end

    EquipCategory(category)

    local order

    if category == "Fruit" then
        order = {"Z","X","C","V","F"}
    elseif category == "Melee" then
        order = {"Z","X","C"}
    else
        order = {"Z","X"}
    end

    for _, key in ipairs(order) do
        if not Running or State ~= "COMBAT" then
            return
        end

        if cfg.Selected[key] then
            PressSkill(key, cfg.Hold[key] or 0.5)
            task.wait(0.15)
        end
    end
end

-- =========================================================
-- HUNT STATE MACHINE - TEST VERSION
-- =========================================================

local HuntThread = nil

local function StopHunt()
    Running = false
    StopFollow()

    if HRP then
        HRP.AssemblyLinearVelocity = Vector3.new(0,0,0)
    end

    LeviathanModel = nil
    SetState("STOPPED", "Automação parada.")
end

local function StartHunt()
    if Running then
        return
    end

    if not AccountBuyBoat and not OwnerPlayer then
        SetState("ERROR", "Selecione o Owner Boat antes de iniciar.")
        return
    end

    Running = true

    if AccountBuyBoat then
        SetState(
            "MAIN_WAITING",
            "Conta principal ativa. Compra/controle do Beast Hunter ainda será mapeado."
        )
    else
        SetState(
            "FOLLOW_OWNER",
            "Seguindo " .. OwnerPlayer.Name
        )
        StartFollowOwner()
    end

    HuntThread = task.spawn(function()
        while Running do
            local leviathan = FindLeviathan()

            if leviathan then
                LeviathanModel = leviathan
                StopFollow()

                SetState(
                    "LEVIATHAN_FOUND",
                    leviathan:GetFullName()
                )

                task.wait(0.5)

                if Running then
                    SetState(
                        "COMBAT",
                        "Leviathan detectado. Iniciando rotação TESTE de skills."
                    )

                    while Running and LeviathanModel and LeviathanModel.Parent do
                        RunCombatRotationOnce()
                        task.wait(0.2)
                    end

                    if Running then
                        LeviathanModel = nil

                        if AccountBuyBoat then
                            SetState("MAIN_WAITING", "Leviathan saiu/despawnou.")
                        else
                            SetState("FOLLOW_OWNER", "Leviathan saiu/despawnou.")
                            StartFollowOwner()
                        end
                    end
                end
            else
                if AccountBuyBoat then
                    SetState(
                        "SEARCHING_LEVIATHAN",
                        "Principal aguardando Leviathan. Navegação do barco ainda será adicionada."
                    )
                else
                    SetState(
                        "FOLLOW_OWNER",
                        "Acompanhando " .. OwnerPlayer.Name .. " e procurando Leviathan."
                    )
                end
            end

            task.wait(1)
        end
    end)
end

Toggle(HuntPage, "Start Hunt Leviathan", false, function(v)
    if v then
