local function GetModelTargetPart(model)
    local detector = getgenv().IKARO_SEA_EVENTS
    if detector then return detector.TargetPart(model) end
    if not model then return nil end

    if model:IsA("BasePart") then
        return model
    end

    local preferred = model:FindFirstChild("HumanoidRootPart", true)
        or model:FindFirstChild("VehicleSeat", true)
        or model:FindFirstChild("Engine", true)
        or model:FindFirstChild("Root", true)
        or model.PrimaryPart

    if preferred and preferred:IsA("BasePart") then return preferred end

    -- Em Pirate Brigade/Fish Boat nem sempre existe HRP. Usa a maior peça
    -- física da assembly em vez de escolher um detalhe visual aleatório.
    local bestPart = nil
    local bestSize = -1
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local size = part.Size.X * part.Size.Y * part.Size.Z
            if not part.Anchored then size = size + 1000000 end
            if size > bestSize then
                bestSize = size
                bestPart = part
            end
        end
    end

    return bestPart
end

local function IsEventAlive(model)
    local detector = getgenv().IKARO_SEA_EVENTS
    if detector then return detector.Alive(model) end
    if not model or not model.Parent then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        return hum.Health > 0
    end

    for _, healthName in ipairs({"Health", "HP", "ShipHealth"}) do
        local value = model:FindFirstChild(healthName, true)
        if value and (value:IsA("NumberValue") or value:IsA("IntValue")) then
            return value.Value > 0
        end

        local attribute = model:GetAttribute(healthName)
        if type(attribute) == "number" then
            return attribute > 0
        end
    end

    return model.Parent ~= nil
end

-- Cokka mantém Leviathan, segmentos e cauda em Workspace.SeaBeasts. Cada
-- segmento é um alvo separado; priorizamos segmentos, depois cauda e corpo.
FindLeviathanCombatTarget = function()
    local seaBeasts = workspace:FindFirstChild("SeaBeasts")
    if not seaBeasts then return nil, nil end

    local priorities = {
        ["leviathan segment"] = 1,
        ["leviathan tail"] = 2,
        ["leviathan"] = 3
    }
    local best, bestPriority = nil, math.huge

    for _, obj in ipairs(seaBeasts:GetChildren()) do
        if obj:IsA("Model") and IsEventAlive(obj) then
            local priority = priorities[string.lower(obj.Name)]
            if priority and priority < bestPriority then
                local part = GetModelTargetPart(obj)
                if part and (not HRP or (part.Position - HRP.Position).Magnitude <= 3500) then
                    best, bestPriority = obj, priority
                end
            end
        end
    end

    return best and "Leviathan" or nil, best
end

local function ForceExitBoatForCombat()
    if not Humanoid or not Character or not HRP then return false end

    local previousSeat = Humanoid.SeatPart

    for _ = 1, 8 do
        pcall(function()
            Humanoid.Sit = false
            Humanoid.PlatformStand = false
            Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)

        -- VehicleSeat pode manter um weld mesmo depois de Sit=false. Remove
        -- somente welds ligados ao nosso personagem para liberar a conta.
        if previousSeat and previousSeat.Parent then
            for _, obj in ipairs(previousSeat:GetDescendants()) do
                if obj:IsA("Weld") or obj:IsA("WeldConstraint") then
                    local connectedToCharacter = false
                    pcall(function()
                        connectedToCharacter =
                            (obj.Part0 and obj.Part0:IsDescendantOf(Character))
                            or (obj.Part1 and obj.Part1:IsDescendantOf(Character))
                    end)

                    if connectedToCharacter
                    or string.find(string.lower(obj.Name), "seatweld", 1, true) then
                        pcall(function() obj:Destroy() end)
                    end
                end
            end
        end

        if not Humanoid.SeatPart and not Humanoid.Sit then break end
        task.wait(0.08)
    end

    pcall(function()
        HRP.AssemblyLinearVelocity = Vector3.new(0, 45, 0)
        HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)

    task.wait(0.12)
    return not Humanoid.SeatPart
end

EnsureSeaCombatHaki = function()
    if not Character or Character:FindFirstChild("HasBuso") then return true end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local comm = remotes and remotes:FindFirstChild("CommF_")
    if not comm then return false end

    return pcall(function()
        comm:InvokeServer("Buso")
    end)
end

-- Limpeza visual trazida do Banana. Remove apenas os efeitos conhecidos do
-- mar/Terrorshark; não percorre Workspace nem altera os Sea Events.
SeaHuntState.ClearSeaFog = function()
    if not SeaConfig.RemoveSeaFog then return end
    local lighting = game:GetService("Lighting")
    for _, name in ipairs({"SeaTerrorCC", "BaseAtmosphere"}) do
        local effect = lighting:FindFirstChild(name)
        if effect then pcall(function() effect:Destroy() end) end
    end
    local layers = lighting:FindFirstChild("LightingLayers")
    if layers then
        for _, name in ipairs({"Atmosphere", "DarkFog"}) do
            local effect = layers:FindFirstChild(name)
            if effect then pcall(function() effect:Destroy() end) end
        end
    end
    lighting.FogEnd = 100000
end

local function StartSeaEventFocus(eventKey, eventModel, useBasicClick)
    if not HRP or not Humanoid then return nil end

    local oldPlatformStand = Humanoid.PlatformStand
    local oldAutoRotate = Humanoid.AutoRotate
    local collisionCache = {}
    local stableHoverY = nil

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "IKARO_SeaEventFocusVelocity"
    bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVelocity.P = 18000
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = HRP

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "IKARO_SeaEventFocusGyro"
    bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bodyGyro.P = 18000
    bodyGyro.D = 700
    bodyGyro.CFrame = HRP.CFrame
    bodyGyro.Parent = HRP

    -- PlatformStand bloqueia o controlador normal de M1 em vários executores.
    -- Skills continuam usando-o; mobs de clique permanecem em estado atacável.
    Humanoid.PlatformStand = not useBasicClick
    Humanoid.AutoRotate = false

    local nextNoclip = 0
    local connection = RunService.Heartbeat:Connect(function()
        if EscapeActive or not Running or SeaHuntState.CurrentEvent ~= eventModel then
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            return
        end

        local target = GetModelTargetPart(eventModel)
        if not target or not HRP or not HRP.Parent then return end

        local now = os.clock()
        if now >= nextNoclip and Character then
            nextNoclip = now + 0.10
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if collisionCache[part] == nil then
                        collisionCache[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end

        -- Sea Beast é muito alto e recebe dano por skills; manter grande
        -- altitude evita contato com a água sem sair do alcance das skills.
        local isShipEvent = eventKey == "PirateBrigade"
            or eventKey == "PirateGrandBrigade"
            or eventKey == "FishBoat"
        local isLeviathan = eventKey == "Leviathan"
        local stableSkillHover = eventKey == "Terrorshark" or isLeviathan
        local height = eventKey == "SeaBeast" and 260
            or isLeviathan and 366
            or isShipEvent and 80
            or eventKey == "Piranha" and 18
            or useBasicClick and 30
            or eventKey == "Terrorshark" and (
                workspace:FindFirstChild("_WorldOrigin")
                and workspace._WorldOrigin:FindFirstChild("Typhoon Splash")
                and 300 or 45
            )
            -- O trace de morte do Terror Shark nao registrou RegisterHit nem
            -- RegisterAttack. Ele foi eliminado por skills com a conta acima
            -- do alvo; mantemos altura segura sem copiar o sobe/desce do Maru.
            or stableSkillHover and 90
            or 60
        -- Todos os Sea Events sao atacados diretamente por cima. Somente o
        -- personagem se move; nenhuma propriedade do mob/barco e alterada.
        if (useBasicClick or isShipEvent or stableSkillHover) and not stableHoverY then
            stableHoverY = target.Position.Y + height
        end
        -- Sharks mergulham depois que o hover é criado. A altura totalmente
        -- congelada deixava o personagem visualmente alinhado, porém a
        -- distância 3D ultrapassava o limite e o loop parava de atacar. Só
        -- corrigimos desvios grandes e de forma suave para não voltar a quicar.
        if (useBasicClick or stableSkillHover) and stableHoverY then
            local targetHoverY = target.Position.Y + height
            if math.abs(targetHoverY - stableHoverY) > 12 then
                stableHoverY = stableHoverY + (targetHoverY - stableHoverY) * 0.12
            end
        end
        -- Skills lançadas no eixo vertical empurravam o ship para baixo. O
        -- deslocamento lateral mantém a conta acima da água, fora da estrutura,
        -- e transforma o knockback em diagonal/horizontal.
        local combatOffset = Vector3.new(0, 0, 0)
        if isShipEvent or stableSkillHover or eventKey == "Piranha" then
            local right = Vector3.new(target.CFrame.RightVector.X, 0, target.CFrame.RightVector.Z)
            local offsetDistance = isShipEvent and 95
                or isLeviathan and 50
                or eventKey == "Terrorshark" and 0
                or stableSkillHover and 110
                or 45
            combatOffset = (right.Magnitude > 0.01 and right.Unit or Vector3.new(1, 0, 0)) * offsetDistance
        end
        local desired = (useBasicClick or isShipEvent or stableSkillHover)
            and Vector3.new(
                target.Position.X + combatOffset.X,
                stableHoverY,
                target.Position.Z + combatOffset.Z
            )
            or target.Position + Vector3.new(0, height, 0)
        local delta = desired - HRP.Position
        local distance = delta.Magnitude

        if useBasicClick or isShipEvent or stableSkillHover then
            HRP.CFrame = CFrame.lookAt(desired, target.Position)
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        elseif distance > 7 then
            local speed = distance > 800 and 340
                or distance > 250 and 280
                or distance > 70 and 210
                or eventKey == "Piranha" and 90
                or 145
            bodyVelocity.Velocity = delta.Unit * speed
        else
            bodyVelocity.Velocity = target.AssemblyLinearVelocity + delta * 5
        end

        local lookPosition = Vector3.new(target.Position.X, HRP.Position.Y, target.Position.Z)
        if (lookPosition - HRP.Position).Magnitude > 0.01 then
            bodyGyro.CFrame = CFrame.lookAt(HRP.Position, lookPosition)
        end

    end)

    return function()
        if connection then connection:Disconnect() end
        pcall(function() bodyVelocity:Destroy() end)
        pcall(function() bodyGyro:Destroy() end)

        if useBasicClick and BMVirtualUser then
            pcall(function()
                BMVirtualUser:Button1Up(Vector2.new(1280, 672))
            end)
        end

        if Humanoid then
            Humanoid.PlatformStand = oldPlatformStand
            Humanoid.AutoRotate = oldAutoRotate
        end

        for part, oldValue in pairs(collisionCache) do
            if part and part.Parent then
                pcall(function() part.CanCollide = oldValue end)
            end
        end

        if HRP then
            pcall(function()
                HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end
end

local function CombatSelectedSeaEvent(eventKey, eventModel)
    if not eventModel then return end
    SeaHuntState.CurrentEvent = eventModel
    StopFollow()
    local target = GetModelTargetPart(eventModel)
    if not target then
        SeaHuntState.CurrentEvent = nil
        return
    end
    SetState("SEA_EVENT_BANANA", SeaEventDisplayName(eventKey))
    ForceExitBoatForCombat()
    EnsureSeaCombatHaki()
    local bananaSea = getgenv().IKARO_BANANA_SEA_COMBAT
    if not bananaSea or type(bananaSea.Combat) ~= "function" then
        SeaHuntState.CurrentEvent = nil
        error("Módulo Banana Sea Combat não carregado")
    end
    local okCombat, defeated = pcall(bananaSea.Combat, eventKey, eventModel, {
        Running = function()
            return Running and SeaHuntState.CurrentEvent == eventModel and not EscapeActive
        end,
        EquipWeapon = function() return EquipSeaCombatType("Melee") end,
        UseSkills = UseConfiguredSeaSkills,
        AimAt = AimAtSeaTarget
    })
    if not okCombat then
        SeaHuntState.CurrentEvent = nil
        error(defeated)
    end
    if defeated or not IsEventAlive(eventModel) then
        SeaHuntState.EventKills = SeaHuntState.EventKills + 1
        SetState("SEA_EVENT_DEFEATED", SeaEventDisplayName(eventKey) .. " | Total: " .. tostring(SeaHuntState.EventKills))
    end
    SeaHuntState.CurrentEvent = nil
end

