local function EquipSeaCombatType(category)
    if not Humanoid then return nil end

    local wanted = category == "Fruit" and "Blox Fruit" or category

    -- O método comprovado pelo Maru equipa Sharkman Karate antes dos hits.
    if category == "Melee" then
        for _, container in ipairs({Character, LocalPlayer.Backpack}) do
            if container then
                for _, tool in ipairs(container:GetChildren()) do
                    if tool:IsA("Tool")
                    and string.find(string.lower(tool.Name), "sharkman karate", 1, true) then
                        if tool.Parent ~= Character then
                            pcall(function() Humanoid:EquipTool(tool) end)
                        end
                        return tool
                    end
                end
            end
        end
    end

    for _, container in ipairs({LocalPlayer.Backpack, Character}) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tostring(tool.ToolTip) == wanted then
                    if tool.Parent ~= Character then
                        pcall(function() Humanoid:EquipTool(tool) end)
                    end
                    return tool
                end
            end
        end
    end

    return nil
end

