local function FindLeviathan()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local n = string.lower(obj.Name)
            if string.find(n, "leviathan", 1, true) then
                return obj
            end
        end
    end
    return nil
end

-- =========================================================
-- START HUNT
-- =========================================================

local HuntThread = nil

local function StopHunt()
    Running = false
    StopFollow()
    SetState("STOPPED", "Automação parada.")
end

local function StartHunt()
    if Running then
        return
    end

    if not AccountBuyBoat and not OwnerPlayer then
        SetState("ERROR", "Escolha o Owner Boat.")
        return
    end

    Running = true

    if AccountBuyBoat then
        SetState("MAIN_ACCOUNT", "Conta principal ativa. Compra automática do barco ainda não implementada.")
    else
        SetState("FOLLOW_OWNER", "Seguindo " .. OwnerPlayer.Name)
        StartFollowOwner()
    end

    HuntThread = task.spawn(function()
        while Running do
            local levi = FindLeviathan()

            if levi then
                StopFollow()
                SetState("LEVIATHAN_FOUND", levi:GetFullName())
            else
                if not AccountBuyBoat and OwnerPlayer then
                    SetState("FOLLOW_OWNER", "Acompanhando " .. OwnerPlayer.Name)
                elseif AccountBuyBoat then
                    SetState("SEARCHING_LEVIATHAN", "Principal aguardando Leviathan.")
                end
            end

            task.wait(1)
        end
    end)
end

ToggleRow(HuntPage, "Start Hunt Leviathan", false, function(v)
    if v then
        StartHunt()
    else
        StopHunt()
    end
end)

SimpleButton(HuntPage, "Scan Leviathan Now", function()
    local levi = FindLeviathan()

    if levi then
        SetState("LEVIATHAN_FOUND_MANUAL", levi:GetFullName())
    else
