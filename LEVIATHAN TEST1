-- AUTO SPY CHECK LOOP v2
-- =========================================================

task.spawn(function()
    while Gui and Gui.Parent do
        if Running
        and AccountBuyBoat
        and SpyState.AutoPay
        and not SpyState.Ready
        and not SpyState.Visiting
        and not SeaHuntState.CurrentEvent then

            local shouldVisit = false

            -- visita após cada novo Sea Event derrotado
            if SeaHuntState.EventKills > SpyState.LastEventKillCount then
                SpyState.LastEventKillCount = SeaHuntState.EventKills
                shouldVisit = true
            end

            -- Só faz visita periódica DEPOIS de já termos derrotado
            -- pelo menos um Sea Event. Antes disso o Spy não pode ser pago.
            if SeaHuntState.EventKills > 0
            and os.clock() - SpyState.LastVisit >= 90 then
                shouldVisit = true
            end

            if shouldVisit then
                task.spawn(VisitSpyAndReturn)
            else
                RefreshSpyStatusFromGui()
            end
        end

        task.wait(1)
    end
end)

