        if type(result) == "table" then
            local ok, encoded = pcall(function()
                return HttpService:JSONEncode(result)
            end)
            if ok then return encoded end
        end
        return tostring(result)
    end

    local function CraftSelectedScrolls(source, onePerCycle)
        if craftBusy then
            SetCraftStatus("craft já está em andamento")
            return
        end

        craftBusy = true
        local selectedCount = 0
        local results = {}
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local remote = remotes and remotes:FindFirstChild("CommF_")

        if not remote then
            SetCraftStatus("CommF_ não encontrado")
            craftBusy = false
            return
        end

        local orderedScrolls = scrolls
        if onePerCycle then
            orderedScrolls = {}
            for offset = 1, #scrolls do
                local index = ((autoQueueIndex + offset - 1) % #scrolls) + 1
                local candidate = scrolls[index]
                if SeaConfig.ScrollCraft.Selected[candidate.Id] then
                    table.insert(orderedScrolls, candidate)
                    autoQueueIndex = index
                    break
                end
            end
        end

        for _, scroll in ipairs(orderedScrolls) do
            if SeaConfig.ScrollCraft.Selected[scroll.Id] then
                selectedCount = selectedCount + 1
                local ok, result = pcall(function()
                    return remote:InvokeServer("CraftItem", "Craft", scroll.Id)
                end)
                if ok then
                    table.insert(results, scroll.Label .. ": " .. FormatCraftResult(result))
                else
                    table.insert(results, scroll.Label .. ": erro - " .. tostring(result))
                end
                -- O CraftItem aplica cooldown no servidor. O intervalo curto
                -- anterior fazia os crafts seguintes serem ignorados.
                task.wait(1.35)
            end
        end

        if selectedCount == 0 then
            SetCraftStatus("marque pelo menos um scroll")
        else
            SetCraftStatus((source or "Manual") .. " | " .. table.concat(results, " | "))
        end
        craftBusy = false
    end

    for _, scroll in ipairs(scrolls) do
        ToggleRow(
            Pages.Scrolls,
            "Craft " .. scroll.Label,
            SeaConfig.ScrollCraft.Selected[scroll.Id],
            function(value)
                SeaConfig.ScrollCraft.Selected[scroll.Id] = value
                SaveConfig()
            end
        )
    end

    ToggleRow(Pages.Scrolls, "Auto Craft selecionados", SeaConfig.ScrollCraft.AutoCraft, function(value)
        SeaConfig.ScrollCraft.AutoCraft = value
        SaveConfig()
        SetCraftStatus(value and "auto craft ativado" or "auto craft desativado")
    end)

    SimpleButton(Pages.Scrolls, "Craft selecionados agora", function()
        task.spawn(CraftSelectedScrolls, "Manual")
    end)

    task.spawn(function()
        while Gui and Gui.Parent do
            if SeaConfig.ScrollCraft.AutoCraft then
                CraftSelectedScrolls("Auto", true)
            end
            task.wait(math.clamp(tonumber(SeaConfig.ScrollCraft.Interval) or 8, 3, 60))
        end
    end)
end)

