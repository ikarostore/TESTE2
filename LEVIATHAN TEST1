local function BuyBeastHunter()
    local existing = GetBeastHunter()
    if existing then
        return true, existing
    end

    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    local comm = remotes and remotes:FindFirstChild("CommF_")

    if not comm then
        return false, "CommF_ não encontrado"
    end

    SetState("BUYING_BEAST_HUNTER", "Tentando comprar Beast Hunter...")

    -- O padrão BuyBoat foi confirmado em outro source.
    -- O diagnóstico confirmou o nome físico exato "Beast Hunter".
    local ok, result = pcall(function()
        return comm:InvokeServer("BuyBoat", "Beast Hunter")
    end)

    if not ok then
        return false, tostring(result)
    end

    local timeout = os.clock() + 8
    repeat
        task.wait(0.2)
        existing = GetBeastHunter()
    until existing or os.clock() >= timeout

    if existing then
        return true, existing
    end

    return false, "Compra chamada, mas Beast Hunter não apareceu em Workspace.Boats"
end

local function FlyToPart(part, stopDistance)
    if not part or not HRP then
        return false
    end

    stopDistance = stopDistance or 8

    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVel.P = 10000
    bodyVel.Parent = HRP

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bodyGyro.P = 12000
    bodyGyro.D = 900
    bodyGyro.Parent = HRP

    local started = os.clock()

    while Running and HRP and HRP.Parent and part and part.Parent do
        local delta = part.Position - HRP.Position
        local dist = delta.Magnitude

        if dist <= stopDistance then
            break
        end

        local dir = delta.Unit
        local speed = dist > 1000 and 300 or dist > 300 and 250 or 190

        bodyVel.Velocity = dir * speed
        bodyGyro.CFrame = CFrame.new(HRP.Position, HRP.Position + dir)

        if Humanoid then
            Humanoid.PlatformStand = true
        end

        if os.clock() - started > 25 then
            break
        end

        task.wait()
    end

    pcall(function() bodyVel:Destroy() end)
    pcall(function() bodyGyro:Destroy() end)

    if Humanoid then
        Humanoid.PlatformStand = false
    end

    return part and part.Parent and HRP
        and (part.Position - HRP.Position).Magnitude <= stopDistance + 5
end

local function GoToBeastHunterSeat()
    local seat = GetBeastHunterMainSeat()

    if not seat then
        return false, "VehicleSeat principal não encontrado"
    end

    SetState("GOING_TO_BOAT", "Voando até o VehicleSeat do Beast Hunter.")

    local arrived = FlyToPart(seat, 6)
    if not arrived then
        return false, "Não conseguiu chegar próximo ao assento"
    end

    -- tenta sentar sem teleportar
    pcall(function()
        seat:Sit(Humanoid)
    end)

    task.wait(0.6)

    if Humanoid and Humanoid.Sit then
        return true, seat
    end

    return false, "Chegou ao barco, mas não sentou"
end

