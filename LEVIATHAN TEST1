    if not seat or not Humanoid then return false end

    if Humanoid.SeatPart == seat then
        return true
    end

    pcall(function()
        seat:Sit(Humanoid)
    end)

    task.wait(0.15)
    return Humanoid.SeatPart == seat
end

local function StartBoatDrive(forceStart)
    if not SeaHuntState.AutoDrive or SeaHuntState.Driving then
        return
    end

    local boat = GetBeastHunter()
    if not boat then
        SetState("BOAT_DRIVE_WAIT", "Beast Hunter ainda não apareceu.")
        return
    end

    TrySeatMainAccount()

    FixedSeaDirection = nil
    SeaHuntState.Driving = true


    if BoatNoclipConnection then
        BoatNoclipConnection:Disconnect()
        BoatNoclipConnection = nil
    end

    -- A própria rotina de direção reaplica o noclip em intervalo controlado.
    -- Enumerar todas as peças do barco em todo Stepped causava uso excessivo.

    SetState(
        "BOAT_FLYING_TO_SEA6",
        "Rota EXATA Sea 6 | Speed=" .. tostring(SeaConfig.BoatSpeed)
        .. " | Y=" .. tostring(BoatFlightConfig.HeightY)
    )

    task.spawn(function()
        local nextNoclipRefresh = 0

        while (forceStart or Running) and SeaHuntState.Driving do
            local boatNow = GetBeastHunter()
            if not boatNow then break end

            local drivePart = EnsureBoatFlightPhysics()
            if not drivePart then
                SetState("BOAT_DRIVE_ERROR", "AssemblyRootPart não encontrado.")
                break
            end

            local now = os.clock()
            if now >= nextNoclipRefresh then
                ApplyBoatNoclip()
                ApplyBoatObstacleNoclip(
                    drivePart,
                    FixedSeaDirection or Navigation.Direction
                )
                nextNoclipRefresh = now + 0.10
            end

            local frozenObject, frozenPosition = FindFrozenDimension()
            local navigatingFrozen = frozenPosition
                and not SeaHuntState.FrozenActivated
                and not SeaHuntState.ReturningHeart
            local heartDestination = SeaConfig.HeartDestination == "Hydra"
                and SeaHuntState.HydraHeartDestination
                or Navigation.Tiki
            local targetPos = SeaHuntState.ReturningHeart
                and Vector3.new(heartDestination.X, BoatFlightConfig.HeightY, heartDestination.Z)
                or navigatingFrozen
                    and Vector3.new(frozenPosition.X, BoatFlightConfig.HeightY, frozenPosition.Z)
                or GetSea6VirtualTarget()

            local flatDelta = Vector3.new(
                targetPos.X - drivePart.Position.X,
                0,
                targetPos.Z - drivePart.Position.Z
            )

            local seaDirection

            -- Depois de entrar na região do Sea 6, segue eternamente na rota
            -- mapeada. Não tenta voltar para o ponto de entrada ao ultrapassá-lo.
            if navigatingFrozen then
                if flatDelta.Magnitude <= 300 then
                    SeaHuntState.FrozenReached = true
                    SetState("FROZEN_REACHED", "Beast Hunter chegou à Frozen Dimension.")
                    task.defer(function() TryActivateFrozenDimension(frozenObject) end)
                    break
                end
                seaDirection = flatDelta.Magnitude > 1 and flatDelta.Unit or Navigation.Direction
                FixedSeaDirection = seaDirection
            elseif SeaHuntState.ReturningHeart then
                if flatDelta.Magnitude <= 350 then
                    SeaHuntState.HeartDelivered = true
                    SeaHuntState.ReturningHeart = false
                    local destinationName = SeaConfig.HeartDestination == "Hydra" and "Hydra" or "Tiki"
                    SetState("HEART_AT_" .. string.upper(destinationName), "Coração levado até " .. destinationName .. ".")
                    if destinationName == "Hydra" and SeaConfig.AutoDracoTorch then
                        task.defer(SeaHuntState.TryAutoDracoTorches)
                    end
                    break
                end
                seaDirection = flatDelta.Unit
                FixedSeaDirection = seaDirection
            elseif SeaHuntState.AtSea6 or flatDelta.Magnitude <= 1000 then
                SeaHuntState.AtSea6 = true
                seaDirection = Navigation.Direction
                FixedSeaDirection = seaDirection
            elseif flatDelta.Magnitude > 250 then
                seaDirection = flatDelta.Unit
                FixedSeaDirection = seaDirection
            else
                seaDirection = CalculateFixedSeaDirection(drivePart)
                SeaHuntState.AtSea6 = true
            end

            local heightError = BoatFlightConfig.HeightY - drivePart.Position.Y
            local verticalVelocity = math.clamp(heightError * 7, -140, 140)

            -- Limite separado para evitar os rollbacks vistos no trace.
            local horizontalSpeed = (SeaHuntState.ReturningHeart or navigatingFrozen)
                and math.min(SeaConfig.BoatSpeed, 180)
                or SeaConfig.BoatSpeed

            -- desacelera um pouco quando chega perto do ponto mapeado
            if not SeaHuntState.AtSea6 and flatDelta.Magnitude < 1500 then
                horizontalSpeed = math.max(180, SeaConfig.BoatSpeed * 0.65)
            end

            local wantedVelocity =
                seaDirection * horizontalSpeed
                + Vector3.new(0, verticalVelocity, 0)

            BoatLinearVelocity.VectorVelocity = wantedVelocity

            BoatAlignOrientation.CFrame = CFrame.lookAt(
                Vector3.new(0, 0, 0),
                seaDirection,
                Vector3.new(0, 1, 0)
            )

            -- Fallback do controle nativo do barco.
            local mainSeat = GetBeastHunterMainSeat()
            if mainSeat then
                pcall(function()
                    mainSeat.Throttle = 1
                end)
            end

            if SeaVIM then
                pcall(function()
                    SeaVIM:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                end)
            end

            -- reforço adicional da assembly sem CFrame/teleporte.
            pcall(function()
                drivePart.AssemblyLinearVelocity = wantedVelocity
                drivePart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)

            if DetectSeaLevel6FromGui() and State ~= "SEA6_REACHED" then
                SetState(
                    "SEA6_REACHED",
                    "Sea 6 detectado. Mantendo navegação."
                )
            end

            task.wait(0.03)
        end

        StopBoatDrive(false)
    end)
end

-- =========================================================
-- START HUNT
-- =========================================================

local RecoveryState = nil

local function StopHunt()
    Running = false
    SeaHuntState.CombatBatchActive = false
    StopFollow()
    SetState("STOPPED", "Automação parada.")
end

local function StartHunt()
    if Running then
        return
    end

    if not AccountBuyBoat and not OwnerPlayer then
        SetState("ERROR", "Escolha o Owner Boat.")
        return
    end

    Running = true

    if AccountBuyBoat then
        SetState("MAIN_ACCOUNT", "Conta principal ativa.")

        task.spawn(function()
            local okBuy, boatOrErr = BuyBeastHunter()

            if not okBuy then
                SetState("BUY_BOAT_ERROR", tostring(boatOrErr))
                return
            end

            SetState("BEAST_HUNTER_READY", "Beast Hunter encontrado/comprado.")

            local okSeat, seatOrErr = GoToBeastHunterSeat()
            if okSeat then
                SetState("BOAT_SEATED", "Conta principal sentada no VehicleSeat.")
                task.wait(0.5)
                StartBoatDrive()
            else
                SetState("BOAT_SEAT_ERROR", tostring(seatOrErr))
            end
        end)
    else
        SetState("WAITING_BEAST_HUNTER", "Aguardando o Beast Hunter de " .. OwnerPlayer.Name)
        StartFollowBeastHunter()
    end

    task.spawn(function()
        while Running do
            if RecoveryState and RecoveryState.Resetting then
                task.wait(0.25)
                continue
            end
            if EscapeActive then
                task.wait(0.25)
                continue
            end
            if SeaHuntState.CombatBatchActive then
                task.wait(0.25)
                continue
            end

            if AccountBuyBoat and os.clock() >= (SeaHuntState.NextHeartScan or 0) then
                SeaHuntState.NextHeartScan = os.clock() + 0.5
                local heart = SeaHuntState.FindHeart()
                if heart then
                    if SeaHuntState.SampleHeartCapture(heart) then
                        if not SeaHuntState.ReturningHeart and not SeaHuntState.HeartDelivered then
                            SeaHuntState.ReturningHeart = true
                            SeaHuntState.AtSea6 = false
                            SetState("HEART_CAPTURED", "Coração acompanhando o Beast Hunter. Retornando a " .. tostring(SeaConfig.HeartDestination) .. ".")
                            task.spawn(function()
                                local okSeat = GoToBeastHunterSeat()
                                if okSeat and Running then StartBoatDrive() end
                            end)
                        end
                    elseif not SeaHuntState.ReturningHeart then
                        SetState("HEART_NOT_ATTACHED", "FrozenHeart detectado; aguardando confirmacao do arpao.")
                        task.spawn(function() SeaHuntState.TryHarpoonHeart(heart) end)
                    end
                elseif SeaHuntState.HeartModel and not SeaHuntState.HeartCaptured then
                    SeaHuntState.HeartModel = nil
                    SeaHuntState.HeartSample = nil
                    SetState("HEART_CAPTURE_FAILED", "Frozen sumiu sem confirmar captura; retomando a caca.")
                    if not SeaHuntState.Driving then
                        task.spawn(function()
                            local okSeat = GoToBeastHunterSeat()
                            if okSeat and Running then StartBoatDrive() end
                        end)
                    end
                end
            end

            if SeaHuntState.ReturningHeart then
                task.wait(0.25)
                continue
            end

            -- Só eventos marcados entram aqui. Eventos desmarcados são
            -- ignorados e não interrompem barco/follow.
            local eventKey, eventModel = FindSelectedSeaEvent()
            if not eventModel then
                eventKey, eventModel = FindLeviathanCombatTarget()
            end

            if eventModel then
                if not SeaHuntState.CurrentEvent and not SeaHuntState.CombatBatchActive then
                    -- Reserva imediatamente o estado para impedir duas tasks
                    -- de combate e mantém barco/follow pausados durante todo o lote.
                    SeaHuntState.CombatBatchActive = true
                    SeaHuntState.CurrentEvent = eventModel
                    RecoveryState.IgnoreBoatMissingUntil = math.huge
                    StopBoatDrive()
                    StopFollow()

                    SetState(
                        "SEA_EVENT_PRIORITY",
                        SeaEventDisplayName(eventKey) .. " • " .. eventModel:GetFullName()
                    )

                    task.spawn(function()
                        local okCombat, combatError = pcall(function()
                            local nextKey, nextModel = eventKey, eventModel

                            while Running and nextModel do
                                SeaHuntState.CurrentEvent = nextModel
                                SetState(
                                    "SEA_EVENT_PRIORITY",
                                    SeaEventDisplayName(nextKey) .. " • " .. nextModel:GetFullName()
                                )
                                CombatSelectedSeaEvent(nextKey, nextModel)

                                if not Running or (RecoveryState and RecoveryState.Resetting) then
                                    break
                                end

                                -- Só libera o barco depois de cinco segundos
                                -- completos sem nenhum Sea Event selecionado.
                                nextKey, nextModel = nil, nil
                                local clearDeadline = os.clock() + 5
                                SetState("SEA_EVENT_CLEAR_WAIT", "Confirmando área limpa por 5 segundos.")

                                while Running and os.clock() < clearDeadline do
                                    task.wait(0.25)
                                    local foundKey, foundModel = FindSelectedSeaEvent()
                                    if not foundModel then
                                        foundKey, foundModel = FindLeviathanCombatTarget()
                                    end
                                    if foundModel then
                                        nextKey, nextModel = foundKey, foundModel
                                        break
                                    end
                                end
                            end
                        end)

                        SeaHuntState.CurrentEvent = nil
                        SeaHuntState.CombatBatchActive = false

                        -- Sair e voltar ao barco após um evento é normal. Dá
                        -- tempo para streaming/assento reencontrarem a instância
                        -- sem interpretar o término do combate como destruição.
                        RecoveryState.MissingSince = nil
                        RecoveryState.IgnoreBoatMissingUntil = os.clock() + 20

                        if not okCombat then
                            SetState("SEA_EVENT_COMBAT_ERROR", tostring(combatError))
                        end

                        if RecoveryState and RecoveryState.Resetting then
                            return
                        end

                        -- depois de eventos, tenta atualizar o status do Spy.
                        if SpyState.AutoPay and not SpyState.Ready then
                            RefreshSpyStatusFromGui()
                        end

                        -- conta principal retorna ao assento e segue caçada.
                        if Running and AccountBuyBoat then
                            local okSeat = GoToBeastHunterSeat()
                            if okSeat then StartBoatDrive() end
                        elseif Running and OwnerPlayer then
                            StartFollowBeastHunter()
                        end
                    end)
                end
            else
                if SeaHuntState.ResumeAfterEscape then
                    SeaHuntState.ResumeAfterEscape = false
                    SetState("ESCAPE_RESUME", "Retomando automaticamente a caça após recuperar HP.")
                    if AccountBuyBoat then
                        task.spawn(function()
                            local okSeat = GoToBeastHunterSeat()
                            if okSeat and Running and not EscapeActive then StartBoatDrive() end
                        end)
                    elseif OwnerPlayer then
                        StartFollowBeastHunter()
                    end
                    task.wait(0.25)
                    continue
                end

                local levi = FindLeviathan()

                if levi then
                    StopFollow()
                    SetState("LEVIATHAN_FOUND", levi:GetFullName())
                elseif not AccountBuyBoat and OwnerPlayer then
                    SetState("FOLLOW_BEAST_HUNTER", "Acompanhando o Beast Hunter de " .. OwnerPlayer.Name)
                elseif AccountBuyBoat and not SeaHuntState.Driving then
                    if State ~= "SEARCHING_LEVIATHAN" then
                        SetState(
                            "SEARCHING_LEVIATHAN",
                            "Beast Hunter pronto. Próxima etapa: navegação automática Sea 6."
                        )
                    end
                end
            end

            task.wait(0.25)
        end
    end)
end

-- =========================================================
-- GROUP / BOAT RECOVERY
-- =========================================================

RecoveryState = {
    Resetting = false,
    SeenBoat = false,
    KnownBoat = nil,
    MissingSince = nil,
    IgnoreBoatMissingUntil = 0,
    LastDeadOwnerCharacter = nil
}

local RecoveryDeathConnection = nil

local function BindRecoveryDeath(humanoid)
    if RecoveryDeathConnection then
        RecoveryDeathConnection:Disconnect()
        RecoveryDeathConnection = nil
    end

    if not humanoid then return end

    RecoveryDeathConnection = humanoid.Died:Connect(function()
        if Running then
            RecoveryState.Resetting = true
            RecoveryState.SeenBoat = false
            RecoveryState.KnownBoat = nil
            RecoveryState.MissingSince = nil
            SeaHuntState.CurrentEvent = nil
            SeaHuntState.CombatBatchActive = false
            StopBoatDrive(true)
            StopFollow()
            SetState("MAIN_CHARACTER_DIED", "Aguardando respawn para reconstruir o grupo.")
        end
    end)
end

local function ResetLocalForBoatRecovery(reason)
    if not Running or RecoveryState.Resetting then return end

    RecoveryState.Resetting = true
    RecoveryState.SeenBoat = false
    RecoveryState.KnownBoat = nil
    RecoveryState.MissingSince = nil
    SeaHuntState.CurrentEvent = nil
    SeaHuntState.CombatBatchActive = false

    StopBoatDrive(true)
    StopFollow()
    SetState("GROUP_RESET", reason)

    local currentCharacter = Character
    local currentHumanoid = Humanoid

    task.spawn(function()
        task.wait(0.10)
        if currentHumanoid and currentHumanoid.Parent then
            pcall(function() currentHumanoid.Health = 0 end)
        end
        task.wait(0.10)
        if currentCharacter and currentCharacter.Parent then
            pcall(function() currentCharacter:BreakJoints() end)
        end
    end)
end

local function ResumeRoleAfterRespawn()
    task.wait(1.5)
    BindRecoveryDeath(Humanoid)

    if not Running then
        RecoveryState.Resetting = false
        return
    end

    SeaHuntState.CurrentEvent = nil

    if AccountBuyBoat then
        SetState("REBUYING_BEAST_HUNTER", "Comprando Beast Hunter após respawn.")

        local okBuy, boatOrError = BuyBeastHunter(true)
        if not okBuy then
            RecoveryState.Resetting = false
            SetState("REBUY_BOAT_ERROR", tostring(boatOrError))
            return
        end

        RecoveryState.KnownBoat = boatOrError
        RecoveryState.SeenBoat = true

        local okSeat, seatOrError = GoToBeastHunterSeat()
        RecoveryState.Resetting = false

        if okSeat then
            SetState("BOAT_RECOVERED", "Novo Beast Hunter pronto. Retomando Sea 6.")
            StartBoatDrive()
        else
            SetState("RECOVERY_SEAT_ERROR", tostring(seatOrError))
        end
    else
        RecoveryState.Resetting = false
        SetState("FOLLOWER_RECOVERED", "Aguardando o novo Beast Hunter do owner.")
        StartFollowBeastHunter()
    end
end

BindRecoveryDeath(Humanoid)

LocalPlayer.CharacterAdded:Connect(function()
    task.spawn(ResumeRoleAfterRespawn)
end)

task.spawn(function()
    while Gui and Gui.Parent do
        if Running then
            -- Se a instância que já acompanhávamos foi destruída, o reset é
            -- imediato inclusive durante Sea Event.
            if RecoveryState.SeenBoat
            and RecoveryState.KnownBoat
            and not RecoveryState.KnownBoat.Parent
            and os.clock() >= (RecoveryState.IgnoreBoatMissingUntil or 0)
            and not RecoveryState.Resetting then
                ResetLocalForBoatRecovery("Beast Hunter destruído durante a caçada.")
            end

            -- A morte do owner reseta seguidores mesmo durante um combate.
            if not AccountBuyBoat and OwnerPlayer then
                local ownerCharacter = OwnerPlayer.Character
                local ownerHumanoid = ownerCharacter and ownerCharacter:FindFirstChildOfClass("Humanoid")

                if ownerCharacter
                and ownerHumanoid
                and ownerHumanoid.Health <= 0
                and RecoveryState.LastDeadOwnerCharacter ~= ownerCharacter then
                    RecoveryState.LastDeadOwnerCharacter = ownerCharacter
                    ResetLocalForBoatRecovery("Owner do Beast Hunter morreu.")
                end
            end

            -- Durante Sea Event, sair do barco é esperado; só monitoramos
            -- destruição/desaparecimento fora do combate.
            if not SeaHuntState.CurrentEvent and not SeaHuntState.CombatBatchActive then
                local visibleBoat

                if AccountBuyBoat then
                    visibleBoat = GetBeastHunter()
                else
                    visibleBoat = GetOwnerBeastHunter()
                    if not visibleBoat
                    and RecoveryState.KnownBoat
                    and RecoveryState.KnownBoat.Parent then
                        visibleBoat = RecoveryState.KnownBoat
                    end
                end

                if visibleBoat and visibleBoat.Parent then
                    RecoveryState.KnownBoat = visibleBoat
                    RecoveryState.SeenBoat = true
                    RecoveryState.MissingSince = nil
                elseif RecoveryState.SeenBoat
                and os.clock() >= (RecoveryState.IgnoreBoatMissingUntil or 0)
                and not RecoveryState.Resetting then
                    RecoveryState.MissingSince = RecoveryState.MissingSince or os.clock()
                    if os.clock() - RecoveryState.MissingSince >= 1.5 then
                        ResetLocalForBoatRecovery("Beast Hunter destruído/desaparecido.")
                    end
                end
            end
        end

        task.wait(0.25)
    end
end)

