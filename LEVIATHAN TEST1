local function GetCombatFrameworkController()
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local module = playerScripts and playerScripts:FindFirstChild("CombatFramework")
    if not module then return nil end

    local ok, framework = pcall(require, module)
    if not ok then return nil end

    if type(framework) == "table" and framework.activeController then
        return framework.activeController
    end

    -- Alguns executores expõem a tabela interna como upvalue do módulo.
    local getUps = getupvalues or (debug and debug.getupvalues)
    if getUps then
        local okUps, ups = pcall(getUps, framework)
        if okUps and type(ups) == "table" then
            for _, value in pairs(ups) do
                if type(value) == "table" and value.activeController then
                    return value.activeController
                end
            end
        end
    end

    return nil
end

local function AimAtSeaTarget(target)
