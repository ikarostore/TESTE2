local function GetVisibleGuiTexts()
    local results = {}

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local visible = true

            pcall(function()
                visible = obj.Visible
            end)

            local txt = ""

            pcall(function()
                txt = obj.Text
            end)

            if visible and txt and txt ~= "" then
                table.insert(results, {
                    Object = obj,
                    Text = tostring(txt)
                })
            end
        end
    end

    return results
end

local function RefreshSpyStatusFromGui()
    -- Cokka/NoxHub consultam o estado real pelo mesmo remote do Spy. A
    -- consulta "1" não compra nada e evita depender do idioma da interface.
    if os.clock() - (SpyState.LastCheck or 0) >= SpyState.CheckInterval then
        SpyState.LastCheck = os.clock()
        local ok, status = pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local comm = remotes and remotes:FindFirstChild("CommF_")
            return comm and comm:InvokeServer("InfoLeviathan", "1")
        end)
        if ok and status ~= nil then
            local code = tonumber(status)
            local descriptions = {
                [1] = "Spy ainda não sabe nada.",
                [2] = "Spy pediu fragments (etapa 1).",
                [3] = "Spy pediu fragments (etapa 2).",
                [4] = "Spy pediu fragments (etapa final).",
                [5] = "Leviathan está disponível."
            }
            SetSpyStatus(code == 5, descriptions[code] or tostring(status))
            if code == 5 then return true end
        end
    end

    local bestSpyText = nil

    for _, item in ipairs(GetVisibleGuiTexts()) do
        local lowerText = string.lower(item.Text)

        if string.find(lowerText, "leviathan", 1, true)
        or string.find(lowerText, "frozen dimension", 1, true)
        or string.find(lowerText, "bribe", 1, true)
        or string.find(lowerText, "spy", 1, true) then
            bestSpyText = item.Text
        end

        if string.find(lowerText, "find leviathan", 1, true)
        or string.find(lowerText, "leviathan now", 1, true)
        or string.find(lowerText, "frozen dimension", 1, true)
        or (
            string.find(lowerText, "leviathan", 1, true)
            and string.find(lowerText, "ready", 1, true)
        ) then
            SetSpyStatus(true, item.Text)
            return true
        end
    end

    if bestSpyText then
        SetSpyStatus(false, bestSpyText)
    end

    return SpyState.Ready
end

local function FindNearestInteraction(position, radius)
    radius = radius or 100

    local bestPrompt = nil
    local bestClick = nil
    local bestPromptDist = math.huge
    local bestClickDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parentPart = obj.Parent
            if parentPart and parentPart:IsA("BasePart") then
                local d = (parentPart.Position - position).Magnitude
                if d < radius and d < bestPromptDist then
                    bestPromptDist = d
                    bestPrompt = obj
                end
            end
        elseif obj:IsA("ClickDetector") then
            local parentPart = obj.Parent
            if parentPart and parentPart:IsA("BasePart") then
                local d = (parentPart.Position - position).Magnitude
                if d < radius and d < bestClickDist then
                    bestClickDist = d
                    bestClick = obj
                end
            end
        end
    end

    return bestPrompt, bestClick
end

local function ActivateSpyDialogueButtons()
    local clickedAny = false

    for _, item in ipairs(GetVisibleGuiTexts()) do
        if item.Object:IsA("TextButton") then
            local l = string.lower(item.Text)

            if string.find(l, "bribe", 1, true)
            or string.find(l, "pay", 1, true)
            or string.find(l, "yes", 1, true)
            or string.find(l, "sure", 1, true)
            or string.find(l, "leviathan", 1, true)
            or string.find(l, "clue", 1, true)
            or string.find(l, "information", 1, true)
            or string.find(l, "$", 1, true) then
                local ok = pcall(function()
                    item.Object:Activate()
                end)

                if ok then
                    clickedAny = true
                    task.wait(0.35)
                    RefreshSpyStatusFromGui()

                    if SpyState.Ready then
                        break
                    end
                end
            end
        end
    end

    return clickedAny
end

local function TryInteractSpy()
    local spyPos = SeaNPCPositions.Spy.Position
    local prompt, clickDetector = FindNearestInteraction(spyPos, 110)
    local interacted = false

    if prompt and type(fireproximityprompt) == "function" then
        interacted = pcall(function()
            fireproximityprompt(prompt)
        end)
    end

    if not interacted
    and clickDetector
    and type(fireclickdetector) == "function" then
        interacted = pcall(function()
            fireclickdetector(clickDetector)
        end)
    end

    -- fallback: tenta E perto do NPC
    if not interacted and SeaVIM then
        interacted = pcall(function()
            SeaVIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.08)
            SeaVIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end

    task.wait(0.8)

    RefreshSpyStatusFromGui()
    ActivateSpyDialogueButtons()

    task.wait(0.5)
    RefreshSpyStatusFromGui()

    return interacted
end

local function VisitSpyAndReturn()
    if SpyState.Visiting
    or not Running
    or not AccountBuyBoat
    or SpyState.Ready then
        return false
    end

    local now = os.clock()

    if now - SpyState.LastVisit < SpyState.VisitCooldown then
        return false
    end

    SpyState.Visiting = true
    SpyState.LastVisit = now

    -- Todos os hubs de referência pagam o Spy diretamente com a ação "2".
    -- Se o servidor responder, não teleporta a conta para Tiki nem pausa o
    -- barco; o monitor repetirá no próximo cooldown até o status chegar a 5.
    local remoteAccepted, paymentResult = pcall(function()
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
        local comm = remotes and remotes:WaitForChild("CommF_", 5)
        return comm and comm:InvokeServer("InfoLeviathan", "2")
    end)
    -- O Banana usa a ação direta sem depender do retorno. CommF_ pode
    -- devolver nil mesmo quando o pagamento foi processado pelo servidor.
    if remoteAccepted then
        SpyState.LastCheck = 0
        task.wait(0.25)
        RefreshSpyStatusFromGui()
        SpyState.Visiting = false
        SetState(
            SpyState.Ready and "SPY_READY" or "SPY_REMOTE_PAID",
            SpyState.Ready and SpyState.LastText
                or paymentResult ~= nil and tostring(paymentResult)
                or "Pagamento enviado; aguardando novo status do Spy."
        )
        return SpyState.Ready
    end

    local boatSeat = GetBeastHunterMainSeat()

    SetState("GOING_TO_SPY", "Pausando o barco e indo verificar/pagar o Spy.")
    StopBoatDrive(false)

    if Humanoid and Humanoid.Sit then
        Humanoid.Sit = false
        task.wait(0.2)
    end

    local marker = Instance.new("Part")
    marker.Name = "IKARO_SpyVisitTarget"
    marker.Anchored = true
    marker.CanCollide = false
    marker.Transparency = 1
    marker.CFrame = SeaNPCPositions.Spy
    marker.Parent = workspace

    local arrived = FlyToPart(marker, 12)
    marker:Destroy()

    if arrived then
        SetState("SPY_INTERACTION", "Tentando abrir diálogo e pagar.")
        TryInteractSpy()
    else
        SetState("SPY_VISIT_ERROR", "Não conseguiu chegar ao Spy.")
    end

    task.wait(0.5)
    RefreshSpyStatusFromGui()

    -- volta ao Beast Hunter se ele ainda existir
    boatSeat = GetBeastHunterMainSeat()

    if Running and boatSeat then
        SetState("RETURNING_TO_BOAT", "Voltando ao Beast Hunter.")
        local okSeat = GoToBeastHunterSeat()

        if okSeat then
            task.wait(0.3)
            StartBoatDrive()
        end
    end

    SpyState.Visiting = false
    return SpyState.Ready
end

