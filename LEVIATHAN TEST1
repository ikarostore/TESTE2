-- Rotina preservada do Banana para o Terrorshark. Ela não usa o preparo de
-- EquipEvent do fallback comum: equipa, reúne Heads em até 60 studs e envia o
-- par RegisterAttack/RegisterHit imediatamente a cada ciclo.
local function BMFastAttack(target, eventModel, eventKey)
    if not target then return false end

    EnsureSeaCombatHaki()
    AimAtSeaTarget(target)

    local tool = EquipSeaCombatType("Melee")
    if not tool then return false end

    -- Sharks/Piranhas exigem o protocolo moderno completo. O formato apenas
    -- Head + tabela vazia executava sem erro, mas nao reduzia HP no servidor.
    local registerAttack, registerHit = GetBMModernRemotes()
    if registerAttack and registerHit
    and (eventKey == "Shark" or eventKey == "Piranha" or eventKey == "Terrorshark") then
        local now = os.clock()

        -- O trace registra EquipEvent uma única vez e o primeiro hit somente
        -- cerca de 1.8 s depois. Reequipar em todo frame reiniciava esse estado
        -- no servidor e deixava o personagem perfeitamente posicionado, mas
        -- incapaz de causar dano.
        if SeaHuntState.BMPreparedEvent ~= eventModel
        or SeaHuntState.BMPreparedTool ~= tool then
            SeaHuntState.BMPreparedEvent = eventModel
            SeaHuntState.BMPreparedTool = tool
            SeaHuntState.BMEquipReadyAt = now + 1.75
            SeaHuntState.NextDirectSeaHit = SeaHuntState.BMEquipReadyAt

            pcall(function()
                local equipEvent = tool:FindFirstChild("EquipEvent")
                if equipEvent then equipEvent:FireServer(true) end
            end)
            return true
        end

        if now < (SeaHuntState.BMEquipReadyAt or 0) then
            return true
        end

        if now >= (SeaHuntState.NextDirectSeaHit or 0) then
            SeaHuntState.NextDirectSeaHit = now + 0.267

            local candidates = {}
            local enemies = workspace:FindFirstChild("Enemies")
            for _, model in ipairs(enemies and enemies:GetChildren() or {}) do
                local lower = string.lower(model.Name)
                local sameType = eventKey == "Piranha"
                    and string.find(lower, "piranha", 1, true)
                    or eventKey == "Shark"
                    and string.find(lower, "shark", 1, true)
                    and not string.find(lower, "terror", 1, true)
                    or eventKey == "Terrorshark"
                    and string.find(lower, "terrorshark", 1, true)
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                local hitPart = model:FindFirstChild("HumanoidRootPart", true)
                    or model:FindFirstChild("Head", true)
                    or model:FindFirstChild("Piranha Body", true)
                    or model.PrimaryPart
                if sameType and hitPart and hitPart:IsA("BasePart")
                and (not humanoid or humanoid.Health > 0)
                and HRP and (hitPart.Position - HRP.Position).Magnitude <= 60 then
                    table.insert(candidates, {model, hitPart})
                end
            end

            if #candidates == 0 then
                local fallbackPart = eventModel and (
                    eventModel:FindFirstChild("HumanoidRootPart", true)
                    or eventModel:FindFirstChild("Head", true)
                    or eventModel:FindFirstChildWhichIsA("BasePart", true)
                )
                if fallbackPart and fallbackPart:IsA("BasePart") then
                    table.insert(candidates, {eventModel, fallbackPart})
                end
            end
            if #candidates == 0 then return true end

            -- Pacote exato do Banana: um RegisterAttack e um RegisterHit com
            -- todos os alvos próximos. Assim grupos de Piranhas/Sharks recebem
            -- dano juntos, sem quatro loops de ataque concorrentes.
            return pcall(function()
                registerAttack:FireServer(1e-9)
                registerHit:FireServer(candidates[1][2], candidates)
            end)
        end
        return true
    end

    -- Pacote moderno comprovado no teste V2.4 para NPCs comuns.
    if registerAttack and registerHit then
        local targets = {}
        local firstHitPart = nil
        local enemies = workspace:FindFirstChild("Enemies")

        local function addTarget(model)
            if not model or not model.Parent then return end
            local hum = model:FindFirstChildOfClass("Humanoid")
            local part = model:FindFirstChild("Head")
                or model:FindFirstChild("HumanoidRootPart")
                or model.PrimaryPart
                or model:FindFirstChildWhichIsA("BasePart", true)
            if hum and hum.Health > 0 and part and HRP
            and (part.Position - HRP.Position).Magnitude <= 120 then
                table.insert(targets, {model, part})
                firstHitPart = firstHitPart or part
            end
        end

        if eventKey == "Shark" or eventKey == "Piranha" then
            for _, model in ipairs(enemies and enemies:GetChildren() or {}) do
                local lower = string.lower(model.Name)
                local sameType = eventKey == "Piranha"
                    and string.find(lower, "piranha", 1, true)
                    or eventKey == "Shark"
                    and string.find(lower, "shark", 1, true)
                    and not string.find(lower, "terror", 1, true)
                if sameType then addTarget(model) end
            end
        else
            addTarget(eventModel or target:FindFirstAncestorOfClass("Model"))
        end

        if firstHitPart and #targets > 0 then
            local attackOk = pcall(function()
                registerAttack:FireServer(0)
            end)
            local hitOk = pcall(function()
                registerHit:FireServer(firstHitPart, targets)
            end)
            return attackOk and hitOk
        end
    end

    -- Fallback legado para versões antigas do jogo.
    local controller = GetCombatFrameworkController()
    if not BMVirtualUser then
        return false
    end

    local attacked = false
    pcall(function()
        -- Mesmo método do script de referência: mantém o controller pronto e
        -- segura Button1Down continuamente, sem chamar controller:attack().
        -- Alguns executores nao expoem activeController. Nesse caso o input
        -- continua sendo enviado em vez de cancelar completamente o ataque.
        if controller then
            controller.attacking = false
            controller.blocking = false
            controller.timeToNextAttack = tick() - 1
            controller.timeToNextBlock = 0
            controller.increment = 3
            controller.hitboxMagnitude = 120
            controller.equipped = true
        end

        local stun = Character and Character:FindFirstChild("Stun")
        if stun then
            pcall(function() stun.Value = 0 end)
        end
        Humanoid.Sit = false

        BMVirtualUser:CaptureController()
        BMVirtualUser:Button1Down(Vector2.new(1280, 672))

        -- Fallback estável usado antes da regressão dos ships.
        if not controller then
            local env = getgenv and getgenv() or _G
            local now = os.clock()
            if now >= (env.IKARO_NEXT_RIG_ATTACK or 0) then
                env.IKARO_NEXT_RIG_ATTACK = now + 0.18
                local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent")
                if rigEvent then
                    rigEvent:FireServer("weaponChange", tool.Name)
                    rigEvent:FireServer("hit", {target}, 1, "")
                end
            end
        end

        if BMCameraShaker and type(BMCameraShaker.Stop) == "function" then
            BMCameraShaker:Stop()
        end
        attacked = true
    end)

    return attacked
end

local function UseConfiguredSeaSkills(liveTarget)
    if not SeaVIM then return false end

    local used = false
    for _, category in ipairs({"Melee", "Sword", "Gun", "Fruit"}) do
        local tool = EquipSeaCombatType(category)
        local cfg = CombatConfig[category]
        local order = category == "Fruit"
            and {"Z","X","C","V","F"}
            or category == "Melee"
            and {"Z","X","C"}
            or {"Z","X"}

        if tool and cfg and cfg.Enabled ~= false then
            task.wait(0.10)
            for _, keyName in ipairs(order) do
                if cfg.Selected[keyName] then
                    local key = Enum.KeyCode[keyName]
                    if key then
                        pcall(function()
                            -- Ships continuam se deslocando durante troca de
                            -- arma/hold. Recalcula a mira para cada habilidade.
                            if liveTarget and liveTarget.Parent then
                                AimAtSeaTarget(liveTarget)
                                task.wait(0.04)
                            end
                            SeaVIM:SendKeyEvent(true, key, false, game)
                            task.wait(cfg.Hold[keyName] or 0.5)
                            SeaVIM:SendKeyEvent(false, key, false, game)
                            used = true
                        end)
                    end
                end
            end
        end
    end

    return used
end

