local function FindLeviathan()
    if SeaHuntState.CachedLeviathan and SeaHuntState.CachedLeviathan.Parent then
        return SeaHuntState.CachedLeviathan
    end
    if os.clock() < SeaHuntState.NextLeviathanScan then return nil end
    SeaHuntState.NextLeviathanScan = os.clock() + 3

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local n = string.lower(obj.Name)
            if string.find(n, "leviathan", 1, true) then
                SeaHuntState.CachedLeviathan = obj
                return obj
            end
        end
    end
    return nil
end

-- Auto Dodge: usa dash lateral sem mover mobs ou barcos. O foco de combate
-- reposiciona o personagem logo depois de cada esquiva.
task.spawn(function()
    local dodgeRight = true
    while Gui and Gui.Parent do
        if SeaConfig.AutoDodgeEnabled and not EscapeActive
        and Running and HRP and Humanoid and Humanoid.Health > 0 then
            local threat = SeaHuntState.CurrentEvent
            local threatName = threat and string.lower(threat.Name) or ""
            -- Dash Q conflita com o hover do Terror Shark. Para ele usamos
            -- altura fixa e Panic HP; a esquiva permanece nos outros bosses.
            local dangerous = string.find(threatName, "sea beast", 1, true)
                or string.find(threatName, "seabeast", 1, true)

            if not dangerous then
                threat = FindLeviathan()
                dangerous = threat ~= nil
            end

            local threatPart = threat and GetModelTargetPart(threat)
            if dangerous and threatPart
            and (threatPart.Position - HRP.Position).Magnitude <= 900
            and SeaVIM then
                local directionKey = dodgeRight and Enum.KeyCode.D or Enum.KeyCode.A
                dodgeRight = not dodgeRight
                pcall(function()
                    SeaVIM:SendKeyEvent(true, directionKey, false, game)
                    SeaVIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                    task.wait(0.10)
                    SeaVIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                    SeaVIM:SendKeyEvent(false, directionKey, false, game)
                end)
                task.wait(1.05)
            else
                task.wait(0.20)
            end
        else
            task.wait(0.25)
        end
    end
end)


