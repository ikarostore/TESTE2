local function BuyBeastHunter()
    local existing = GetBeastHunter()
    if existing then return true, existing end

    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    local comm = remotes and remotes:FindFirstChild("CommF_")
    if not comm then return false, "CommF_ não encontrado" end

    SetState("BUYING_BEAST_HUNTER", "Tentando comprar Beast Hunter...")

    local ok, result = pcall(function()
        return comm:InvokeServer("BuyBoat", "Beast Hunter")
    end)

    if not ok then return false, tostring(result) end

    local deadline = os.clock() + 8
    repeat
        task.wait(0.2)
        existing = GetBeastHunter()
    until existing or os.clock() >= deadline

    if existing then return true, existing end
    return false, "A chamada ocorreu, mas o barco não apareceu."
end

local function FlyToPart(part, stopDistance, ignoreRunning)
    if not part or not HRP or not Humanoid then
        return false
    end

    stopDistance = stopDistance or 7

    local oldPlatformStand = Humanoid.PlatformStand
    local collisionCache = {}

    local function SetNoClip()
        if not Character then return end

        for _, obj in ipairs(Character:GetDescendants()) do
            if obj:IsA("BasePart") then
                if collisionCache[obj] == nil then
                    collisionCache[obj] = obj.CanCollide
                end
                obj.CanCollide = false
            end
        end
    end

    local function RestoreCollision()
        for obj, oldValue in pairs(collisionCache) do
            if obj and obj.Parent then
                pcall(function()
                    obj.CanCollide = oldValue
                end)
            end
        end
    end

    SetNoClip()

    local bv = Instance.new("BodyVelocity")
    bv.Name = "IKAROFlyToTarget"
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.P = 12000
    bv.Parent = HRP

    local bg = Instance.new("BodyGyro")
    bg.Name = "IKAROFlyToTargetGyro"
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 14000
    bg.D = 900
    bg.Parent = HRP

    Humanoid.PlatformStand = true

    local deadline = os.clock() + 30
    local nextNoclipRefresh = 0

    while (ignoreRunning or Running) and part and part.Parent and HRP and HRP.Parent and os.clock() < deadline do
        local now = os.clock()

        if now >= nextNoclipRefresh then
            SetNoClip()
            nextNoclipRefresh = now + 0.15
        end

        local delta = part.Position - HRP.Position
        local dist = delta.Magnitude

        if dist <= stopDistance then
            break
        end

        local dir = delta.Unit
        local speed

        if dist > 1000 then
            speed = 300
        elseif dist > 300 then
            speed = 250
        elseif dist > 80 then
            speed = 190
        else
            speed = 120
        end

        bv.Velocity = dir * speed
        bg.CFrame = CFrame.new(HRP.Position, HRP.Position + dir)

        task.wait()
    end

    pcall(function() bv:Destroy() end)
    pcall(function() bg:Destroy() end)

    Humanoid.PlatformStand = oldPlatformStand
    RestoreCollision()

    return part
        and part.Parent
        and HRP
        and HRP.Parent
        and (part.Position - HRP.Position).Magnitude <= stopDistance + 5
end

local function GoToBeastHunterSeat()
    local seat = GetBeastHunterMainSeat()
    if not seat then
        return false, "VehicleSeat principal não encontrado"
    end

    SetState("GOING_TO_BOAT", "Voando com noclip até o VehicleSeat principal.")

    local arrived = FlyToPart(seat, 4)
    if not arrived then
        return false, "Não chegou próximo ao VehicleSeat"
    end

    -- Mantém noclip por alguns instantes para atravessar a geometria do barco.
    local collisionCache = {}

    if Character then
        for _, obj in ipairs(Character:GetDescendants()) do
            if obj:IsA("BasePart") then
                collisionCache[obj] = obj.CanCollide
                obj.CanCollide = false
            end
        end
    end

    local seated = false
    local deadline = os.clock() + 3

    repeat
        pcall(function()
            -- aproximação final muito curta, apenas já dentro do barco
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            seat:Sit(Humanoid)
        end)

        task.wait(0.15)
        seated = Humanoid.Sit == true and Humanoid.SeatPart == seat
    until seated or os.clock() >= deadline

    for obj, oldValue in pairs(collisionCache) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = oldValue
            end)
        end
    end

    if seated then
        return true, seat
    end

    return false, "Chegou ao assento, mas o Humanoid não ficou sentado."
end

