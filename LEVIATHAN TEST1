-- LEVIATHAN DETECTOR
-- =========================================================

local function FindLeviathan()
    local best = nil

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local lower = string.lower(obj.Name)

            if string.find(lower, "leviathan", 1, true) then
                best = obj
                break
            end
        end
    end

    return best
end

local function GetTargetPart(model)
    if not model then
        return nil
    end

    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

-- =========================================================
-- FOLLOW OWNER
-- =========================================================

local FollowConnection = nil

local function StopFollow()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end
end

local function StartFollowOwner()
    StopFollow()

    if not OwnerPlayer or OwnerPlayer == LocalPlayer then
        return
    end

    FollowConnection = RunService.Heartbeat:Connect(function()
        if not Running or State == "COMBAT" then
            return
        end

        if not HRP or not HRP.Parent then
            return
        end

        local ownerCharacter = OwnerPlayer.Character
        local ownerHRP = ownerCharacter and ownerCharacter:FindFirstChild("HumanoidRootPart")

        if not ownerHRP then
            return
        end

        local targetPosition =
            ownerHRP.Position
            - ownerHRP.CFrame.LookVector * FollowDistance
            + Vector3.new(0, FollowHeight, 0)

        local distance = (HRP.Position - targetPosition).Magnitude

        -- Teste inicial:
        -- aproxima suavemente usando velocity, sem CFrame contínuo.
        if distance > 15 then
            local direction = (targetPosition - HRP.Position).Unit
            HRP.AssemblyLinearVelocity = direction * math.min(180, distance * 4)
        else
            HRP.AssemblyLinearVelocity = ownerHRP.AssemblyLinearVelocity
        end
    end)
end

