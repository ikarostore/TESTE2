-- Auto Marines v4.2: reproduz o fluxo dos hubs de referência. Character
-- pode existir atrás da tela; somente LocalPlayer.Team confirma a escolha.
task.spawn(function()
    local teamVIM = nil
    pcall(function() teamVIM = game:GetService("VirtualInputManager") end)
    local deadline = os.clock() + 90
    local nextAttempt = 0

    while Gui and Gui.Parent and os.clock() < deadline do
        if LocalPlayer.Team then
            return
        end

        local mainGui = PlayerGui:FindFirstChild("Main")
        local chooseTeam = mainGui and mainGui:FindFirstChild("ChooseTeam", true)
        local chooseVisible = chooseTeam
            and (not chooseTeam:IsA("GuiObject") or chooseTeam.Visible)

        if chooseVisible and os.clock() >= nextAttempt then
            nextAttempt = os.clock() + 1
            local marineButton = nil
            pcall(function()
                marineButton = chooseTeam.Container.Marines.Frame.ViewportFrame.TextButton
            end)

            -- ThunderZ: executa os callbacks reais do Activated do botão.
            local connectionCalled = false
            if marineButton and type(getconnections) == "function" then
                pcall(function()
                    for _, connection in pairs(getconnections(marineButton.Activated)) do
                        local callback = connection.Function
                        if type(callback) == "function" then
                            connectionCalled = true
                            pcall(callback)
                        end
                    end
                end)
            end

            if marineButton and not connectionCalled and type(firesignal) == "function" then
                pcall(function() firesignal(marineButton.Activated) end)
            end

            if marineButton and not connectionCalled and teamVIM then
                pcall(function()
                    local center = marineButton.AbsolutePosition + marineButton.AbsoluteSize / 2
                    teamVIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
                    task.wait(0.08)
                    teamVIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
                end)
            end

            -- MeyyHub/Matsune: repete SetTeam até LocalPlayer.Team existir.
            pcall(function()
                ReplicatedStorage:WaitForChild("Remotes")
                    :WaitForChild("CommF_")
                    :InvokeServer("SetTeam", "Marines")
            end)
        end

        task.wait(0.1)
    end
end)

