repeat task.wait() until game:IsLoaded() and game:GetService("Players").LocalPlayer

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VIM = game:GetService("VirtualInputManager")
local Player = Players.LocalPlayer

local Config = {
    Running = false,
    AutoBoat = true,
    BoatSpeed = 330,
    FastDelay = 0.03,
    BringMode = "Normal",
    SpinPosition = true,
    Targets = {
        Terrorshark = true, Shark = true, Piranha = true,
        PirateGrandBrigade = true, PirateBrigade = true,
        FishBoat = true, SeaBeast = true
    }
}

local BringDistances = {Low = 150, Normal = 250, High = 800}
local Order = {"Terrorshark", "SeaBeast", "PirateGrandBrigade", "PirateBrigade", "FishBoat", "Shark", "Piranha"}
local Ships = {PirateGrandBrigade = true, PirateBrigade = true, FishBoat = true}
local Creatures = {Terrorshark = true, Shark = true, Piranha = true}
local Sea6Position = Vector3.new(-44718.37109375, 70, 150.4124755859375)
local Sea6Direction = Vector3.new(-0.9999496936798096, 0, -0.010028315708041191)
local ActiveBoat, BoatAttachment, BoatVelocity, BoatGyro = nil, nil, nil, nil
local BoatCollisionCache, ObstacleCollisionCache = {}, {}
local HadActiveBoat, Recovering = false, false
local Status
local Offsets = {
    CFrame.new(0, 40, 0), CFrame.new(-40, 40, 0), CFrame.new(40, 40, 0),
    CFrame.new(0, 40, 40), CFrame.new(0, 40, -40)
}

local function characterParts()
    local character = Player.Character
    return character,
        character and character:FindFirstChildOfClass("Humanoid"),
        character and character:FindFirstChild("HumanoidRootPart")
end

local function autoHaki()
    local character = Player.Character
    if character and not character:FindFirstChild("HasBuso") then
        pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso") end)
    end
end

local function equipMelee()
    local character, humanoid = characterParts()
    if not character or not humanoid then return end
    for _, container in ipairs({character, Player:FindFirstChild("Backpack")}) do
        for _, tool in ipairs(container and container:GetChildren() or {}) do
            if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool:GetAttribute("WeaponType") == "Melee") then
                if tool.Parent ~= character then humanoid:EquipTool(tool) end
                return tool
            end
        end
    end
end

local function alive(model)
    if not model or not model.Parent then return false end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then return humanoid.Health > 0 end
    local health = model:FindFirstChild("Health", true)
    return not health or health.Value > 0
end

local function classify(model)
    local lower = string.lower(model.Name)
    if string.find(lower, "terrorshark", 1, true) then return "Terrorshark" end
    if string.find(lower, "sea beast", 1, true) or string.find(lower, "seabeast", 1, true) then return "SeaBeast" end
    if string.find(lower, "pirategrandbrigade", 1, true) or string.find(lower, "pirate grand brigade", 1, true) then return "PirateGrandBrigade" end
    if string.find(lower, "piratebrigade", 1, true) or string.find(lower, "pirate brigade", 1, true) then return "PirateBrigade" end
    if string.find(lower, "fishboat", 1, true) or string.find(lower, "fish boat", 1, true) then return "FishBoat" end
    if lower == "shark" then return "Shark" end
    if lower == "piranha" then return "Piranha" end
end

local function findTarget()
    local containers = {workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("SeaBeasts")}
    for _, wanted in ipairs(Order) do
        if Config.Targets[wanted] then
            for _, container in ipairs(containers) do
                for _, model in ipairs(container and container:GetChildren() or {}) do
                    if model:IsA("Model") and classify(model) == wanted and alive(model) then return wanted, model end
                end
            end
        end
    end
end

local function boatOwnerMatches(boat)
    local owner = boat:FindFirstChild("BoatOwner", true) or boat:FindFirstChild("Owner", true)
    if not owner then return true end
    local value = owner.Value
    return value == Player or value == Player.Name or value == Player.UserId
end

local function findMyBoat()
    local boats = workspace:FindFirstChild("Boats")
    if not boats then return nil end
    for _, boat in ipairs(boats:GetChildren()) do
        if (boat.Name == "Beast Hunter" or boat.Name == "PirateBrigade") and boatOwnerMatches(boat) then
            return boat
        end
    end
end

local function restoreCollisions()
    for part, oldValue in pairs(BoatCollisionCache) do
        if part and part.Parent then pcall(function() part.CanCollide = oldValue end) end
    end
    for part, oldValue in pairs(ObstacleCollisionCache) do
        if part and part.Parent then pcall(function() part.CanCollide = oldValue end) end
    end
    BoatCollisionCache, ObstacleCollisionCache = {}, {}
end

local function stopBoat(restore)
    if BoatVelocity then pcall(function() BoatVelocity:Destroy() end) end
    if BoatGyro then pcall(function() BoatGyro:Destroy() end) end
    if BoatAttachment then pcall(function() BoatAttachment:Destroy() end) end
    BoatVelocity, BoatGyro, BoatAttachment = nil, nil, nil
    if ActiveBoat then
        local seat = ActiveBoat:FindFirstChild("VehicleSeat", true)
        local drive = seat and (seat.AssemblyRootPart or seat)
        if drive then
            drive.AssemblyLinearVelocity = Vector3.zero
            drive.AssemblyAngularVelocity = Vector3.zero
        end
    end
    if restore then restoreCollisions() end
end

local function boatAlive(boat)
    if not boat or not boat.Parent then return false end
    local seat = boat:FindFirstChild("VehicleSeat", true)
    if not seat then return false end
    local health = boat:FindFirstChild("Health", true)
    if health and (health:IsA("NumberValue") or health:IsA("IntValue")) and health.Value <= 0 then return false end
    return true
end

local function flyCharacter(target)
    local character, humanoid, root = characterParts()
    if not character or not humanoid or not root then return false end
    local distance = (root.Position - target.Position).Magnitude
    if distance <= 8 then return true end
    humanoid.PlatformStand, humanoid.AutoRotate = true, false
    root.Anchored = true
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    local tween = TweenService:Create(root, TweenInfo.new(distance / 400, Enum.EasingStyle.Linear), {CFrame = target})
    tween:Play()
    local state = tween.Completed:Wait()
    root.Anchored = false
    root.AssemblyLinearVelocity = Vector3.zero
    humanoid.PlatformStand, humanoid.AutoRotate = false, true
    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    return state == Enum.PlaybackState.Completed
end

local function applyBoatNoclip(boat, drive, direction)
    for _, part in ipairs(boat:GetDescendants()) do
        if part:IsA("BasePart") then
            if BoatCollisionCache[part] == nil then BoatCollisionCache[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = Player.Character and {boat, Player.Character} or {boat}
    params.MaxParts = 0
    local center = drive.Position + direction * 55
    local scan = CFrame.lookAt(center, center + direction)
    local seen = {}
    for _, part in ipairs(workspace:GetPartBoundsInBox(scan, Vector3.new(150, 150, 190), params)) do
        if part:IsA("BasePart") and part.Anchored
        and (part.CanCollide or ObstacleCollisionCache[part] ~= nil)
        and not part:IsDescendantOf(boat) then
            if ObstacleCollisionCache[part] == nil then ObstacleCollisionCache[part] = part.CanCollide end
            seen[part] = true
            part.CanCollide = false
        end
    end
    for part, oldValue in pairs(ObstacleCollisionCache) do
        if not part or not part.Parent then
            ObstacleCollisionCache[part] = nil
        elseif not seen[part] then
            pcall(function() part.CanCollide = oldValue end)
            ObstacleCollisionCache[part] = nil
        end
    end
end

local function ensureBoat()
    local boat = findMyBoat()
    if boat and not boatAlive(boat) then boat = nil end
    if not boat then
        local _, _, root = characterParts()
        local dealer = CFrame.new(-16917.154296875, 7.757596015930176, 511.8203125)
        if root and (root.Position - dealer.Position).Magnitude > 80 then
            flyCharacter(dealer)
            return nil
        end
        pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat", "Beast Hunter") end)
        task.wait(1)
        boat = findMyBoat()
    end
    if not boat then
        pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat", "PirateBrigade") end)
        task.wait(1)
        boat = findMyBoat()
    end
    if not boat then return nil end
    ActiveBoat = boat
    local seat = boat:FindFirstChild("VehicleSeat", true)
    local drive = seat and (seat.AssemblyRootPart or seat)
    if not seat or not drive then return nil end
    local _, humanoid, root = characterParts()
    if humanoid and root and humanoid.SeatPart ~= seat then
        flyCharacter(seat.CFrame * CFrame.new(0, 3, 0))
        pcall(function() seat:Sit(humanoid) end)
        task.wait(0.3)
    end
    if not humanoid or humanoid.SeatPart ~= seat then return nil end
    HadActiveBoat = true
    if not BoatAttachment or BoatAttachment.Parent ~= drive then
        stopBoat(false)
        BoatAttachment = Instance.new("Attachment", drive)
        BoatAttachment.Name = "BananaSeaFlightAttachment"
        BoatVelocity = Instance.new("LinearVelocity", drive)
        BoatVelocity.Attachment0 = BoatAttachment
        BoatVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        BoatVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        BoatVelocity.MaxForce = math.huge
        BoatGyro = Instance.new("AlignOrientation", drive)
        BoatGyro.Attachment0 = BoatAttachment
        BoatGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
        BoatGyro.Responsiveness = 35
        BoatGyro.MaxTorque = math.huge
    end
    return boat, drive
end

local function recoverAfterLoss(reason, resetCharacter)
    if Recovering or not Config.Running then return end
    Recovering = true
    HadActiveBoat = false
    stopBoat(true)
    ActiveBoat = nil
    if Status then Status.Text = reason .. " | resetando e retomando..." end
    task.spawn(function()
        local oldCharacter = Player.Character
        local humanoid = oldCharacter and oldCharacter:FindFirstChildOfClass("Humanoid")
        if resetCharacter and humanoid and humanoid.Health > 0 then
            pcall(function() oldCharacter:BreakJoints() end)
        end
        repeat
            task.wait(0.5)
            local character = Player.Character
            local newHumanoid = character and character:FindFirstChildOfClass("Humanoid")
            if character and character ~= oldCharacter and character:FindFirstChild("HumanoidRootPart")
            and newHumanoid and newHumanoid.Health > 0 then break end
        until not Config.Running
        Recovering = false
    end)
end

local function sailSea6()
    local boat, drive = ensureBoat()
    if not boat or not drive then return false end
    local flatDelta = Vector3.new(Sea6Position.X - drive.Position.X, 0, Sea6Position.Z - drive.Position.Z)
    local direction = flatDelta.Magnitude > 1000 and flatDelta.Unit or Sea6Direction
    applyBoatNoclip(boat, drive, direction)
    pcall(function() sethiddenproperty(Player, "SimulationRadius", math.huge) end)
    local vertical = math.clamp((70 - drive.Position.Y) * 7, -140, 140)
    BoatVelocity.VectorVelocity = direction * Config.BoatSpeed + Vector3.new(0, vertical, 0)
    BoatGyro.CFrame = CFrame.lookAt(Vector3.zero, direction, Vector3.yAxis)
    return true
end

local function attackNoCooldown()
    local character, _, root = characterParts()
    local enemies = workspace:FindFirstChild("Enemies")
    if not character or not root or not enemies or not character:FindFirstChildOfClass("Tool") then return end
    local targets, lastPart = {}, nil
    for _, model in ipairs(enemies:GetChildren()) do
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
        if model ~= character and humanoid and humanoid.Health > 0 and head
        and (head.Position - root.Position).Magnitude <= 60 then
            targets[#targets + 1] = {model, head}
            lastPart = head
        end
    end
    if not lastPart then return end
    pcall(function()
        local net = ReplicatedStorage.Modules.Net
        net["RE/RegisterAttack"]:FireServer(1e-9)
        net["RE/RegisterHit"]:FireServer(lastPart, targets)
    end)
end

local function bringGroup(target)
    local targetRoot = target:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not targetRoot or not enemies then return end
    local distance = BringDistances[Config.BringMode] or 250
    for _, model in ipairs(enemies:GetChildren()) do
        local root = model:FindFirstChild("HumanoidRootPart")
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if model ~= target and model.Name == target.Name and root and humanoid and humanoid.Health > 0
        and (root.Position - targetRoot.Position).Magnitude <= distance then
            root.CFrame = targetRoot.CFrame
            root.Size = Vector3.new(1, 1, 1)
            root.CanCollide = false
            humanoid.WalkSpeed = 0
        end
    end
end

local function useAllSkills(targetPart)
    local character, humanoid = characterParts()
    if not character or not humanoid or not targetPart then return end
    for _, container in ipairs({Player:FindFirstChild("Backpack"), character}) do
        for _, tool in ipairs(container and container:GetChildren() or {}) do
            if tool:IsA("Tool") then
                if tool.Parent ~= character then humanoid:EquipTool(tool) end
                for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
                    workspace.CurrentCamera.CFrame = CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, targetPart.Position)
                    VIM:SendKeyEvent(true, key, false, game)
                    task.wait(0.08)
                    VIM:SendKeyEvent(false, key, false, game)
                end
            end
        end
    end
end

local function combat(key, model)
    stopBoat()
    while Config.Running and alive(model) do
        local character, humanoid, root = characterParts()
        local targetRoot = model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("Engine", true) or model.PrimaryPart
        if not character or not humanoid or not root or not targetRoot then break end
        humanoid.Sit = false
        autoHaki()
        Status.Text = "Alvo: " .. key .. " | HP: " .. tostring((model:FindFirstChildOfClass("Humanoid") or {}).Health or "ship")

        if Creatures[key] then
            equipMelee()
            targetRoot.CanCollide = false
            local enemyHumanoid = model:FindFirstChildOfClass("Humanoid")
            if enemyHumanoid then enemyHumanoid.WalkSpeed = 0 end
            targetRoot.Size = Vector3.new(60, 60, 60)
            local offset = Config.SpinPosition and Offsets[math.floor(os.clock() / 0.2) % #Offsets + 1] or CFrame.new(0, 40, 0)
            root.CFrame = targetRoot.CFrame * offset
            root.AssemblyLinearVelocity = Vector3.zero
            bringGroup(model)
            attackNoCooldown()
        elseif Ships[key] then
            root.CFrame = targetRoot.CFrame * CFrame.new(0, -20, 0)
            useAllSkills(targetRoot)
        else
            root.CFrame = targetRoot.CFrame * CFrame.new(0, 100, 0)
            useAllSkills(targetRoot)
        end
        task.wait(Config.FastDelay)
    end
end

