task.spawn(function()
    while task.wait(0.25) do
        if Config.Running and not Recovering then
            local _, humanoid = characterParts()
            if not humanoid or humanoid.Health <= 0 then
                recoverAfterLoss("Personagem morreu", false)
            elseif HadActiveBoat and not boatAlive(ActiveBoat) then
                recoverAfterLoss("Barco destruido", true)
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if Config.Running and not Recovering then
            local key, model = findTarget()
            if model then
                combat(key, model)
            elseif Config.AutoBoat then
                Status.Text = sailSea6() and "Navegando e procurando Sea Events..." or "Comprando/localizando barco..."
            else
                Status.Text = "Procurando Sea Events..."
            end
        else
            if not Config.Running then
                HadActiveBoat = false
                ActiveBoat = nil
                stopBoat(true)
            end
        end
    end
end)

