Status.TextColor3 = Color3.new(1, 1, 1)
Status.Text = "BANANA SEA EVENTS TEST | Parado"

button("START / STOP", function(b)
    Config.Running = not Config.Running
    b.Text = Config.Running and "STOP AUTO SEA EVENTS" or "START AUTO SEA EVENTS"
end)
button("Bring Mode: Normal", function(b)
    Config.BringMode = Config.BringMode == "Low" and "Normal" or Config.BringMode == "Normal" and "High" or "Low"
    b.Text = "Bring Mode: " .. Config.BringMode
end)
button("Spin Position: ON", function(b)
    Config.SpinPosition = not Config.SpinPosition
    b.Text = "Spin Position: " .. (Config.SpinPosition and "ON" or "OFF")
end)
button("Auto Buy/Sail Sea 6: ON", function(b)
    Config.AutoBoat = not Config.AutoBoat
    b.Text = "Auto Buy/Sail Sea 6: " .. (Config.AutoBoat and "ON" or "OFF")
    if not Config.AutoBoat then stopBoat() end
end)
for _, key in ipairs(Order) do
    button(key .. ": ON", function(b)
        Config.Targets[key] = not Config.Targets[key]
        b.Text = key .. ": " .. (Config.Targets[key] and "ON" or "OFF")
    end)
end

task.spawn(function()
    while task.wait(0.1) do
        if Config.Running then
            local key, model = findTarget()
            if model then
                combat(key, model)
            elseif Config.AutoBoat then
                Status.Text = sailSea6() and "Navegando e procurando Sea Events..." or "Comprando/localizando barco..."
            else
                Status.Text = "Procurando Sea Events..."
            end
        else
            stopBoat()
        end
    end
end)

