local function CharacterParts()
    local character = LocalPlayer.Character
    return character,
        character and character:FindFirstChildOfClass("Humanoid"),
        character and character:FindFirstChild("HumanoidRootPart")
end

local function FindNearestEnemy(root)
    local enemies = workspace:FindFirstChild("Enemies")
    local best, bestRoot, bestDistance
    bestDistance = math.huge
    if not enemies then return nil end

    for _, model in ipairs(enemies:GetChildren()) do
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local enemyRoot = model:FindFirstChild("HumanoidRootPart")
        if humanoid and humanoid.Health > 0 and enemyRoot
        and not string.find(string.lower(model.Name), "boss", 1, true) then
            local distance = (enemyRoot.Position - root.Position).Magnitude
            if distance < bestDistance then
                best, bestRoot, bestDistance = model, enemyRoot, distance
            end
        end
    end
    return best, bestRoot, bestDistance
end

local function EquipMelee(character, humanoid)
    for _, container in ipairs({LocalPlayer.Backpack, character}) do
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and tostring(tool.ToolTip) == "Melee" then
                humanoid:EquipTool(tool)
                return tool
            end
        end
    end
end

local function ControllerState()
    local module = LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework")
    if not module then return nil, false, false, "CombatFramework ausente" end
    local ok, framework = pcall(require, module)
    if not ok then return nil, false, false, "require falhou" end

    local direct = type(framework) == "table" and framework.activeController ~= nil
    if direct then return framework.activeController, true, false, "direto" end

    local getUps = getupvalues or (debug and debug.getupvalues)
    if not getUps then return nil, false, false, "getupvalues ausente" end
    local okUps, ups = pcall(getUps, framework)
    local internal = okUps and type(ups) == "table" and ups[2]
    local upvalue = type(internal) == "table" and internal.activeController ~= nil
    return upvalue and internal.activeController or nil, false, upvalue,
        upvalue and "upvalue[2]" or "controller nao encontrado"
end

local function PerformAttack(targetModel, targetRoot, character, humanoid, root)
    local tool = EquipMelee(character, humanoid)
    local controller, direct, upvalue, method = ControllerState()
    local rawCount, filteredCount = 0, 0
    local sent = false

    if not tool then return false, direct, upvalue, method, 0, 0, "Melee ausente" end
    if not controller then return false, direct, upvalue, method, 0, 0, "Sem controller" end

    local rigModule = ReplicatedStorage:FindFirstChild("CombatFramework")
    rigModule = rigModule and rigModule:FindFirstChild("RigLib")
    local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent")
    local okRig, rigLib = pcall(require, rigModule)
    if not okRig or not rigEvent or type(rigLib) ~= "table" then
        return false, direct, upvalue, method, 0, 0, "RigLib/RigEvent ausente"
    end

    local weapon = controller.blades and controller.blades[1]
    while weapon and weapon.Parent and weapon.Parent ~= character do weapon = weapon.Parent end
    local rawHits = rigLib.getBladeHits(character, {root}, 60) or {}
    local hits, seen = {}, {}
    for _, hit in pairs(rawHits) do
        rawCount = rawCount + 1
        local model = hit and hit:FindFirstAncestorOfClass("Model")
        local hitRoot = model and model:FindFirstChild("HumanoidRootPart")
        if model == targetModel and hitRoot and not seen[model] then
            seen[model] = true
            table.insert(hits, hitRoot)
        end
    end
    filteredCount = #hits

    controller.attacking = false
    controller.blocking = false
    controller.timeToNextAttack = tick() - 1
    controller.timeToNextBlock = 0
    controller.increment = 3
    controller.hitboxMagnitude = 120

    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(1280, 672))
    if weapon and #hits > 0 then
        rigEvent:FireServer("weaponChange", tostring(weapon))
        rigEvent:FireServer("hit", hits, 1, "")
        sent = true
    end
    return sent, direct, upvalue, method, rawCount, filteredCount, tool.Name
end

