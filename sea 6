local function button(text, y, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-20,0,38)
    b.Position = UDim2.new(0,10,0,y)
    b.BackgroundColor3 = Color3.fromRGB(50,50,54)
    b.BorderSizePixel = 0
    b.TextColor3 = Color3.fromRGB(240,240,240)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 13
    b.Text = text
    b.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,6)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        local ok, err = pcall(callback, b)
        if not ok then
            status.Text = "ERRO: " .. tostring(err)
            warn("[IKARO SEA6]", err)
        end
    end)

    return b
end

button("1. Salvar posição Tiki", 135, function()
    local pos, cf, source = currentReference()
    if not pos then
        status.Text = "Não encontrei player nem Beast Hunter."
        return
    end

    tikiPos = pos
    tikiBoatCFrame = cf

    log("TIKI_SOURCE=" .. source)
    log("TIKI_POS=" .. fmtV3(tikiPos))
    log("TIKI_CFRAME=" .. fmtCF(tikiBoatCFrame))

    status.Text = "Tiki salva usando: " .. source .. "\nAgora vá manualmente até o Sea/Danger Level 6."
end)

button("2. Salvar posição Sea 6", 179, function()
    local pos, cf, source = currentReference()
    if not pos then
        status.Text = "Não encontrei player nem Beast Hunter."
        return
    end

    sea6Pos = pos
    sea6BoatCFrame = cf

    log("SEA6_SOURCE=" .. source)
    log("SEA6_POS=" .. fmtV3(sea6Pos))
    log("SEA6_CFRAME=" .. fmtCF(sea6BoatCFrame))

    if tikiPos then
        local flatDelta = Vector3.new(
            sea6Pos.X - tikiPos.X,
            0,
            sea6Pos.Z - tikiPos.Z
        )

        if flatDelta.Magnitude > 0.01 then
            local dir = flatDelta.Unit
            log("SEA6_DIRECTION=" .. fmtV3(dir))
            log("DISTANCE_TIKI_TO_SEA6=" .. string.format("%.3f", flatDelta.Magnitude))

            status.Text = string.format(
                "Sea 6 salva!\nDireção X/Z: %.4f, %.4f | Distância: %.0f",
                dir.X,
                dir.Z,
                flatDelta.Magnitude
            )
        else
            status.Text = "Sea 6 salva, mas Tiki e Sea 6 ficaram praticamente iguais."
        end
    else
        status.Text = "Sea 6 salva. Falta salvar Tiki para calcular direção."
    end
end)

button("3. Ler textos de Danger/Sea", 223, function()
    local texts = detectDangerTexts()

    log("===== GUI SEA / DANGER TEXTS =====")
    for _, line in ipairs(texts) do
        log(line)
    end

    status.Text = "Encontrados " .. tostring(#texts) .. " textos relacionados a Sea/Danger. Eles entrarão no diagnóstico."
end)

button("4. Copiar diagnóstico", 267, function(btn)
    local output = {
        "=== IKARO SEA 6 MAPPER ===",
        "PlaceId=" .. tostring(game.PlaceId),
        "Player=" .. player.Name,
        "TIKI_POS=" .. fmtV3(tikiPos),
        "SEA6_POS=" .. fmtV3(sea6Pos),
        ""
    }

    if tikiPos and sea6Pos then
        local delta = Vector3.new(
            sea6Pos.X - tikiPos.X,
            0,
            sea6Pos.Z - tikiPos.Z
        )

        if delta.Magnitude > 0.01 then
            local dir = delta.Unit
            table.insert(output, "SEA6_DIRECTION=" .. fmtV3(dir))
            table.insert(output, "DISTANCE=" .. tostring(delta.Magnitude))
        end
    end

    table.insert(output, "")
    table.insert(output, "=== LOGS ===")

    for _, line in ipairs(logs) do
        table.insert(output, line)
    end

    local text = table.concat(output, "\n")
    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(function() setclipboard(text) end)
    elseif type(toclipboard) == "function" then
        copied = pcall(function() toclipboard(text) end)
    end

    if copied then
        btn.Text = "Copiado!"
        status.Text = "Diagnóstico copiado. Cole no ChatGPT."
        task.delay(2, function()
            if btn and btn.Parent then
                btn.Text = "4. Copiar diagnóstico"
            end
        end)
    else
        print(text)
        status.Text = "Clipboard indisponível. Diagnóstico enviado ao console."
    end
end)

button("Atualizar posição atual", 311, function()
    local pos, cf, source = currentReference()

    if pos then
        status.Text =
            source .. "\n"
            .. string.format("X %.1f | Y %.1f | Z %.1f", pos.X, pos.Y, pos.Z)

        log("CURRENT_" .. source .. "=" .. fmtV3(pos))
        log("CURRENT_LOOK=" .. fmtV3(cf.LookVector))
    else
        status.Text = "Nenhuma referência encontrada."
    end
end)

