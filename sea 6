- IKARO Sea 6 Direction Mapper v1
-- Objetivo:
-- 1) Salvar uma posição de referência na Tiki.
-- 2) Ir manualmente até o Sea/Danger Level 6.
-- 3) Salvar a posição no Sea 6.
-- 4) Calcular vetor/direção Tiki -> Sea 6.
-- 5) Copiar diagnóstico completo.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
if not player then return end

local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("IKARO_Sea6Mapper")
if old then old:Destroy() end

local tikiPos = nil
local sea6Pos = nil
local tikiBoatCFrame = nil
local sea6BoatCFrame = nil
local logs = {}

local function log(msg)
    msg = tostring(msg)
    table.insert(logs, msg)
    print("[IKARO SEA6]", msg)
end

local function getCharacterRoot()
    local ch = player.Character
    return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function getBeastHunterSeat()
    local boats = Workspace:FindFirstChild("Boats")
    local boat = boats and boats:FindFirstChild("Beast Hunter")
    if not boat then return nil end

    return boat:FindFirstChild("VehicleSeat")
        or boat.PrimaryPart
        or boat:FindFirstChildWhichIsA("BasePart", true)
end

local function currentReference()
    local seat = getBeastHunterSeat()
    if seat then
        return seat.Position, seat.CFrame, "Beast Hunter"
    end

    local root = getCharacterRoot()
    if root then
        return root.Position, root.CFrame, "Player"
    end

    return nil, nil, "none"
end

local function fmtV3(v)
    if not v then return "nil" end
    return string.format("Vector3.new(%.6f, %.6f, %.6f)", v.X, v.Y, v.Z)
end

local function fmtCF(cf)
    if not cf then return "nil" end
    local c = {cf:GetComponents()}
    for i = 1, #c do
        c[i] = string.format("%.6f", c[i])
    end
    return "CFrame.new(" .. table.concat(c, ", ") .. ")"
end

local function detectDangerTexts()
    local found = {}

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = ""
            pcall(function() txt = obj.Text end)

            local l = string.lower(txt)

            if txt ~= "" and (
                string.find(l, "danger", 1, true)
                or string.find(l, "sea", 1, true)
                or string.find(l, "leviathan", 1, true)
            ) then
                table.insert(found, obj:GetFullName() .. " = " .. txt)
            end
        end
    end

    return found
end

