-- IKARO Sea 6 Mapper v1.1 COMPAT
-- Versão simplificada para maior compatibilidade.
-- Não usa funções avançadas, hooks, regex, AlignOrientation, etc.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
if not player then
    warn("IKARO SEA6: LocalPlayer nao encontrado")
    return
end

local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("IKARO_Sea6MapperCompat")
if old then
    old:Destroy()
end

local tikiPos = nil
local sea6Pos = nil
local logs = {}

local function addLog(msg)
    msg = tostring(msg)
    table.insert(logs, msg)
    print("[IKARO SEA6]", msg)
end

local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:FindFirstChild("HumanoidRootPart")
end

local function getBoatSeat()
    local boats = Workspace:FindFirstChild("Boats")
    if not boats then
        return nil
    end

    local boat = boats:FindFirstChild("Beast Hunter")
    if not boat then
        return nil
    end

    return boat:FindFirstChild("VehicleSeat")
end

local function getCurrentPosition()
    local seat = getBoatSeat()
    if seat then
        return seat.Position, "Beast Hunter"
    end

    local hrp = getHRP()
    if hrp then
        return hrp.Position, "Player"
    end

    return nil, "none"
end

local function formatVector3(v)
    if not v then
        return "nil"
    end

    return "Vector3.new("
        .. tostring(v.X)
        .. ", "
        .. tostring(v.Y)
        .. ", "
        .. tostring(v.Z)
        .. ")"
end

local function calculateDirection()
    if not tikiPos or not sea6Pos then
        return nil, nil
    end

    local delta = Vector3.new(
        sea6Pos.X - tikiPos.X,
        0,
        sea6Pos.Z - tikiPos.Z
    )

    if delta.Magnitude <= 0.01 then
        return nil, 0
    end

    return delta.Unit, delta.Magnitude
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "IKARO_Sea6MapperCompat"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 410, 0, 330)
frame.Position = UDim2.new(0.04, 0, 0.18, 0)
frame.BackgroundColor3 = Color3.fromRGB(30,30,33)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,8)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,38)
title.BackgroundColor3 = Color3.fromRGB(38,38,42)
title.BorderSizePixel = 0
title.TextColor3 = Color3.fromRGB(240,240,240)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 16
title.Text = "IKARO - Sea 6 Mapper COMPAT"
title.Parent = frame

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1,-20,0,70)
status.Position = UDim2.new(0,10,0,45)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(215,215,215)
status.Font = Enum.Font.SourceSans
status.TextSize = 13
status.TextWrapped = true
status.Text = "1) Salve Tiki. 2) Va manualmente ao Sea 6. 3) Salve Sea 6. 4) Copie."
status.Parent = frame

local function makeButton(text, y, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-20,0,38)
    b.Position = UDim2.new(0,10,0,y)
    b.BackgroundColor3 = Color3.fromRGB(50,50,54)
    b.BorderSizePixel = 0
    b.TextColor3 = Color3.fromRGB(240,240,240)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 13
    b.Text = text
    b.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,6)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        local ok, err = pcall(function()
            callback(b)
        end)

        if not ok then
            warn("IKARO SEA6 ERRO:", err)
            status.Text = "ERRO: " .. tostring(err)
        end
    end)

    return b
end

makeButton("1. Salvar Tiki", 120, function()
    local pos, source = getCurrentPosition()

    if not pos then
        status.Text = "Nao encontrei Beast Hunter nem HumanoidRootPart."
        return
    end

    tikiPos = pos

    addLog("TIKI_SOURCE=" .. source)
    addLog("TIKI_POS=" .. formatVector3(tikiPos))

    status.Text = "Tiki salva usando " .. source .. ". Agora va manualmente ate o Sea 6."
end)

makeButton("2. Salvar Sea 6", 164, function()
    local pos, source = getCurrentPosition()

    if not pos then
        status.Text = "Nao encontrei Beast Hunter nem HumanoidRootPart."
        return
    end

    sea6Pos = pos

    addLog("SEA6_SOURCE=" .. source)
    addLog("SEA6_POS=" .. formatVector3(sea6Pos))

    local dir, dist = calculateDirection()

    if dir then
        addLog("SEA6_DIRECTION=" .. formatVector3(dir))
        addLog("DISTANCE=" .. tostring(dist))

        status.Text =
            "Sea 6 salvo!\nDir X="
            .. string.format("%.4f", dir.X)
            .. " Z="
            .. string.format("%.4f", dir.Z)
    else
        status.Text = "Sea 6 salvo. Falta Tiki ou as posicoes ficaram iguais."
    end
end)

makeButton("3. Mostrar posicao atual", 208, function()
    local pos, source = getCurrentPosition()

    if pos then
        status.Text =
            source
            .. "\nX=" .. math.floor(pos.X)
            .. " Y=" .. math.floor(pos.Y)
            .. " Z=" .. math.floor(pos.Z)

        addLog("CURRENT=" .. formatVector3(pos))
    else
        status.Text = "Nenhuma posicao encontrada."
    end
end)

makeButton("4. Copiar diagnostico", 252, function(btn)
    local dir, dist = calculateDirection()

    local output = {}
    table.insert(output, "=== IKARO SEA6 MAPPER ===")
    table.insert(output, "TIKI_POS=" .. formatVector3(tikiPos))
    table.insert(output, "SEA6_POS=" .. formatVector3(sea6Pos))

    if dir then
        table.insert(output, "SEA6_DIRECTION=" .. formatVector3(dir))
        table.insert(output, "DISTANCE=" .. tostring(dist))
    end

    table.insert(output, "")
    table.insert(output, "=== LOGS ===")

    for i = 1, #logs do
        table.insert(output, logs[i])
    end

    local result = table.concat(output, "\n")

    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(function()
            setclipboard(result)
        end)
    end

    if not copied and type(toclipboard) == "function" then
        copied = pcall(function()
            toclipboard(result)
        end)
    end

    if copied then
        btn.Text = "Copiado!"
        status.Text = "Diagnostico copiado. Cole no chat."

        task.delay(2, function()
            if btn and btn.Parent then
                btn.Text = "4. Copiar diagnostico"
            end
        end)
    else
        print("=== IKARO SEA6 MAPPER ===")
        print(result)
        status.Text = "Clipboard indisponivel. Veja o console."
    end
end)

addLog("SEA6 MAPPER COMPAT CARREGADO")
