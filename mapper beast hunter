local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
if not player then return end

local playerGui = player:WaitForChild("PlayerGui")

local oldGui = playerGui:FindFirstChild("IKARO_BH_PASSIVE")
if oldGui then
    oldGui:Destroy()
end

local logs = {}
local capturing = false

local function log(msg)
    msg = tostring(msg)
    table.insert(logs, msg)
    print("[IKARO BH]", msg)
end

local function lname(v)
    return string.lower(tostring(v or ""))
end

local function relevant(text)
    local s = lname(text)
    return string.find(s, "beast", 1, true)
        or string.find(s, "hunter", 1, true)
        or string.find(s, "boat", 1, true)
        or string.find(s, "ship", 1, true)
        or string.find(s, "leviathan", 1, true)
end

local function fullname(obj)
    local ok, result = pcall(function()
        return obj:GetFullName()
    end)

    if ok then
        return result
    end

    return obj.Name
end

local function inspect(obj, prefix)
    if not obj then return end

    log((prefix or "OBJ") .. " | " .. obj.ClassName .. " | " .. fullname(obj))

    if obj:IsA("VehicleSeat") then
        log("SEAT | " .. fullname(obj) .. " | " .. tostring(obj.Position))
    end

    if obj:IsA("ProximityPrompt") then
        log(
            "PROMPT | "
            .. fullname(obj)
            .. " | Action=" .. tostring(obj.ActionText)
            .. " | Object=" .. tostring(obj.ObjectText)
        )
    end

    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        local txt = ""
        pcall(function()
            txt = obj.Text
        end)

        if txt ~= "" then
            log("GUI | " .. fullname(obj) .. " | " .. txt)
        end
    end
end

local function scanBoats()
    log("===== BOATS =====")

    local boats = Workspace:FindFirstChild("Boats")
    if not boats then
        log("Workspace.Boats nao encontrado")
        return
    end

    local children = boats:GetChildren()

    for i = 1, #children do
        local boat = children[i]

        log("BOAT | " .. boat.Name .. " | " .. fullname(boat))

        local seat = boat:FindFirstChildWhichIsA("VehicleSeat", true)
        if seat then
            inspect(seat, "BOAT_SEAT")
        end

        if relevant(boat.Name) then
            inspect(boat, "RELEVANT_BOAT")
        end
    end
end

local function scanRoot(root, label)
    log("===== " .. label .. " =====")

    local all = root:GetDescendants()

    for i = 1, #all do
        local obj = all[i]
        local shouldLog = relevant(obj.Name)

        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = ""
            pcall(function()
                txt = obj.Text
            end)

            if relevant(txt) then
                shouldLog = true
            end
        elseif obj:IsA("ProximityPrompt") then
            local txt = tostring(obj.ActionText) .. " " .. tostring(obj.ObjectText)
            if relevant(txt) or string.find(lname(txt), "buy", 1, true) then
                shouldLog = true
            end
        end

        if shouldLog then
            inspect(obj, "SCAN")
        end
    end
end

