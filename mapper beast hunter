local function addLog(line)
    line = tostring(line)
    table.insert(logs, os.date("%H:%M:%S") .. " | " .. line)
    print("[IKARO BH MAPPER]", line)
end

local function safeFullName(obj)
    local ok, result = pcall(function()
        return obj:GetFullName()
    end)
    return ok and result or tostring(obj)
end

local function serialize(v, depth)
    depth = depth or 0
    if depth > 2 then
        return "<max-depth>"
    end

    local t = typeof(v)

    if t == "string" then
        return string.format("%q", v)
    elseif t == "number" or t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then
        local c = {v:GetComponents()}
        for i,n in ipairs(c) do
            c[i] = string.format("%.4f", n)
        end
        return "CFrame.new(" .. table.concat(c, ", ") .. ")"
    elseif t == "Instance" then
        return "<" .. v.ClassName .. ":" .. safeFullName(v) .. ">"
    elseif t == "table" then
        local out = {}
        local count = 0
        for k,val in pairs(v) do
            count += 1
            if count > 20 then
                table.insert(out, "...")
                break
            end
            table.insert(out, "[" .. serialize(k, depth+1) .. "]=" .. serialize(val, depth+1))
        end
        return "{" .. table.concat(out, ", ") .. "}"
    end

    return "<" .. t .. ":" .. tostring(v) .. ">"
end

