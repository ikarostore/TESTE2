local connections = {}

local function safeFullName(obj)
    local ok, result = pcall(function()
        return obj:GetFullName()
    end)
    return ok and result or tostring(obj)
end

local function addLog(msg)
    local line = os.date("%H:%M:%S") .. " | " .. tostring(msg)
    table.insert(logs, line)
    print("[IKARO PASSIVE MAPPER]", msg)
end

local function lower(s)
    return string.lower(tostring(s or ""))
end

local function isRelevantName(name)
    local n = lower(name)
    return string.find(n, "beast", 1, true)
        or string.find(n, "hunter", 1, true)
        or string.find(n, "boat", 1, true)
        or string.find(n, "ship", 1, true)
        or string.find(n, "leviathan", 1, true)
end

local function describeInstance(obj, prefix)
    if not obj then return end

    local info = (prefix or "OBJ")
        .. " | "
        .. obj.ClassName
        .. " | "
        .. safeFullName(obj)

    addLog(info)

    if obj:IsA("VehicleSeat") then
        addLog(
            "VEHICLESEAT | "
            .. safeFullName(obj)
            .. " | Pos="
            .. tostring(obj.Position)
        )
    elseif obj:IsA("ProximityPrompt") then
        addLog(
            "PROMPT | "
            .. safeFullName(obj)
            .. " | ActionText="
            .. tostring(obj.ActionText)
            .. " | ObjectText="
            .. tostring(obj.ObjectText)
        )
    elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
        local txt = ""
        pcall(function()
            txt = obj.Text
        end)
        if txt ~= "" then
            addLog(
                "GUI_TEXT | "
                .. safeFullName(obj)
                .. " | Text="
                .. txt
            )
        end
    end
end

local function scanRoot(root, label)
    addLog("===== SCAN " .. label .. " =====")

    for _, obj in ipairs(root:GetDescendants()) do
        local relevant = isRelevantName(obj.Name)

        if obj:IsA("ProximityPrompt") then
            local txt = lower(
                tostring(obj.ActionText)
                .. " "
                .. tostring(obj.ObjectText)
                .. " "
                .. obj.Name
            )
            if string.find(txt, "beast", 1, true)
            or string.find(txt, "boat", 1, true)
            or string.find(txt, "hunter", 1, true)
            or string.find(txt, "buy", 1, true) then
                relevant = true
            end
        end

        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = ""
            pcall(function()
                txt = obj.Text
            end)
            if isRelevantName(txt) then
                relevant = true
            end
        end

        if relevant then
            describeInstance(obj, "SCAN")
        end
    end
end

local function scanBoats()
    local boats = Workspace:FindFirstChild("Boats")
    addLog("===== SCAN WORKSPACE.BOATS =====")

    if not boats then
        addLog("Workspace.Boats não existe neste momento.")
        return
    end

    for _, boat in ipairs(boats:GetChildren()) do
        addLog(
            "BOAT | "
            .. boat.ClassName
            .. " | "
            .. boat.Name
            .. " | "
            .. safeFullName(boat)
        )

        local seat = boat:FindFirstChildWhichIsA("VehicleSeat", true)
        if seat then
            addLog(
                "BOAT_SEAT | "
                .. boat.Name
                .. " | "
                .. safeFullName(seat)
                .. " | Pos="
                .. tostring(seat.Position)
            )
        end

        for _, d in ipairs(boat:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                describeInstance(d, "BOAT_PROMPT")
            end
        end
    end
end

