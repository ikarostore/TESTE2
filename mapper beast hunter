    status.Text = "Scan completo concluido."
end)

createButton("Copiar diagnostico", 236, function(btn)
    local txt = table.concat(logs, "\n")

    local copied = false

    if setclipboard then
        copied = pcall(function()
            setclipboard(txt)
        end)
    elseif toclipboard then
        copied = pcall(function()
            toclipboard(txt)
        end)
    end

    if copied then
        btn.Text = "Copiado!"
        status.Text = "Cole o diagnostico no chat."
        task.delay(2, function()
            if btn and btn.Parent then
                btn.Text = "Copiar diagnostico"
            end
        end)
    else
        print("===== IKARO DIAGNOSTICO =====")
        print(txt)
        status.Text = "Clipboard indisponivel; enviado ao console."
    end
end)

-- Observadores passivos
Workspace.DescendantAdded:Connect(function(obj)
    if not capturing then return end

    if relevant(obj.Name) then
        task.defer(function()
            inspect(obj, "WORKSPACE_ADDED")
        end)
    elseif obj:IsA("VehicleSeat") then
        task.defer(function()
            inspect(obj, "SEAT_ADDED")
        end)
    end
end)

ReplicatedStorage.DescendantAdded:Connect(function(obj)
    if not capturing then return end

    if relevant(obj.Name) then
        task.defer(function()
            inspect(obj, "RS_ADDED")
        end)
    end
end)

playerGui.DescendantAdded:Connect(function(obj)
    if not capturing then return end

    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        task.defer(function()
            task.wait()

            local txt = ""
            pcall(function()
                txt = obj.Text
            end)

            if relevant(txt) then
                inspect(obj, "GUI_ADDED")
            end
        end)
    end
end)

