newButton("Copiar diagnóstico", 196, function(btn)
    local header = {
        "=== IKARO BEAST HUNTER DIAGNOSTIC ===",
        "Player=" .. LocalPlayer.Name,
        "PlaceId=" .. tostring(game.PlaceId),
        "JobId=" .. tostring(game.JobId),
        ""
    }

    local text = table.concat(header, "\n") .. table.concat(logs, "\n")

    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(function()
            setclipboard(text)
        end)
    elseif type(toclipboard) == "function" then
        copied = pcall(function()
            toclipboard(text)
        end)
    end

    if copied then
        btn.Text = "Copiado!"
        status.Text = "Diagnóstico copiado. Cole no ChatGPT."
        task.delay(2, function()
            if btn and btn.Parent then
                btn.Text = "Copiar diagnóstico"
            end
        end)
    else
        print(text)
        status.Text = "Clipboard não disponível. Diagnóstico enviado ao console."
    end
end)

