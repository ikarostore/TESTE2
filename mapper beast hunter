table.insert(connections, Workspace.DescendantAdded:Connect(function(obj)
    if not capturing then return end

    if isRelevantName(obj.Name) then
        task.defer(function()
            describeInstance(obj, "WORKSPACE_ADDED")
        end)
    elseif obj:IsA("VehicleSeat") then
        task.defer(function()
            describeInstance(obj, "VEHICLESEAT_ADDED")
        end)
    elseif obj:IsA("ProximityPrompt") then
        local txt = lower(
            tostring(obj.ActionText)
            .. " "
            .. tostring(obj.ObjectText)
            .. " "
            .. obj.Name
        )

        if string.find(txt, "beast", 1, true)
        or string.find(txt, "boat", 1, true)
        or string.find(txt, "hunter", 1, true)
        or string.find(txt, "buy", 1, true) then
            task.defer(function()
                describeInstance(obj, "PROMPT_ADDED")
            end)
        end
    end
end))

