    }

    local txt = table.concat(header, "\n") .. table.concat(logs, "\n")

    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(function()
            setclipboard(txt)
        end)
    elseif type(toclipboard) == "function" then
        copied = pcall(function()
            toclipboard(txt)
        end)
    end

    if copied then
        btn.Text = "Copiado!"
        status.Text = "Cole o diagnóstico no ChatGPT."
        task.delay(2, function()
            if btn and btn.Parent then
                btn.Text = "Copiar diagnóstico"
            end
        end)
    else
        print(txt)
        status.Text = "Clipboard indisponível. Diagnóstico enviado ao console."
    end
end)

