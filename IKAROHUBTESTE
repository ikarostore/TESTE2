local player = Players.LocalPlayer
if not player then
    warn("IKAROhub: LocalPlayer não encontrado")
    return
end

local playerGui = player:WaitForChild("PlayerGui")

local character
local humanoid
local hrp

local viagemAtual = nil
local viagemToken = 0
local noclipAtivo = false
local colisoesOriginais = {}

-- Velocidade do voo automático em studs por segundo.
local velocidadeVooAutomatico = 120

local function atualizarPersonagem(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")
end

atualizarPersonagem(player.Character or player.CharacterAdded:Wait())

player.CharacterAdded:Connect(function(char)
    viagemToken = viagemToken + 1

    if viagemAtual then
        pcall(function()
            viagemAtual:Cancel()
        end)
        viagemAtual = nil
    end

    atualizarPersonagem(char)
end)

-- =========================================================
-- NOCLIP DURANTE O VOO
-- =========================================================

local function ativarNoclip()
    if not character then
        return
    end

    noclipAtivo = true

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            if colisoesOriginais[obj] == nil then
                colisoesOriginais[obj] = obj.CanCollide
            end

            obj.CanCollide = false
        end
    end
end

local function restaurarColisoes()
    noclipAtivo = false

    for parte, valorOriginal in pairs(colisoesOriginais) do
        if parte and parte.Parent then
            pcall(function()
                parte.CanCollide = valorOriginal
            end)
        end
    end

    colisoesOriginais = {}
end

RunService.Stepped:Connect(function()
    if noclipAtivo and character then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end
    end
end)

-- =========================================================
-- FUNÇÕES DE LOCALIZAÇÃO
-- =========================================================

local function pegarPartePrincipal(obj)
    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj:FindFirstChild("HumanoidRootPart")
            or obj:FindFirstChild("UpperTorso")
            or obj:FindFirstChild("Torso")
            or obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function pegarCFrameDestino(obj, altura)
    altura = altura or 4

    if not obj then
        return nil
    end

    local parte = pegarPartePrincipal(obj)

    if parte then
        return parte.CFrame + Vector3.new(0, altura, 0)
    end

    if obj:IsA("Model") then
        local ok, pivot = pcall(function()
            return obj:GetPivot()
        end)

        if ok and pivot then
            return pivot + Vector3.new(0, altura, 0)
        end
    end

    return nil
end

-- =========================================================
-- VOO AUTOMÁTICO
-- =========================================================

local function cancelarViagem()
    viagemToken = viagemToken + 1

    if viagemAtual then
        pcall(function()
            viagemAtual:Cancel()
        end)

        viagemAtual = nil
    end

    restaurarColisoes()
end

local function voarAteCFrame(destinoCFrame, statusCallback)
    if not hrp or not destinoCFrame then
        return false
    end

    cancelarViagem()

    viagemToken = viagemToken + 1
    local meuToken = viagemToken

    ativarNoclip()

    local distancia = (hrp.Position - destinoCFrame.Position).Magnitude
    local duracao = math.max(distancia / velocidadeVooAutomatico, 0.15)

    local tweenInfo = TweenInfo.new(
        duracao,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    viagemAtual = TweenService:Create(
        hrp,
        tweenInfo,
        {CFrame = destinoCFrame}
    )

    if statusCallback then
        statusCallback("Voando... " .. math.floor(distancia) .. " studs")
    end

    local tweenLocal = viagemAtual
    tweenLocal:Play()

    local estado = tweenLocal.Completed:Wait()

    if meuToken ~= viagemToken then
        return false
    end

    if viagemAtual == tweenLocal then
        viagemAtual = nil
    end

    restaurarColisoes()

    return estado == Enum.PlaybackState.Completed
end

local function voarAteObjeto(obj, altura, statusCallback)
    local destino = pegarCFrameDestino(obj, altura)

    if not destino then
        if statusCallback then
            statusCallback("Não encontrei uma posição válida.")
        end

        return
    end

    task.spawn(function()
        local ok, erro = pcall(function()
            local chegou = voarAteCFrame(destino, statusCallback)

            if statusCallback then
                if chegou then
                    statusCallback("Chegou ao destino.")
                else
                    statusCallback("Viagem cancelada.")
                end
            end
        end)

        if not ok then
            restaurarColisoes()

            if statusCallback then
                statusCallback("Erro durante o voo: " .. tostring(erro))
            end
        end
    end)
end

