local distanciaFrenteNPC = 4
local alturaTP = 3

-- =========================================================
-- FUNÇÕES DE TELEPORTE
-- =========================================================

local function pegarPartePrincipal(obj)
    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj:FindFirstChild("HumanoidRootPart")
            or obj:FindFirstChild("UpperTorso")
            or obj:FindFirstChild("Torso")
            or obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function teleportarParaParte(parte, offset)
    if not hrp or not parte then
        return
    end

    offset = offset or Vector3.new(0, alturaTP, 0)

    local destino = parte.CFrame * CFrame.new(offset)

    pcall(function()
        hrp.CFrame = destino
    end)
end

local function teleportarParaModel(model)
    local parte = pegarPartePrincipal(model)
    if not parte then
        warn("IKAROhub: não encontrei parte principal em", model and model.Name)
        return
    end

    local pos =
        parte.Position
        + Vector3.new(0, alturaTP, 0)
        - (parte.CFrame.LookVector * distanciaFrenteNPC)

    pcall(function()
        hrp.CFrame = CFrame.new(pos, parte.Position)
    end)
end

local function teleportarParaIlha(model)
    if not model then
        return
    end

    local sucesso, pivot = pcall(function()
        return model:GetPivot()
    end)

    if sucesso and pivot then
        pcall(function()
            hrp.CFrame = pivot + Vector3.new(0, 15, 0)
        end)
        return
    end

    local parte = pegarPartePrincipal(model)
    if parte then
        teleportarParaParte(parte, Vector3.new(0, 15, 0))
    end
end

