-- =========================================================
-- NPCs PERMITIDOS
-- =========================================================

local function pegarRoot(model)
    if not model then
        return nil
    end

    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model.PrimaryPart
end

local function ehJogador(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function nomePermitido(nome)
    if nomesNPCPermitidos[nome] then
        return true
    end

    if aliases[nome] then
        return true
    end

    return false
end

local function ehNPCPermitido(model)
    if not model or not model:IsA("Model") then
        return false
    end

    if model == character then
        return false
    end

    if ehJogador(model) then
        return false
    end

    if not nomePermitido(model.Name) then
        return false
    end

    return pegarRoot(model) ~= nil
end

