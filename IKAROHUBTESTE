-- Liga/desliga voo
local function alternarVoo()

    if not character then
        return
    end

    if not hrp then
        return
    end

    if not linearVelocity then
        return
    end

    voando = not voando

    linearVelocity.Enabled = voando

    if not voando then
        linearVelocity.VectorVelocity = Vector3.zero
    end

    atualizarBotao()
end

flyButton.MouseButton1Click:Connect(function()
    alternarVoo()
end)

-- Tecla F
UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.F then
        alternarVoo()
    end
end)

-- Movimento
RunService.RenderStepped:Connect(function()

    if not voando then
        return
    end

    if not linearVelocity then
        return
    end

    if not linearVelocity.Parent then
        return
    end

    camera = workspace.CurrentCamera

    if not camera then
        return
    end

    linearVelocity.VectorVelocity =
        camera.CFrame.LookVector * velocidadeVoo
end)

