local function procurarNPCFisico(nome)
    local pastaNPCs = workspace:FindFirstChild("NPCs")

    if pastaNPCs then
        for _, obj in ipairs(pastaNPCs:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == nome then
                return obj
            end
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == nome then
            if Players:GetPlayerFromCharacter(obj) == nil then
                return obj
            end
        end
    end

    return nil
end

local function carregarNPCs()
    limparConteudo()

    local npcFolder = ReplicatedStorage:FindFirstChild("NPCs")
    if not npcFolder then
        status.Text = "ReplicatedStorage.NPCs não encontrado."
        criarAviso("A pasta ReplicatedStorage.NPCs não está disponível.")
        return
    end

    local nomes = {}
    local vistos = {}

    for _, obj in ipairs(npcFolder:GetChildren()) do
        if obj:IsA("Model") and not vistos[obj.Name] then
            vistos[obj.Name] = true
            table.insert(nomes, obj.Name)
        end
    end

    table.sort(nomes, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    for _, nome in ipairs(nomes) do
        criarBotaoLista(nome, function()
            local fisico = procurarNPCFisico(nome)

            if fisico then
                teleportarParaModel(fisico)
                status.Text = "TP para NPC: " .. nome
            else
                status.Text = "NPC '" .. nome .. "' existe no storage, mas não achei a cópia física no mapa."
            end
        end)
    end

    status.Text = "NPCs disponíveis no storage: " .. tostring(#nomes)
end

-- =========================================================
-- ABA ILHAS / TP
-- =========================================================

local nomesIgnorarMapa = {
    ["Waterfall"] = true,
    ["Temple of Time"] = true
}

local function ehProvavelIlha(model)
    if not model:IsA("Model") then
        return false
    end

    if nomesIgnorarMapa[model.Name] then
        return false
    end

    local nome = string.lower(model.Name)

    local palavras = {
        "island",
        "castle",
        "turtle",
        "tree",
        "port",
        "tiki",
        "cake",
        "chocolate",
        "candy",
        "ice cream",
        "haunted",
        "hydra"
    }

    for _, palavra in ipairs(palavras) do
        if string.find(nome, palavra, 1, true) then
            return true
        end
    end

    return false
end

local function carregarIlhas()
    limparConteudo()

    local map = workspace:FindFirstChild("Map")
    if not map then
        status.Text = "Workspace.Map não encontrado."
        criarAviso("A pasta Workspace.Map não foi encontrada.")
        return
    end

    local lista = {}
    local vistos = {}

    for _, obj in ipairs(map:GetChildren()) do
        if obj:IsA("Model") and not vistos[obj.Name] then
            if ehProvavelIlha(obj) then
                vistos[obj.Name] = true
                table.insert(lista, obj)
            end
        end
    end

    -- fallback: se o jogo não nomear as ilhas de forma óbvia,
    -- mostra todos os models principais do Map
    if #lista == 0 then
        for _, obj in ipairs(map:GetChildren()) do
            if obj:IsA("Model") and not vistos[obj.Name] then
                vistos[obj.Name] = true
                table.insert(lista, obj)
            end
        end
    end

    table.sort(lista, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    for _, ilha in ipairs(lista) do
        criarBotaoLista(ilha.Name, function()
            if ilha and ilha.Parent then
                teleportarParaIlha(ilha)
                status.Text = "TP para ilha/mapa: " .. ilha.Name
            else
                status.Text = "Ilha não está mais disponível."
            end
        end)
    end

    status.Text = "Locais detectados: " .. tostring(#lista)

    if #lista == 0 then
        criarAviso("Nenhuma ilha/model principal foi encontrada em Workspace.Map.")
    end
end

