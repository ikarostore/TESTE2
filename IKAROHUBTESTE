local botoesAbas = {}

local function criarAba(nome, callback)
    local botao = Instance.new("TextButton")
    botao.Size = UDim2.new(0, 108, 1, 0)
    botao.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    botao.BorderSizePixel = 0
    botao.TextColor3 = Color3.fromRGB(255, 255, 255)
    botao.Font = Enum.Font.SourceSansBold
    botao.TextSize = 13
    botao.Text = nome
    botao.Parent = tabBar

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = botao

    botoesAbas[nome] = botao

    botao.MouseButton1Click:Connect(function()
        cancelarViagem()

        for nomeAba, outro in pairs(botoesAbas) do
            if nomeAba == nome then
                outro.BackgroundColor3 = Color3.fromRGB(40, 150, 90)
            else
                outro.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            end
        end

        callback()
    end)
end

