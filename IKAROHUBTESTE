local function atualizarBotaoVoo()
    if voando then
        flyButton.Text = "Voo: ATIVADO (F)"
        flyButton.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        flyButton.Text = "Voo: DESATIVADO (F)"
        flyButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    end
end

local function alternarVoo()
    if not character or not hrp or not linearVelocity then
        return
    end

    voando = not voando
    linearVelocity.Enabled = voando

    if not voando then
        linearVelocity.VectorVelocity = Vector3.zero
    end

    atualizarBotaoVoo()
end

flyButton.MouseButton1Click:Connect(alternarVoo)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.F then
        alternarVoo()
    end
end)

RunService.RenderStepped:Connect(function()
    if not voando then
        return
    end

    if not linearVelocity or not linearVelocity.Parent then
        return
    end

    camera = workspace.CurrentCamera

    if not camera then
        return
    end

    linearVelocity.VectorVelocity =
        camera.CFrame.LookVector * velocidadeVoo
end)

