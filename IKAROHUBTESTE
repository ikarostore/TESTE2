local function pegarRoot(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
end

local function ehPersonagemDeJogador(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function pararMovimentoNPC()
    cancelToken = cancelToken + 1
    npcSelecionado = nil

    if humanoid and hrp then
        humanoid:MoveTo(hrp.Position)
    end
end

npcToggleButton.MouseButton1Click:Connect(function()
    movimentoNPCAtivado = not movimentoNPCAtivado

    if movimentoNPCAtivado then
        npcToggleButton.Text = "Andar até NPC: ATIVADO"
        npcToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        npcToggleButton.Text = "Andar até NPC: DESATIVADO"
        npcToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        pararMovimentoNPC()
    end
end)

local function irAteNPC(npc)
    if not movimentoNPCAtivado then
        return
    end

    if not character or not humanoid or not hrp then
        return
    end

    if not npc or not npc.Parent then
        return
    end

    local npcRoot = pegarRoot(npc)

    if not npcRoot then
        warn("NPC sem RootPart:", npc.Name)
        return
    end

    npcSelecionado = npc

    cancelToken = cancelToken + 1
    local meuToken = cancelToken

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true
    })

    local sucesso, erro = pcall(function()
        path:ComputeAsync(hrp.Position, npcRoot.Position)
    end)

    if not sucesso then
        warn("Erro no path:", erro)
        return
    end

    if path.Status ~= Enum.PathStatus.Success then
        warn("Não foi possível criar caminho até:", npc.Name)
        return
    end

    for _, waypoint in ipairs(path:GetWaypoints()) do
        if meuToken ~= cancelToken then
            return
        end

        if not movimentoNPCAtivado then
            return
        end

        if not humanoid or humanoid.Health <= 0 then
            return
        end

        if not npc or not npc.Parent then
            return
        end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(waypoint.Position)

        local chegou = humanoid.MoveToFinished:Wait()

        if meuToken ~= cancelToken then
            return
        end

        if not chegou then
            break
        end
    end
end

local function criarBotaoNPC(npc)
    local button = Instance.new("TextButton")
    button.Name = "NPC_" .. npc.Name
    button.Size = UDim2.new(1, -10, 0, 32)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 13
    button.Font = Enum.Font.SourceSansBold
    button.Text = npc.Name
    button.Parent = npcList

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 5)
    buttonCorner.Parent = button

    button.MouseButton1Click:Connect(function()
        if movimentoNPCAtivado then
            task.spawn(function()
                irAteNPC(npc)
            end)
        end
    end)
end

local function atualizarListaNPCs()
    for _, child in ipairs(npcList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local encontrados = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local humanoidNPC = obj:FindFirstChildOfClass("Humanoid")
            local root = pegarRoot(obj)
            local jogador = ehPersonagemDeJogador(obj)

            if humanoidNPC
                and root
                and not jogador
                and obj ~= character
                and not encontrados[obj] then

                encontrados[obj] = true
                criarBotaoNPC(obj)
            end
        end
    end

    task.wait()

    npcList.CanvasSize = UDim2.new(
        0,
        0,
        0,
        layout.AbsoluteContentSize.Y + 10
    )
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    npcList.CanvasSize = UDim2.new(
        0,
        0,
        0,
        layout.AbsoluteContentSize.Y + 10
    )
end)

atualizarListaNPCs()

print("IKAROhub carregado com sucesso!")
