local function criarBotaoNPC(npc)
    local button = Instance.new("TextButton")
    button.Name = "NPCButton"
    button.Size = UDim2.new(1, -10, 0, 32)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.SourceSansBold
    button.TextSize = 13
    button.Text = npc.Name
    button.Parent = npcList

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = button

    button.MouseButton1Click:Connect(function()
        if not movimentoNPCAtivado then
            warn("IKAROhub: ative 'Voar até NPC' primeiro.")
            return
        end

        task.spawn(function()
            local ok, erro = pcall(function()
                voarAteNPC(npc)
            end)

            if not ok then
                restaurarColisoes()
                tweenNPCAtual = nil
                warn("IKAROhub: erro ao voar até NPC:", erro)
            end
        end)
    end)
end

local function limparListaNPCs()
    for _, child in ipairs(npcList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

local function atualizarCanvas()
    npcList.CanvasSize = UDim2.new(
        0,
        0,
        0,
        listLayout.AbsoluteContentSize.Y + 10
    )
end

local function atualizarListaNPCs()
    limparListaNPCs()
    npcTitle.Text = "Procurando NPCs interativos..."

    local encontrados = {}
    local quantidade = 0

    local ok, erro = pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model")
                and not encontrados[obj]
                and ehNPCPermitido(obj) then

                encontrados[obj] = true
                quantidade = quantidade + 1
                criarBotaoNPC(obj)
            end
        end
    end)

    if not ok then
        warn("IKAROhub: erro ao procurar NPCs:", erro)
        npcTitle.Text = "Erro ao procurar NPCs"
        return
    end

    npcTitle.Text = "NPCs interativos encontrados: " .. tostring(quantidade)
    atualizarCanvas()
end

listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(atualizarCanvas)

refreshButton.MouseButton1Click:Connect(function()
    task.spawn(atualizarListaNPCs)
end)

task.spawn(function()
    task.wait(0.5)
    atualizarListaNPCs()
end)

