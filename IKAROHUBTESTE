local function pegarRoot(model)
    if not model then
        return nil
    end

    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model.PrimaryPart
end

local function ehJogador(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function pararMovimento()
    cancelToken = cancelToken + 1

    if humanoid and hrp then
        humanoid:MoveTo(hrp.Position)
    end
end

npcToggleButton.MouseButton1Click:Connect(function()
    movimentoNPCAtivado = not movimentoNPCAtivado

    if movimentoNPCAtivado then
        npcToggleButton.Text = "Andar até NPC: ATIVADO"
        npcToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        npcToggleButton.Text = "Andar até NPC: DESATIVADO"
        npcToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        pararMovimento()
    end
end)

local function irAteNPC(npc)
    if not movimentoNPCAtivado then
        return
    end

    if not npc or not npc.Parent then
        return
    end

    if not character or not humanoid or not hrp then
        return
    end

    local npcRoot = pegarRoot(npc)
    if not npcRoot then
        warn("IKAROhub: NPC sem RootPart:", npc.Name)
        return
    end

    cancelToken = cancelToken + 1
    local tokenAtual = cancelToken

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true
    })

    local ok, erro = pcall(function()
        path:ComputeAsync(hrp.Position, npcRoot.Position)
    end)

    if not ok then
        warn("IKAROhub: erro no Pathfinding:", erro)
        return
    end

    if path.Status ~= Enum.PathStatus.Success then
        warn("IKAROhub: caminho não encontrado para:", npc.Name)
        return
    end

    local waypoints = path:GetWaypoints()

    for _, waypoint in ipairs(waypoints) do
        if tokenAtual ~= cancelToken then
            return
        end

        if not movimentoNPCAtivado then
            return
        end

        if not humanoid or humanoid.Health <= 0 then
            return
        end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(waypoint.Position)

        local chegou = humanoid.MoveToFinished:Wait()

        if tokenAtual ~= cancelToken then
            return
        end

        if not chegou then
            return
        end
    end
end

local function criarBotaoNPC(npc)
    local button = Instance.new("TextButton")
    button.Name = "NPCButton"
    button.Size = UDim2.new(1, -10, 0, 32)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.SourceSansBold
    button.TextSize = 13
    button.Text = npc.Name
    button.Parent = npcList

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = button

    button.MouseButton1Click:Connect(function()
        if not movimentoNPCAtivado then
            warn("IKAROhub: ative 'Andar até NPC' primeiro.")
            return
        end

        task.spawn(function()
            local ok, erro = pcall(function()
                irAteNPC(npc)
            end)

            if not ok then
                warn("IKAROhub: erro ao andar até NPC:", erro)
            end
        end)
    end)
end

local function limparListaNPCs()
    for _, child in ipairs(npcList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

local function atualizarCanvas()
    npcList.CanvasSize = UDim2.new(
        0,
        0,
        0,
        listLayout.AbsoluteContentSize.Y + 10
    )
end

local function atualizarListaNPCs()
    limparListaNPCs()
    npcTitle.Text = "Procurando NPCs..."

    local encontrados = {}
    local quantidade = 0

    local ok, erro = pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model")
                and obj ~= character
                and not ehJogador(obj)
                and not encontrados[obj] then

                local npcHumanoid = obj:FindFirstChildOfClass("Humanoid")
                local root = pegarRoot(obj)

                if npcHumanoid and root then
                    encontrados[obj] = true
                    quantidade = quantidade + 1
                    criarBotaoNPC(obj)
                end
            end
        end
    end)

    if not ok then
        warn("IKAROhub: erro ao procurar NPCs:", erro)
        npcTitle.Text = "Erro ao procurar NPCs"
        return
    end

    npcTitle.Text = "NPCs encontrados: " .. tostring(quantidade)
    atualizarCanvas()
end

listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(atualizarCanvas)

refreshButton.MouseButton1Click:Connect(function()
    task.spawn(atualizarListaNPCs)
end)

-- Faz a busca depois da interface aparecer, para evitar travar o carregamento.
task.spawn(function()
    task.wait(0.5)
    atualizarListaNPCs()
end)

