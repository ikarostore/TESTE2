local function configurarPersonagem(char)
    character = char
    humanoid = character:WaitForChild("Humanoid")
    hrp = character:WaitForChild("HumanoidRootPart")

    -- Remove objetos antigos caso existam
    local oldAttachment = hrp:FindFirstChild("IKAROFlyAttachment")
    if oldAttachment then
        oldAttachment:Destroy()
    end

    local oldVelocity = hrp:FindFirstChild("IKAROFlyVelocity")
    if oldVelocity then
        oldVelocity:Destroy()
    end

    attachment = Instance.new("Attachment")
    attachment.Name = "IKAROFlyAttachment"
    attachment.Parent = hrp

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "IKAROFlyVelocity"

    linearVelocity.Attachment0 = attachment

    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector

    linearVelocity.ForceLimitsEnabled = false

    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.Enabled = false
    linearVelocity.Parent = hrp
end

