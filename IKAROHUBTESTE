end

local function alternarVoo()
    if not linearVelocity or not linearVelocity.Parent then
        return
    end

    voando = not voando
    linearVelocity.Enabled = voando

    if not voando then
        linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
    end

    atualizarFlyButton()
end

flyButton.MouseButton1Click:Connect(alternarVoo)

UserInputService.InputBegan:Connect(function(input, processado)
    if processado then
        return
    end

    if input.KeyCode == Enum.KeyCode.F then
        alternarVoo()
    end
end)

