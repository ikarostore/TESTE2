local function carregarInimigos()
    limparConteudo()

    local encontrados = {}
    local lista = {}

    local pastaEnemies = workspace:FindFirstChild("Enemies")

    if pastaEnemies then
        for _, obj in ipairs(pastaEnemies:GetChildren()) do
            if obj:IsA("Model") and not encontrados[obj] then
                encontrados[obj] = true
                table.insert(lista, obj)
            end
        end
    end

    table.sort(lista, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    for _, inimigo in ipairs(lista) do
        criarBotaoLista(inimigo.Name, function()
            if inimigo and inimigo.Parent then
                teleportarParaModel(inimigo)
                status.Text = "TP para inimigo: " .. inimigo.Name
            else
                status.Text = "Inimigo não está mais no mapa."
            end
        end)
    end

    status.Text = "Inimigos detectados: " .. tostring(#lista)

    if #lista == 0 then
        criarAviso("Nenhum inimigo encontrado em Workspace.Enemies.")
    end
end

