local function restaurarColisoes()
    for parte, valor in pairs(colisoesOriginais) do
        if parte and parte.Parent then
            pcall(function()
                parte.CanCollide = valor
            end)
        end
    end

    colisoesOriginais = {}
end

local function ativarNoclipPersonagem()
    if not character then
        return
    end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            if colisoesOriginais[obj] == nil then
                colisoesOriginais[obj] = obj.CanCollide
            end

            obj.CanCollide = false
        end
    end
end

local function cancelarViagemNPC()
    cancelToken = cancelToken + 1

    if tweenNPCAtual then
        pcall(function()
            tweenNPCAtual:Cancel()
        end)
        tweenNPCAtual = nil
    end

    restaurarColisoes()
end

local function configurarPersonagem(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")

    local oldVelocity = hrp:FindFirstChild("IKAROFlyVelocity")
    if oldVelocity then
        oldVelocity:Destroy()
    end

    local oldAttachment = hrp:FindFirstChild("IKAROFlyAttachment")
    if oldAttachment then
        oldAttachment:Destroy()
    end

    attachment = Instance.new("Attachment")
    attachment.Name = "IKAROFlyAttachment"
    attachment.Parent = hrp

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Name = "IKAROFlyVelocity"
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)

    pcall(function()
        linearVelocity.ForceLimitsEnabled = false
    end)

    linearVelocity.Enabled = false
    linearVelocity.Parent = hrp
end

configurarPersonagem(player.Character or player.CharacterAdded:Wait())

player.CharacterAdded:Connect(function(char)
    voando = false
    cancelarViagemNPC()
    configurarPersonagem(char)
end)

