-- VIAGEM VOANDO / NOCLIP
-- =========================================================

npcToggleButton.MouseButton1Click:Connect(function()
    movimentoNPCAtivado = not movimentoNPCAtivado

    if movimentoNPCAtivado then
        npcToggleButton.Text = "Voar até NPC: ATIVADO"
        npcToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        npcToggleButton.Text = "Voar até NPC: DESATIVADO"
        npcToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        cancelarViagemNPC()
    end
end)

local function voarAteNPC(npc)
    if not movimentoNPCAtivado then
        return
    end

    if not npc or not npc.Parent then
        return
    end

    if not character or not humanoid or not hrp then
        return
    end

    local npcRoot = pegarRoot(npc)
    if not npcRoot then
        warn("IKAROhub: NPC sem RootPart:", npc.Name)
        return
    end

    cancelarViagemNPC()
    cancelToken = cancelToken + 1
    local tokenAtual = cancelToken

    if voando and linearVelocity then
        voando = false
        linearVelocity.Enabled = false
        linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
        atualizarFlyButton()
    end

    ativarNoclipPersonagem()

    local destinoPosicao =
        npcRoot.Position
        + Vector3.new(0, 3, 0)
        - (npcRoot.CFrame.LookVector * 4)

    local distancia = (hrp.Position - destinoPosicao).Magnitude
    local duracao = math.max(distancia / velocidadeViagemNPC, 0.15)

    local destinoCFrame = CFrame.new(
        destinoPosicao,
        npcRoot.Position
    )

    local tweenInfo = TweenInfo.new(
        duracao,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    tweenNPCAtual = TweenService:Create(
        hrp,
        tweenInfo,
        {CFrame = destinoCFrame}
    )

    local tweenLocal = tweenNPCAtual
    tweenLocal:Play()

    local estado = tweenLocal.Completed:Wait()

    if tokenAtual ~= cancelToken then
        return
    end

    if tweenNPCAtual == tweenLocal then
        tweenNPCAtual = nil
    end

    restaurarColisoes()

    if estado == Enum.PlaybackState.Completed then
        print("IKAROhub: chegou em", npc.Name)
    end
end

