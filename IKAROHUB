-- IKAROHUB modular Banana runtime
-- Os blocos das 18 abas sao recompostos na ordem original e compilados uma vez.

if not game:IsLoaded() then game.Loaded:Wait() end

local BASE = "https://raw.githubusercontent.com/ikarostore/TESTE2/refs/heads/main/"
local MODULES = {
	"shop", "status_server", "localplayer", "setting_farm",
	"hold_select_skill", "farming", "stack_farming", "farming_other",
	"fruit_raid", "dungeon", "sea_event", "upgrade_race",
	"upgrade_item", "volcano_event", "esp", "pvp", "webhook", "setting"
}

local function fetch(path)
	local ok, body = pcall(function() return game:HttpGet(BASE .. path) end)
	if not ok or type(body) ~= "string" or body == "" then
		error("Falha ao carregar " .. path .. ": " .. tostring(body), 0)
	end
	return body
end

local function loadModule(path)
	local source = fetch(path)
	local compiler, compileError = loadstring(source)
	if not compiler then error("Falha ao compilar " .. path .. ": " .. tostring(compileError), 0) end
	local ok, result = pcall(compiler)
	if not ok then error("Falha ao abrir " .. path .. ": " .. tostring(result), 0) end
	return result
end

local chunks = {}
table.insert(chunks, loadModule("modules/ikarohub_core_source.lua?v=1"))
for _, name in ipairs(MODULES) do
	local module = loadModule("modules/ikarohub_tabs/" .. name .. ".lua?v=3")
	if type(module) ~= "table" or type(module.Chunks) ~= "table" then
		error("Modulo invalido: " .. name, 0)
	end
	for _, chunk in ipairs(module.Chunks) do table.insert(chunks, chunk) end
end

table.sort(chunks, function(a, b) return a.Order < b.Order end)
local sourceParts = table.create(#chunks)
for index, chunk in ipairs(chunks) do
	if type(chunk.Code) ~= "string" then error("Bloco invalido: " .. tostring(chunk.Order), 0) end
	sourceParts[index] = chunk.Code
end

local completeSource = table.concat(sourceParts, "")
local runtime, compileError = loadstring(completeSource)
if not runtime then error("IKAROHUB compile error: " .. tostring(compileError), 0) end

getgenv().IKAROHUB_MODULES = MODULES
getgenv().IKARO_BANANA_UI_ONLY = nil
return runtime()
