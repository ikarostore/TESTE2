	SubTitle = "By Obii",
	TabWidth = 160,
	Theme = "Dark",
	Acrylic = false,
	Size = UDim2.fromOffset(500, 320),
	MinimizeKey = Enum.KeyCode.End
})

local Tabs = {
	Home = Window:AddTab({
		Title = "Tab Information"
	}),
