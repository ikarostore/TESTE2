local Options = Fluent.Options

local function detectCurrentSea()
	local seaByPlaceId = {
		[2753915549] = 1,
		[4442272183] = 2,
		[7449423635] = 3,
		-- ID observado no seu servidor atual; mantido como alias do Third Sea.
		[100117331123089] = 3
	}
	return seaByPlaceId[game.PlaceId], "PlaceId"
end

local CurrentSea, SeaDetectionSource = detectCurrentSea()
local SeaNames = {[0] = "Detectando...", [1] = "First Sea", [2] = "Second Sea", [3] = "Third Sea"}
CurrentSea = CurrentSea or 0
local function syncSeaFlags()
	local isSea1 = CurrentSea == 1
	local isSea2 = CurrentSea == 2
	local isSea3 = CurrentSea == 3
	Sea1, Sea2, Sea3 = isSea1, isSea2, isSea3
	_G.Sea1, _G.Sea2, _G.Sea3 = isSea1, isSea2, isSea3
	getgenv().Sea1, getgenv().Sea2, getgenv().Sea3 = isSea1, isSea2, isSea3
	getgenv().World1, getgenv().World2, getgenv().World3 = isSea1, isSea2, isSea3
end
syncSeaFlags()

-- As abas Banana são carregadas antes das extensões de Shop/Volcano para
-- preservar a ordem visual original de cada opção.
do
	local okTabs, tabState = pcall(function()
		getgenv().IKAROHUB_BANANA_TABS = loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/ikarostore/TESTE2/refs/heads/main/modules/ikarohub_banana_tabs.lua?v=1"
		))()
		return getgenv().IKAROHUB_BANANA_TABS.Init({
			Tabs = Tabs,
			Options = Options,
			Fluent = Fluent
		})
	end)
	if okTabs then
		getgenv().IKAROHUB_BANANA_TABS_STATE = tabState
	else
		Fluent:Notify({Title="IKAROHUB LOAD ERROR",Content=tostring(tabState),Duration=12})
	end
end

-- Shop agora vive em modulo proprio.
do
	local okShop, shopError = pcall(function()
		local module = loadstring(game:HttpGet(
			'https://raw.githubusercontent.com/ikarostore/TESTE2/refs/heads/main/modules/ikarohub_tabs/shop.lua?v=2'
		))()
		getgenv().IKAROHUB_SHOP_MODULE = module
		return module.Init({
			Tabs=Tabs, Options=Options, Fluent=Fluent, CurrentSea=CurrentSea,
			SeaDetectionSource=SeaDetectionSource, SeaNames=SeaNames,
			detectCurrentSea=detectCurrentSea, syncSeaFlags=syncSeaFlags
		})
	end)
	if not okShop then Fluent:Notify({Title='Shop module error',Content=tostring(shopError),Duration=12}) end
end

-- Volcano Event agora vive em modulo proprio.
