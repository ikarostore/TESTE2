		))()
		getgenv().IKAROHUB_VOLCANO_MODULE = module
		return module.Init({Tabs=Tabs, Options=Options, Fluent=Fluent})
	end)
	if not okVolcano then Fluent:Notify({Title='Volcano module error',Content=tostring(volcanoError),Duration=12}) end
end

