-- Nunca capturar durante Loading Data: o jogo dispara muitos remotes nessa
-- fase e serializá-los pode impedir a conclusão do carregamento.
local enabled = false
local records = {}
local lastRecord = nil
local MAX_RECORDS = 800
local remoteLastAt = {}

local function shortInstance(obj)
    if typeof(obj) ~= "Instance" then return tostring(obj) end
    local ok, full = pcall(function() return obj:GetFullName() end)
    return (ok and full or obj.Name) .. "<" .. obj.ClassName .. ">"
end

local function describe(value, depth)
    depth = depth or 0
    local kind = typeof(value)
    if kind == "Instance" then return shortInstance(value) end
    if kind == "Vector3" then
        return string.format("V3(%.1f,%.1f,%.1f)", value.X, value.Y, value.Z)
    end
    if kind == "CFrame" then return describe(value.Position, depth) end
    if kind ~= "table" then
        local text = tostring(value)
        return #text > 120 and string.sub(text, 1, 120) .. "..." or text
    end
    if depth >= 2 then return "{...}" end
    local result, count = {}, 0
    for key, item in pairs(value) do
        count = count + 1
        if count > 8 then table.insert(result, "...") break end
        table.insert(result, "[" .. describe(key, depth + 1) .. "]=" .. describe(item, depth + 1))
    end
    return "{" .. table.concat(result, ",") .. "}"
end

