local lastSnapshot = ""
task.spawn(function()
    while gui.Parent do
        if enabled then
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local seat = humanoid and humanoid.SeatPart
            local snapshot = "pos=" .. (root and describe(root.Position) or "nil")
                .. " hp=" .. tostring(humanoid and math.floor(humanoid.Health) or "nil")
                .. " seat=" .. (seat and shortInstance(seat) or "nil")

            if ROLE == "FOLLOWER" and root then
                local closestName, closestDistance = "none", math.huge
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local otherRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                        if otherRoot then
                            local distance = (otherRoot.Position - root.Position).Magnitude
                            if distance < closestDistance then
                                closestName, closestDistance = player.Name, distance
                            end
                        end
                    end
                end
                snapshot = snapshot .. " nearest=" .. closestName .. ":" .. math.floor(closestDistance)
            end

            if snapshot ~= lastSnapshot then
                lastSnapshot = snapshot
                add("STATE", snapshot, true)
            end
        end
        task.wait(0.5)
    end
end)

if not hookmetamethod or not getnamecallmethod or not newcclosure then
    add("ERROR", "Executor sem hookmetamethod/getnamecallmethod/newcclosure", true)
    return
end

local originalNamecall
local hookOk, hookError = pcall(function()
    originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local shouldTrace = false

        if enabled and typeof(self) == "Instance"
        and (method == "FireServer" or method == "InvokeServer") then
            local lowerName = string.lower(self.Name)
            shouldTrace = string.find(lowerName, "register", 1, true) ~= nil
                or string.find(lowerName, "equip", 1, true) ~= nil
                or string.find(lowerName, "commf", 1, true) ~= nil
                or string.find(lowerName, "ship", 1, true) ~= nil
                or string.find(lowerName, "boat", 1, true) ~= nil
                or string.find(lowerName, "harpoon", 1, true) ~= nil
                or string.find(lowerName, "levi", 1, true) ~= nil
                or string.find(lowerName, "frozen", 1, true) ~= nil
                or string.find(lowerName, "heart", 1, true) ~= nil
                or string.find(lowerName, "dialog", 1, true) ~= nil
        end

        if not shouldTrace then
            return originalNamecall(self, ...)
        end

        local args = table.pack(...)

        -- A chamada real sempre termina antes de qualquer serialização/HUD.
        -- Isso preserva retornos de InvokeServer e a cadência do Fast Attack.
        if method == "FireServer" then
            originalNamecall(self, ...)
            task.defer(function()
                local parts = {}
                for index = 1, math.min(args.n, 8) do
                    table.insert(parts, "a" .. index .. "=" .. describe(args[index]))
                end
                local detail = method .. " " .. shortInstance(self) .. " | " .. table.concat(parts, " | ")
                local throttleKey = method .. ":" .. self.Name .. ":" .. tostring(args[1])
                local now = os.clock()
                if now - (remoteLastAt[throttleKey] or 0) >= 0.25 then
                    remoteLastAt[throttleKey] = now
                    add("REMOTE", detail, true)
                end
            end)
            return
        end

        local results = table.pack(originalNamecall(self, ...))
        task.defer(function()
            local parts = {}
            for index = 1, math.min(args.n, 8) do
                table.insert(parts, "a" .. index .. "=" .. describe(args[index]))
            end
            local detail = method .. " " .. shortInstance(self) .. " | " .. table.concat(parts, " | ")
            local throttleKey = method .. ":" .. self.Name .. ":" .. tostring(args[1])
            local now = os.clock()
            if now - (remoteLastAt[throttleKey] or 0) >= 0.25 then
                remoteLastAt[throttleKey] = now
                add("REMOTE", detail, true)
            end
        end)
        return table.unpack(results, 1, results.n)
    end))
end)

if not hookOk then
