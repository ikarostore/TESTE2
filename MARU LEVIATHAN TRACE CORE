    end
end)

clearButton.MouseButton1Click:Connect(function()
    table.clear(records)
    lastRecord = nil
    refresh()
end)

local function isInterestingName(name)
    name = string.lower(name)
    return string.find(name, "levi", 1, true)
        or string.find(name, "frozen", 1, true)
        or string.find(name, "heart", 1, true)
        or string.find(name, "beast hunter", 1, true)
        or string.find(name, "terror", 1, true)
        or string.find(name, "sea beast", 1, true)
        or string.find(name, "piranha", 1, true)
        or string.find(name, "shark", 1, true)
        or string.find(name, "brigade", 1, true)
        or string.find(name, "fishboat", 1, true)
        or string.find(name, "harpoon", 1, true)
end

workspace.DescendantAdded:Connect(function(obj)
