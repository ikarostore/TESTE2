local function refresh()
    local first = math.max(1, #records - 16)
    local visible = {}
    for index = first, #records do table.insert(visible, records[index]) end
    output.Text = #visible > 0 and table.concat(visible, "\n")
        or "Captura desligada. Espere Loading Data sumir antes de ativar."
end

local function add(kind, detail, allowDuplicate)
    if not enabled then return end
    local body = kind .. " | " .. detail
    if not allowDuplicate and body == lastRecord then return end
    lastRecord = body
    table.insert(records, string.format("%.3f | %s", os.clock(), body))
    while #records > MAX_RECORDS do table.remove(records, 1) end
    refresh()
end

