local function ClickWatcherDialogue()
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("TextButton") and obj.Visible then
            local text = string.lower(obj.Text)
            if string.find(text, "yes", 1, true)
            or string.find(text, "open", 1, true)
            or string.find(text, "gate", 1, true)
            or string.find(text, "leviathan", 1, true)
            or string.find(text, "continue", 1, true) then
                pcall(function()
                    if firesignal then firesignal(obj.MouseButton1Click) else obj:Activate() end
                end)
            end
        end
    end
end

local function ActivateWatcher(watcher, frozen)
    if watcherBusy or not watcher then return end
    watcherBusy = true
    task.spawn(function()
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local watcherPart = watcher:IsA("BasePart") and watcher or TargetPart(watcher)
        if root and watcherPart then
            local destination = watcherPart.CFrame * CFrame.new(0, 2, 4)
            local duration = math.clamp((root.Position - destination.Position).Magnitude / 250, 0.2, 20)
            local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destination})
            tween:Play()
            tween.Completed:Wait()
            local prompt = watcher:FindFirstChildWhichIsA("ProximityPrompt", true)
                or (frozen and frozen:FindFirstChildWhichIsA("ProximityPrompt", true))
            local click = watcher:FindFirstChildWhichIsA("ClickDetector", true)
                or (frozen and frozen:FindFirstChildWhichIsA("ClickDetector", true))
            if prompt and fireproximityprompt then
                pcall(fireproximityprompt, prompt)
            elseif click and fireclickdetector then
                pcall(fireclickdetector, click)
            else
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end
            task.wait(0.8)
            ClickWatcherDialogue()
            task.wait(0.8)
            ClickWatcherDialogue()
        end
        task.wait(3)
        watcherBusy = false
    end)
end

activateButton.MouseButton1Click:Connect(function()
    local frozen = FindFrozenDimension(true)
    local watcher = FindFrozenWatcher(frozen)
    if watcher then
        activateButton.Text = "Ativando..."
        ActivateWatcher(watcher, frozen)
        task.delay(3, function() activateButton.Text = "Ativar Watcher" end)
    else
        activateButton.Text = "Watcher nao achado"
    end
end)

while task.wait(1) do
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local tool = character and character:FindFirstChildOfClass("Tool")
    local hasBuso = character and character:FindFirstChild("HasBuso") ~= nil
    local controllerFound = false
    pcall(function()
        local module = LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework")
        local framework = module and require(module)
        controllerFound = type(framework) == "table" and framework.activeController ~= nil
    end)

    local lines = {
        "Personagem: " .. tostring(character ~= nil), "HP: " .. tostring(humanoid and math.floor(humanoid.Health) or "nil"),
        "Buso: " .. tostring(hasBuso), "Arma: " .. tostring(tool and tool.Name or "nenhuma"),
        "CombatController: " .. tostring(controllerFound), "Auto Watcher: " .. tostring(autoWatcher)
    }
    if root then
        for _, key in ipairs(EventOrder) do
            local mob, part, distance = FindNearestEvent(root, EventNames[key])
            if mob and part then
                table.insert(lines, key .. ": SIM | Dist=" .. tostring(math.floor(distance * 10) / 10) .. " | HP=" .. HealthText(mob))
            else
                table.insert(lines, key .. ": nao detectado")
            end
        end
    else
        table.insert(lines, "Aguardando personagem/HRP...")
    end
    local frozen = FindFrozenDimension()
    local watcher = FindFrozenWatcher(frozen)
    table.insert(lines, "Frozen Dimension: " .. tostring(frozen and frozen:GetFullName() or "nao detectada"))
    table.insert(lines, "Frozen Watcher: " .. tostring(watcher and watcher:GetFullName() or "nao detectado"))
    lastReport = table.concat(lines, "\n")
    output.Text = lastReport
    print("[IKARO DIAG] " .. string.gsub(lastReport, "\n", " | "))
    if autoWatcher and watcher then ActivateWatcher(watcher, frozen) end
end

