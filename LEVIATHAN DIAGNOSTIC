local EventNames = {
    Piranha = {"piranha"}, Shark = {"shark"},
    Terrorshark = {"terrorshark", "terror shark"},
    SeaBeast = {"seabeast", "sea beast"},
    PirateBrigade = {"piratebrigade", "pirate brigade"},
    PirateGrandBrigade = {"pirategrandbrigade", "pirate grand brigade"},
    FishBoat = {"fishboat", "fish boat"}
}
local EventOrder = {"Piranha", "Shark", "Terrorshark", "SeaBeast", "PirateBrigade", "PirateGrandBrigade", "FishBoat"}

local function NameMatches(name, aliases)
    local lowered = string.lower(name)
    for _, alias in ipairs(aliases) do
        if string.find(lowered, alias, 1, true) then return true end
    end
    return false
end

local function TargetPart(model)
    return model:FindFirstChild("HumanoidRootPart", true)
        or model:FindFirstChild("VehicleSeat", true)
        or model:FindFirstChild("Engine", true)
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function HealthText(model)
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local value = model:FindFirstChild("Health", true) or model:FindFirstChild("HP", true)
    if humanoid then return tostring(math.floor(humanoid.Health)) .. "/" .. tostring(math.floor(humanoid.MaxHealth)) end
    if value and tonumber(value.Value) then return tostring(math.floor(tonumber(value.Value))) end
    return "desconhecido"
end

local function FindNearestEvent(root, aliases)
    local nearest, nearestPart
    local nearestDistance = math.huge
    local containers = {workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("SeaBeasts"), workspace:FindFirstChild("Boats"), workspace}
    for _, container in ipairs(containers) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("Model") and NameMatches(obj.Name, aliases) then
                    local part = TargetPart(obj)
                    if part then
                        local distance = (part.Position - root.Position).Magnitude
                        if distance < nearestDistance then nearest, nearestPart, nearestDistance = obj, part, distance end
                    end
                end
            end
        end
    end
    return nearest, nearestPart, nearestDistance
end

local frozenCache
local lastFrozenScan = 0
local function FindFrozenDimension(forceScan)
    if frozenCache and frozenCache.Parent then return frozenCache end
    if not forceScan and os.clock() - lastFrozenScan < 4 then return nil end
    lastFrozenScan = os.clock()
    for _, obj in ipairs(workspace:GetDescendants()) do
        local lowered = string.lower(obj.Name)
        if string.find(lowered, "frozen dimension", 1, true) or string.find(lowered, "frozendimension", 1, true) then
            if obj:IsA("Model") or obj:IsA("BasePart") then
                frozenCache = obj
                return obj
            end
        end
    end
end

local function ObjectCFrame(obj)
    if obj:IsA("Model") then return obj:GetPivot() end
    if obj:IsA("BasePart") then return obj.CFrame end
end

local MacroFile = "IKARO_FROZEN_MACRO.json"
local frozenOffset
local autoFrozen = false
local frozenBusy = false
local lastReport = "Diagnostico ainda sem dados."

pcall(function()
    if isfile and isfile(MacroFile) and readfile then
        frozenOffset = CFrame.new(table.unpack(HttpService:JSONDecode(readfile(MacroFile))))
    end
end)

copyButton.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(lastReport)
        copyButton.Text = "Copiado!"
        task.delay(1.5, function() copyButton.Text = "Copiar diagnostico" end)
    else
        copyButton.Text = "Sem clipboard"
    end
end)

recordButton.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local frozen = FindFrozenDimension(true)
    local frozenCFrame = frozen and ObjectCFrame(frozen)
    if not root or not frozenCFrame then recordButton.Text = "Frozen nao detectada" return end
    frozenOffset = frozenCFrame:ToObjectSpace(root.CFrame)
    pcall(function()
        if writefile then writefile(MacroFile, HttpService:JSONEncode({frozenOffset:GetComponents()})) end
    end)
    recordButton.Text = "Ponto gravado!"
    task.delay(2, function() recordButton.Text = "Gravar ponto Frozen" end)
end)

autoButton.MouseButton1Click:Connect(function()
    autoFrozen = not autoFrozen
    autoButton.Text = autoFrozen and "Auto Frozen: ON" or "Auto Frozen: OFF"
    autoButton.BackgroundColor3 = autoFrozen and Color3.fromRGB(55, 125, 82) or Color3.fromRGB(55, 91, 75)
end)

local function ActivateFrozen(frozen)
    if frozenBusy or not frozenOffset then return end
    frozenBusy = true
    task.spawn(function()
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local frozenCFrame = ObjectCFrame(frozen)
        if root and frozenCFrame then
            local destination = frozenCFrame * frozenOffset
            local duration = math.clamp((root.Position - destination.Position).Magnitude / 250, 0.2, 20)
            local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destination})
            tween:Play()
            tween.Completed:Wait()
            local prompt = frozen:FindFirstChildWhichIsA("ProximityPrompt", true)
            local click = frozen:FindFirstChildWhichIsA("ClickDetector", true)
            if prompt and fireproximityprompt then
                pcall(fireproximityprompt, prompt)
            elseif click and fireclickdetector then
                pcall(fireclickdetector, click)
            else
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end
        end
        task.wait(3)
        frozenBusy = false
    end)
end

while task.wait(1) do
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local tool = character and character:FindFirstChildOfClass("Tool")
    local hasBuso = character and character:FindFirstChild("HasBuso") ~= nil
    local controllerFound = false
    pcall(function()
        local module = LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework")
        local framework = module and require(module)
        controllerFound = type(framework) == "table" and framework.activeController ~= nil
    end)

    local lines = {
        "Personagem: " .. tostring(character ~= nil), "HP: " .. tostring(humanoid and math.floor(humanoid.Health) or "nil"),
        "Buso: " .. tostring(hasBuso), "Arma: " .. tostring(tool and tool.Name or "nenhuma"),
        "CombatController: " .. tostring(controllerFound), "Macro Frozen: " .. tostring(frozenOffset ~= nil)
    }
    if root then
        for _, key in ipairs(EventOrder) do
            local mob, part, distance = FindNearestEvent(root, EventNames[key])
            if mob and part then
                table.insert(lines, key .. ": SIM | Dist=" .. tostring(math.floor(distance * 10) / 10) .. " | HP=" .. HealthText(mob))
            else
                table.insert(lines, key .. ": nao detectado")
            end
        end
    else
        table.insert(lines, "Aguardando personagem/HRP...")
    end
    local frozen = FindFrozenDimension()
    table.insert(lines, "Frozen Dimension: " .. tostring(frozen and frozen:GetFullName() or "nao detectada"))
    lastReport = table.concat(lines, "\n")
    output.Text = lastReport
    print("[IKARO DIAG] " .. string.gsub(lastReport, "\n", " | "))
    if autoFrozen and frozen and frozenOffset then ActivateFrozen(frozen) end
end

