local resultadoCompleto = ""

local function isPlayerCharacter(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function hasInterestingMarker(model)
    if model:FindFirstChildOfClass("Humanoid") then
        return true
    end

    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("ProximityPrompt")
        or d:IsA("ClickDetector")
        or d:IsA("Humanoid") then
            return true
        end
    end

    return false
end

local function addRow(text)
    local row = Instance.new("TextLabel")
    row.Size = UDim2.new(1,-10,0,44)
    row.BackgroundColor3 = Color3.fromRGB(40,40,40)
    row.BorderSizePixel = 0
    row.TextColor3 = Color3.fromRGB(255,255,255)
    row.Font = Enum.Font.Code
    row.TextSize = 12
    row.TextWrapped = true
    row.TextXAlignment = Enum.TextXAlignment.Left
    row.Text = text
    row.Parent = list

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,5)
    c.Parent = row
end

local function clearRows()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function scan()
    clearRows()

    local found = {}
    local count = 0
    local linhas = {}

    local function scanRoot(root, rootName)
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("Model")
            and not isPlayerCharacter(obj)
            and not found[obj]
            and hasInterestingMarker(obj) then

                found[obj] = true
                count = count + 1

                local fullName = ""
                pcall(function()
                    fullName = obj:GetFullName()
                end)

                local line = "[" .. rootName .. "] " .. obj.Name .. " | " .. fullName
                table.insert(linhas, line)
                addRow(line)

                print("IKARO NPC DEBUG:", line)
            end
        end
    end

    scanRoot(workspace, "Workspace")
    scanRoot(ReplicatedStorage, "ReplicatedStorage")

    resultadoCompleto = table.concat(linhas, "\n")

    info.Text = "Encontrados: " .. tostring(count) .. ". Clique em 'Copiar todos' e cole o resultado aqui."

    task.wait()
    list.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 10)
end

local function copiarTudo()
    if resultadoCompleto == "" then
        info.Text = "Nenhum resultado para copiar. Clique em 'Atualizar diagnóstico'."
        return
    end

    local copiado = false

    if setclipboard then
        local ok = pcall(function()
            setclipboard(resultadoCompleto)
        end)
        copiado = ok
    elseif toclipboard then
        local ok = pcall(function()
            toclipboard(resultadoCompleto)
        end)
        copiado = ok
    end

    if copiado then
        copyButton.Text = "Copiado!"
        info.Text = "Lista copiada para a área de transferência. Cole aqui no chat."

        task.delay(2, function()
            if copyButton and copyButton.Parent then
                copyButton.Text = "Copiar todos"
            end
        end)
    else
        info.Text = "Seu ambiente não expõe setclipboard/toclipboard."
        warn("IKARO DEBUG: função de clipboard não disponível.")
    end
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    list.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 10)
end)

refresh.MouseButton1Click:Connect(function()
    task.spawn(scan)
end)

copyButton.MouseButton1Click:Connect(copiarTudo)

task.spawn(function()
    task.wait(0.5)
