local function isPlayerCharacter(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function hasInterestingMarker(model)
    if model:FindFirstChildOfClass("Humanoid") then
        return true
    end

    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("ProximityPrompt")
        or d:IsA("ClickDetector")
        or d:IsA("Humanoid") then
            return true
        end
    end

    return false
end

local function addRow(text)
    local row = Instance.new("TextLabel")
    row.Size = UDim2.new(1,-10,0,44)
    row.BackgroundColor3 = Color3.fromRGB(40,40,40)
    row.BorderSizePixel = 0
    row.TextColor3 = Color3.fromRGB(255,255,255)
    row.Font = Enum.Font.Code
    row.TextSize = 12
    row.TextWrapped = true
    row.TextXAlignment = Enum.TextXAlignment.Left
    row.Text = text
    row.Parent = list

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,5)
    c.Parent = row
end

local function clearRows()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function scan()
    clearRows()

    local found = {}
    local count = 0

    local function scanRoot(root, rootName)
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("Model")
            and not isPlayerCharacter(obj)
            and not found[obj]
            and hasInterestingMarker(obj) then

                found[obj] = true
                count += 1

                local fullName = ""
                pcall(function()
                    fullName = obj:GetFullName()
                end)

                local line = "[" .. rootName .. "] " .. obj.Name .. "\n" .. fullName
                addRow(line)

                print("IKARO NPC DEBUG:", rootName, "|", obj.Name, "|", fullName)
            end
        end
    end

    scanRoot(workspace, "Workspace")
    scanRoot(ReplicatedStorage, "ReplicatedStorage")

    info.Text = "Encontrados: " .. tostring(count) .. ". Veja a lista e o console. Envie os nomes/caminhos dos NPCs corretos."
    task.wait()
    list.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 10)
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    list.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 10)
end)

refresh.MouseButton1Click:Connect(function()
    task.spawn(scan)
end)

task.spawn(function()
    task.wait(0.5)
    scan()
end)

print("IKARO NPC DEBUG carregado.")
