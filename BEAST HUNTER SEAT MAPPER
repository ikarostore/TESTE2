local report = ""

local function fullName(instance)
    local ok, value = pcall(function() return instance:GetFullName() end)
    return ok and value or instance.Name
end

local function findBoat()
    local boats = workspace:FindFirstChild("Boats")
    if not boats then return nil end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local best, bestDistance = nil, math.huge
    for _, boat in ipairs(boats:GetChildren()) do
        if string.find(string.lower(boat.Name), "beast hunter", 1, true) then
            local part = boat:FindFirstChild("VehicleSeat", true)
                or boat.PrimaryPart
                or boat:FindFirstChildWhichIsA("BasePart", true)
            local distance = root and part and (part.Position - root.Position).Magnitude or 0
            if distance < bestDistance then
                best, bestDistance = boat, distance
            end
        end
    end
    return best, bestDistance
end

local function isCandidate(object)
    if object:IsA("Seat") or object:IsA("VehicleSeat") then return true end
    local lower = string.lower(object.Name)
    return string.find(lower, "seat", 1, true)
        or string.find(lower, "chair", 1, true)
        or string.find(lower, "harpoon", 1, true)
        or string.find(lower, "gun", 1, true)
        or string.find(lower, "cannon", 1, true)
end

local function mapSeats()
    local boat, boatDistance = findBoat()
    if not boat then
        report = "ERRO: Beast Hunter nao encontrado em Workspace.Boats."
        output.Text = report
        return
    end

    local mainSeat = boat:FindFirstChild("VehicleSeat", true)
    local lines = {
        "=== IKARO BEAST HUNTER SEAT MAP ===",
        "Boat=" .. fullName(boat),
        string.format("DistanciaDoJogador=%.1f", boatDistance or -1),
        "MainSeat=" .. (mainSeat and fullName(mainSeat) or "nil"),
        ""
    }

    local candidates = {}
    for _, object in ipairs(boat:GetDescendants()) do
        if isCandidate(object) then candidates[#candidates + 1] = object end
    end
    table.sort(candidates, function(a, b) return fullName(a) < fullName(b) end)

    for index, object in ipairs(candidates) do
        local fields = {
            string.format("[%02d] Name=%s", index, object.Name),
            "Class=" .. object.ClassName,
            "Path=" .. fullName(object)
        }
        if object:IsA("BasePart") then
            fields[#fields + 1] = string.format(
                "Pos=Vector3.new(%.3f, %.3f, %.3f)",
                object.Position.X, object.Position.Y, object.Position.Z
            )
            fields[#fields + 1] = string.format(
                "Size=Vector3.new(%.3f, %.3f, %.3f)",
                object.Size.X, object.Size.Y, object.Size.Z
            )
            if mainSeat then
                fields[#fields + 1] = string.format(
                    "DistMain=%.2f",
                    (object.Position - mainSeat.Position).Magnitude
                )
            end
        end
        if object:IsA("Seat") or object:IsA("VehicleSeat") then
            local occupant = object.Occupant
            fields[#fields + 1] = "Occupant=" .. (
                occupant and occupant.Parent and occupant.Parent.Name or "nil"
            )
            fields[#fields + 1] = "Disabled=" .. tostring(object.Disabled)
        end
        lines[#lines + 1] = table.concat(fields, " | ")
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "TotalCandidatos=" .. tostring(#candidates)
    report = table.concat(lines, "\n")
    output.Text = report
end

mapButton.MouseButton1Click:Connect(mapSeats)
